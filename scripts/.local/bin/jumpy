#!/usr/bin/env python3
"""Switch audio sinks and display profiles.

Stdlib only, on a plain `python3` shebang rather than the `uv run` trampoline
every other script here uses. Home Assistant drives this over ssh, and a
non-interactive ssh session has neither `uv` nor `~/.local/bin` on PATH — the
trampoline would fail there. Do not "fix" the shebang.

The Hyprland IPC below is inlined for the same reason: importing it from the
hyprland scripts project would need that project's venv, which does not exist
in an ssh context.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import re
import socket
import subprocess
import sys
from enum import StrEnum
from pathlib import Path


class Hyprctl:
    """Minimal Hyprland IPC over the control socket.

    A trimmed copy of `hyprland/.config/hypr/scripts/lib/hyprctl.py` carrying
    only what the native display backend needs. Keep the two in step by hand;
    sharing them would cost this script its stdlib-only property.
    """

    def __init__(self) -> None:
        self._socket_path = self._resolve_socket()

    def _resolve_socket(self) -> str | None:
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if signature:
            path = os.path.join(runtime, "hypr", signature, ".socket.sock")
            return path if os.path.exists(path) else None
        # Bare-env callers (ssh, systemd): take the first running instance,
        # mirroring `hyprctl -i 0`.
        candidates = sorted(
            glob.glob(os.path.join(runtime, "hypr", "*", ".socket.sock"))
        )

        return candidates[0] if candidates else None

    def _request(self, message: str) -> str | None:
        if not self._socket_path:
            return None
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(self._socket_path)
                sock.sendall(message.encode())
                chunks = []
                while chunk := sock.recv(8192):
                    chunks.append(chunk)
        except OSError:
            return None

        return b"".join(chunks).decode()

    def eval(self, expr: str) -> bool:
        return self._request(f"eval {expr}") == "ok"


class DisplayBackend(StrEnum):
    KANSHI = "kanshi"
    NATIVE = "native"


# Emitted by `jumpy completion zsh` rather than kept in the zsh config, so the
# command surface and its completion cannot drift apart. The dynamic candidate
# lists come back through `jumpy completion --list`, which parses pw-dump in
# Python — the human-facing `sound ls` table is quoted CSV and shell-parsing it
# would break on any device name containing a comma.
ZSH_COMPLETION = """\
_jumpy_completion() {
  local context state state_descr line
  typeset -A opt_args
  local -a commands
  commands=(
    'sound:Set default audio device via wireplumber'
    'display:Apply or list Hyprland monitor profiles'
    'completion:Print the shell completion script'
  )

  _arguments -C \\
    '1:command:->command' \\
    '*::args:->args'

  case "$state" in
  command)
    _describe 'jumpy command' commands
    ;;
  args)
    case "$line[1]" in
    sound) _jumpy_sound ;;
    display) _jumpy_display ;;
    completion) _arguments '1:shell:(zsh)' ;;
    esac
    ;;
  esac
}

_jumpy_sound() {
  local context state state_descr line
  typeset -A opt_args
  local -a values
  local name

  _arguments -C \\
    '1:media class:->class' \\
    '2:device:->device'

  case "$state" in
  class)
    values=('ls:List available devices and their classes')
    for name in ${(f)"$(jumpy completion --list sound-classes 2>/dev/null)"}; do
      values+=("$name:media class")
    done
    _describe -t classes 'media class' values
    ;;
  device)
    [[ "$line[1]" == ls ]] && return
    values=()
    for name in ${(f)"$(jumpy completion --list sound-devices --media-class "$line[1]" 2>/dev/null)"}; do
      values+=("$name:device")
    done
    _describe -t devices 'device' values
    ;;
  esac
}

_jumpy_display() {
  local context state state_descr line
  typeset -A opt_args
  local -a values
  local name backend

  _arguments -C \\
    '--backend[Profile backend]:backend:(kanshi native)' \\
    '1:profile:->profile'

  case "$state" in
  profile)
    backend=${opt_args[--backend]:-kanshi}
    values=(
      'ls:List available profiles'
      'reload:Re-run auto-match'
    )
    for name in ${(f)"$(jumpy display ls --backend $backend 2>/dev/null)"}; do
      values+=("$name:$backend profile")
    done
    _describe -t profiles 'profile' values
    ;;
  esac
}
"""


class Jumpy:
    AUDIO_ICON = "/usr/share/icons/Adwaita/scalable/devices/audio-headphones.svg"
    DISPLAY_ICON = "/usr/share/icons/Adwaita/scalable/devices/video-display.svg"
    KANSHI_CONFIG = Path.home() / ".config/kanshi/config"
    DISPLAY_MODULE = "outputs.profiles"
    PROFILES_LUA = Path.home() / ".config/hypr/outputs/profiles.lua"

    def _notify(self, title: str, message: str, icon: str) -> None:
        subprocess.run(
            ["notify-send", title, message, "-i", icon],
            check=False,
        )

    def _pw_nodes(self) -> list[dict]:
        proc = subprocess.run(["pw-dump"], capture_output=True, text=True, check=True)
        return [
            n
            for n in json.loads(proc.stdout)
            if n.get("type") == "PipeWire:Interface:Node"
        ]

    def sound_ls(self) -> None:
        print("Available sources are listed below.")
        print()
        print("media.class,alsa.card_name,media.name")
        print("-------------------------------------")
        for node in self._pw_nodes():
            props = node.get("info", {}).get("props", {})
            row = ",".join(
                json.dumps(props.get(k, ""))
                for k in ("media.class", "alsa.card_name", "media.name")
            )
            print(row)

    def sound_classes(self) -> None:
        """Distinct media.class values, one per line, for shell completion."""
        seen: list[str] = []
        for node in self._pw_nodes():
            value = node.get("info", {}).get("props", {}).get("media.class")
            if value and value not in seen:
                seen.append(value)
        print("\n".join(seen))

    def sound_devices(self, media_class: str) -> None:
        """Names `sound_apply` accepts for a class, one per line, for completion."""
        seen: list[str] = []
        for node in self._pw_nodes():
            props = node.get("info", {}).get("props", {})
            if props.get("media.class") != media_class:
                continue
            for key in ("alsa.card_name", "media.name"):
                value = props.get(key)
                if value and value not in seen:
                    seen.append(value)
        print("\n".join(seen))

    def sound_apply(self, media_class: str, card_name: str) -> None:
        for node in self._pw_nodes():
            props = node.get("info", {}).get("props", {})
            if props.get("media.class") != media_class:
                continue
            if card_name in (props.get("alsa.card_name"), props.get("media.name")):
                subprocess.run(["wpctl", "set-default", str(node["id"])], check=True)
                self._notify(f"wireplumber [{media_class}]", card_name, self.AUDIO_ICON)
                return
        print(
            f"jumpy sound: no node matches {media_class!r} + {card_name!r}",
            file=sys.stderr,
        )
        sys.exit(1)

    def _ensure_native(self) -> Hyprctl:
        # Guard the `require`-driven native paths (reload / switch): fail
        # unless profiles.lua is ALREADY loaded in a running instance.
        # Probed through `package.loaded` so the check never *loads* the
        # module itself — force-loading it via `require` while kanshi is
        # still running would wire profiles.lua's hotplug hooks alongside
        # kanshi, and the two would fight over every monitor event. The
        # Hyprctl self-discovers the instance socket, so bare-env callers
        # (SSH, systemd, home-assistant) work without
        # HYPRLAND_INSTANCE_SIGNATURE.
        hypr = Hyprctl()
        if not hypr.eval(f'assert(package.loaded["{self.DISPLAY_MODULE}"])'):
            print(
                "jumpy display: --backend native needs a running Hyprland with profiles.lua "
                "loaded (uncomment its require in ~/.config/hypr/outputs/init.lua).",
                file=sys.stderr,
            )
            sys.exit(1)

        return hypr

    def display_ls(self, backend: DisplayBackend) -> None:
        if backend is DisplayBackend.NATIVE:
            # Reading the file is side-effect-free, so listing doesn't need
            # the load guard — the .lua file is the source of truth (0.56
            # still can't return a Lua value through hyprctl).
            text = self.PROFILES_LUA.read_text()
            for match in re.finditer(r'\["([^"]+)"\]\s*=\s*\{', text):
                print(match.group(1))
            return

        text = self.KANSHI_CONFIG.read_text()
        seen: set[str] = set()
        for match in re.finditer(r"^\s*profile\s+(\S+)\s*\{", text, re.MULTILINE):
            name = match.group(1)
            if name not in seen:
                seen.add(name)
                print(name)

    def display_reload(self, backend: DisplayBackend) -> None:
        if backend is DisplayBackend.NATIVE:
            hypr = self._ensure_native()
            if not hypr.eval(f'require("{self.DISPLAY_MODULE}").auto_apply()'):
                print("jumpy display: reload failed.", file=sys.stderr)
                sys.exit(1)
            return

        try:
            subprocess.run(["kanshictl", "reload"], check=True, timeout=10)
        except subprocess.TimeoutExpired:
            # Hyprland 0.56 never ACKs a wlr-output-management apply that
            # changes nothing, so kanshi's reload hangs whenever the
            # config is already active. Already-applied is success.
            print(
                "jumpy display: kanshictl reload timed out — state already active.",
                file=sys.stderr,
            )

    def display_switch(self, profile: str, backend: DisplayBackend) -> None:
        if backend is DisplayBackend.NATIVE:
            hypr = self._ensure_native()
            # profiles.lua's apply() emits its own "Applied profile" notify.
            if not hypr.eval(
                f'require("{self.DISPLAY_MODULE}").apply({json.dumps(profile)})'
            ):
                print(f"jumpy display: switch to {profile} failed.", file=sys.stderr)
                sys.exit(1)
            return

        subprocess.run(
            ["/etc/udev/scripts/wayland-user.sh", "kanshictl", "switch", profile],
            check=True,
        )
        self._notify("display", f"Trigger profile {profile}.", self.DISPLAY_ICON)

    def _build_parser(self) -> argparse.ArgumentParser:
        parser = argparse.ArgumentParser(
            prog="jumpy",
            description="Switch audio sinks and display profiles.",
        )
        sub = parser.add_subparsers(dest="command", required=True)

        sound = sub.add_parser(
            "sound",
            help="Set default audio device via wireplumber.",
            description=(
                "Set default audio using wireplumber.\n"
                "Usage: jumpy sound [media.class] [alsa.card_name|media.name]\n"
                "Example: jumpy sound 'Audio/Sink' 'Scarlett 8i6 USB'\n\n"
                "List available devices and their classes:\n"
                "Usage: jumpy sound ls"
            ),
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        sound.add_argument("args", nargs="*")

        display = sub.add_parser(
            "display",
            help="Apply / list Hyprland monitor profiles.",
            description=(
                "List available profiles: jumpy display ls\n"
                "Re-run auto-match: jumpy display reload\n"
                "Apply a profile: jumpy display [profile]"
            ),
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        display.add_argument(
            "--backend",
            choices=list(DisplayBackend),
            type=DisplayBackend,
            default=DisplayBackend.KANSHI,
            help="Profile backend: kanshi (default) or native profiles.lua.",
        )
        display.add_argument("args", nargs="*")

        completion = sub.add_parser(
            "completion",
            help="Print the shell completion script.",
        )
        completion.add_argument("shell", nargs="?", default="zsh", choices=["zsh"])
        # Candidate lists the emitted completion calls back for; hidden because
        # they are machine-readable output, not a user-facing command.
        completion.add_argument(
            "--list",
            choices=["sound-classes", "sound-devices"],
            help=argparse.SUPPRESS,
        )
        completion.add_argument("--media-class", default="", help=argparse.SUPPRESS)

        return parser

    def run(self, argv: list[str] | None = None) -> None:
        parser = self._build_parser()
        ns = parser.parse_args(argv)

        match ns.command:
            case "sound":
                match ns.args:
                    case [] | ["help"]:
                        parser.parse_args(["sound", "--help"])
                    case ["ls"]:
                        self.sound_ls()
                    case [media_class, card_name]:
                        self.sound_apply(media_class, card_name)
                    case _:
                        parser.parse_args(["sound", "--help"])
                        sys.exit(2)
            case "display":
                match ns.args:
                    case [] | ["help"]:
                        parser.parse_args(["display", "--help"])
                    case ["ls"]:
                        self.display_ls(ns.backend)
                    case ["reload"]:
                        self.display_reload(ns.backend)
                    case [profile]:
                        self.display_switch(profile, ns.backend)
                    case _:
                        parser.parse_args(["display", "--help"])
                        sys.exit(2)
            case "completion":
                match ns.list:
                    case "sound-classes":
                        self.sound_classes()
                    case "sound-devices":
                        self.sound_devices(ns.media_class)
                    case _:
                        sys.stdout.write(ZSH_COMPLETION)


if __name__ == "__main__":
    Jumpy().run()
