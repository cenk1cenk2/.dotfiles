#!/usr/bin/env -S sh -c 'exec uv run --project "$(dirname "$0")" python "$0" "$@"'
# vim: ft=python
"""Switch audio sinks and display profiles.

Home Assistant drives this over ssh, where neither `uv` nor `~/.local/bin` is
on PATH. Its shell_command entries therefore prepend the mise shims and call
this by full path; see cluster/workloads/home-assistant!69. `python "$0"` in
the shebang rather than bare `"$0"` because this file has no `.py` extension,
which `uv run` would otherwise treat as a command name and recurse on.

The subcommands take their operands positionally (`jumpy sound <class> <name>`,
`jumpy display <profile>`) rather than as click subcommands of their own. Those
spellings are what Home Assistant's shell_command entries send, so the surface
is fixed from outside this repo and is not ours to tidy.
"""

from __future__ import annotations

import glob
import json
import os
import re
import socket
import subprocess
import sys
from enum import StrEnum
from pathlib import Path

import click
from click.shell_completion import CompletionItem, get_completion_class
from dotlib.cli import create_logger
from dotlib.notify import notify
from rich.console import Console
from rich.table import Table

console = Console()
log = create_logger(False, name="jumpy")


class Hyprctl:
    """Minimal Hyprland IPC over the control socket.

    Deliberately a standalone copy of the subset the native display backend
    uses, rather than an import from the hyprland scripts project. Hyprctl is
    hyprland's domain and lives in `hyprland/.config/hypr/scripts/lib/`; jumpy
    is a user command that happens to speak the same protocol, and reaching
    across projects for it would couple this script to a package it otherwise
    has nothing to do with. Keep the two in step by hand if the IPC changes.
    """

    def __init__(self) -> None:
        self._socket_path = self._resolve_socket()

    def _resolve_socket(self) -> str | None:
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if signature:
            path = os.path.join(runtime, "hypr", signature, ".socket.sock")
            return path if os.path.exists(path) else None
        # Bare-env callers (ssh, systemd): take the first running instance,
        # mirroring `hyprctl -i 0`.
        candidates = sorted(
            glob.glob(os.path.join(runtime, "hypr", "*", ".socket.sock"))
        )

        return candidates[0] if candidates else None

    def _request(self, message: str) -> str | None:
        if not self._socket_path:
            return None
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(self._socket_path)
                sock.sendall(message.encode())
                chunks = []
                while chunk := sock.recv(8192):
                    chunks.append(chunk)
        except OSError:
            return None

        return b"".join(chunks).decode()

    def eval(self, expr: str) -> bool:
        return self._request(f"eval {expr}") == "ok"


class DisplayBackend(StrEnum):
    KANSHI = "kanshi"
    NATIVE = "native"


def _complete_sound(
    ctx: click.Context, param: click.Parameter, incomplete: str
) -> list[CompletionItem]:
    """Candidates for `jumpy sound`: media classes first, then that class's
    devices. A failure here has to stay silent — an exception during completion
    surfaces as a broken prompt rather than an error anyone can read."""
    typed = tuple(ctx.params.get("args") or ())
    try:
        if not typed:
            items = [CompletionItem("ls", help="List available devices and classes")]
            items += [
                CompletionItem(name, help="media class")
                for name in Jumpy().sound_class_names()
            ]
        elif len(typed) == 1 and typed[0] != "ls":
            items = [
                CompletionItem(name, help="device")
                for name in Jumpy().sound_device_names(typed[0])
            ]
        else:
            return []
    except OSError, subprocess.SubprocessError, json.JSONDecodeError:
        return []

    return [item for item in items if item.value.startswith(incomplete)]


def _complete_display(
    ctx: click.Context, param: click.Parameter, incomplete: str
) -> list[CompletionItem]:
    """Candidates for `jumpy display`: the profiles the selected backend
    defines, plus the two verbs. Reads `--backend` off the partial parse, so
    completing after `--backend native` offers profiles.lua's names."""
    if ctx.params.get("args"):
        return []
    backend = DisplayBackend(ctx.params.get("backend") or DisplayBackend.KANSHI)
    items = [
        CompletionItem("ls", help="List available profiles"),
        CompletionItem("reload", help="Re-run auto-match"),
    ]
    try:
        items += [
            CompletionItem(name, help=f"{backend} profile")
            for name in Jumpy().display_profiles(backend)
        ]
    except OSError:
        return []

    return [item for item in items if item.value.startswith(incomplete)]


class Jumpy:
    AUDIO_ICON = "/usr/share/icons/Adwaita/scalable/devices/audio-headphones.svg"
    DISPLAY_ICON = "/usr/share/icons/Adwaita/scalable/devices/video-display.svg"
    KANSHI_CONFIG = Path.home() / ".config/kanshi/config"
    DISPLAY_MODULE = "outputs.profiles"
    PROFILES_LUA = Path.home() / ".config/hypr/outputs/profiles.lua"

    def _pw_nodes(self) -> list[dict]:
        log.debug("spawn: pw-dump")
        proc = subprocess.run(["pw-dump"], capture_output=True, text=True, check=True)
        log.debug("pw-dump stderr: %s", proc.stderr.strip())
        return [
            n
            for n in json.loads(proc.stdout)
            if n.get("type") == "PipeWire:Interface:Node"
        ]

    def sound_ls(self) -> None:
        table = Table(show_header=True, box=None)
        table.add_column("media.class", style="bold")
        table.add_column("alsa.card_name")
        table.add_column("media.name")
        for node in self._pw_nodes():
            props = node.get("info", {}).get("props", {})
            table.add_row(
                *(
                    str(props.get(key, ""))
                    for key in ("media.class", "alsa.card_name", "media.name")
                )
            )
        console.print(table)

    def sound_class_names(self) -> list[str]:
        """Distinct media.class values, in first-seen order."""
        seen: list[str] = []
        for node in self._pw_nodes():
            value = node.get("info", {}).get("props", {}).get("media.class")
            if value and value not in seen:
                seen.append(value)
        return seen

    def sound_device_names(self, media_class: str) -> list[str]:
        """Every name `sound_apply` will match for a class, in first-seen order."""
        seen: list[str] = []
        for node in self._pw_nodes():
            props = node.get("info", {}).get("props", {})
            if props.get("media.class") != media_class:
                continue
            for key in ("alsa.card_name", "media.name"):
                value = props.get(key)
                if value and value not in seen:
                    seen.append(value)
        return seen

    def sound_apply(self, media_class: str, card_name: str) -> None:
        for node in self._pw_nodes():
            props = node.get("info", {}).get("props", {})
            if props.get("media.class") != media_class:
                continue
            if card_name in (props.get("alsa.card_name"), props.get("media.name")):
                log.debug("spawn: wpctl set-default %s", node["id"])
                subprocess.run(["wpctl", "set-default", str(node["id"])], check=True)
                notify(f"wireplumber [{media_class}]", card_name, self.AUDIO_ICON)
                return
        raise click.ClickException(f"no node matches {media_class!r} + {card_name!r}")

    def _ensure_native(self) -> Hyprctl:
        # Guard the `require`-driven native paths (reload / switch): fail
        # unless profiles.lua is ALREADY loaded in a running instance.
        # Probed through `package.loaded` so the check never *loads* the
        # module itself — force-loading it via `require` while kanshi is
        # still running would wire profiles.lua's hotplug hooks alongside
        # kanshi, and the two would fight over every monitor event. The
        # Hyprctl self-discovers the instance socket, so bare-env callers
        # (SSH, systemd, home-assistant) work without
        # HYPRLAND_INSTANCE_SIGNATURE.
        hypr = Hyprctl()
        if not hypr.eval(f'assert(package.loaded["{self.DISPLAY_MODULE}"])'):
            raise click.ClickException(
                "--backend native needs a running Hyprland with profiles.lua "
                "loaded (uncomment its require in ~/.config/hypr/outputs/init.lua)."
            )

        return hypr

    def display_profiles(self, backend: DisplayBackend) -> list[str]:
        """Profile names the backend defines, in file order.

        Reading either file is side-effect-free, so this never needs the native
        load guard — the .lua file is the source of truth (0.56 still can't
        return a Lua value through hyprctl)."""
        if backend is DisplayBackend.NATIVE:
            text = self.PROFILES_LUA.read_text()
            return [m.group(1) for m in re.finditer(r'\["([^"]+)"\]\s*=\s*\{', text)]

        text = self.KANSHI_CONFIG.read_text()
        seen: list[str] = []
        for match in re.finditer(r"^\s*profile\s+(\S+)\s*\{", text, re.MULTILINE):
            if match.group(1) not in seen:
                seen.append(match.group(1))
        return seen

    def display_ls(self, backend: DisplayBackend) -> None:
        # One per line, deliberately plain: this is the machine-readable list.
        for name in self.display_profiles(backend):
            sys.stdout.write(f"{name}\n")

    def display_reload(self, backend: DisplayBackend) -> None:
        if backend is DisplayBackend.NATIVE:
            hypr = self._ensure_native()
            if not hypr.eval(f'require("{self.DISPLAY_MODULE}").auto_apply()'):
                raise click.ClickException("reload failed.")
            return

        try:
            log.debug("spawn: kanshictl reload")
            subprocess.run(["kanshictl", "reload"], check=True, timeout=10)
        except subprocess.TimeoutExpired:
            # Hyprland 0.56 never ACKs a wlr-output-management apply that
            # changes nothing, so kanshi's reload hangs whenever the
            # config is already active. Already-applied is success.
            log.warning("kanshictl reload timed out — state already active.")

    def display_switch(self, profile: str, backend: DisplayBackend) -> None:
        if backend is DisplayBackend.NATIVE:
            hypr = self._ensure_native()
            # profiles.lua's apply() emits its own "Applied profile" notify.
            if not hypr.eval(
                f'require("{self.DISPLAY_MODULE}").apply({json.dumps(profile)})'
            ):
                raise click.ClickException(f"switch to {profile} failed.")
            return

        log.debug("spawn: wayland-user.sh kanshictl switch %s", profile)
        subprocess.run(
            ["/etc/udev/scripts/wayland-user.sh", "kanshictl", "switch", profile],
            check=True,
        )
        notify("display", f"Trigger profile {profile}.", self.DISPLAY_ICON)

    # ── CLI ──────────────────────────────────────────────────────────

    @click.group("jumpy", context_settings={"help_option_names": ["-h", "--help"]})
    @click.option("-v", "--verbose", is_flag=True, help="Enable debug logging.")
    def cli(verbose: bool) -> None:
        """Switch audio sinks and display profiles."""
        global log
        log = create_logger(verbose, name="jumpy")

    @cli.command("sound")
    @click.argument("args", nargs=-1, shell_complete=_complete_sound)
    @click.pass_context
    def cmd_sound(ctx: click.Context, args: tuple[str, ...]) -> None:
        """Set the default audio device via wireplumber.

        \b
        jumpy sound ls                              list devices and classes
        jumpy sound 'Audio/Sink' 'Scarlett 8i6 USB' set the default
        """
        match list(args):
            case [] | ["help"]:
                click.echo(ctx.get_help())
            case ["ls"]:
                Jumpy().sound_ls()
            case [media_class, card_name]:
                Jumpy().sound_apply(media_class, card_name)
            case _:
                click.echo(ctx.get_help())
                ctx.exit(2)

    @cli.command("display")
    @click.option(
        "--backend",
        type=click.Choice([b.value for b in DisplayBackend]),
        default=DisplayBackend.KANSHI.value,
        help="Profile backend: kanshi (default) or native profiles.lua.",
    )
    @click.argument("args", nargs=-1, shell_complete=_complete_display)
    @click.pass_context
    def cmd_display(ctx: click.Context, backend: str, args: tuple[str, ...]) -> None:
        """Apply or list Hyprland monitor profiles.

        \b
        jumpy display ls        list available profiles
        jumpy display reload    re-run auto-match
        jumpy display <profile> apply a profile
        """
        chosen = DisplayBackend(backend)
        match list(args):
            case [] | ["help"]:
                click.echo(ctx.get_help())
            case ["ls"]:
                Jumpy().display_ls(chosen)
            case ["reload"]:
                Jumpy().display_reload(chosen)
            case [profile]:
                Jumpy().display_switch(profile, chosen)
            case _:
                click.echo(ctx.get_help())
                ctx.exit(2)

    @cli.command("completion")
    @click.argument("shell", type=click.Choice(["zsh"]), default="zsh")
    @click.pass_context
    def cmd_completion(ctx: click.Context, shell: str) -> None:
        """Print the shell completion script."""
        completion = get_completion_class(shell)
        prog = ctx.find_root().info_name or "jumpy"
        variable = f"_{prog.replace('-', '_').replace('.', '_').upper()}_COMPLETE"
        click.echo(completion(ctx.find_root().command, {}, prog, variable).source())


if __name__ == "__main__":
    Jumpy.cli()
