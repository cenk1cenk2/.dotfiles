#!/usr/bin/env -S sh -c 'exec uv run --project "$(dirname "$0")" python "$0" "$@"'
"""Set CPU power profiles and show current limits."""

from __future__ import annotations

import json
import logging
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from enum import StrEnum
from functools import cache
from pathlib import Path
from typing import ClassVar, Protocol

import click
from rich.console import Console
from rich.table import Table
from rich.text import Text

from dotlib.cli import create_logger

class CpuVendor(StrEnum):
    INTEL = "GenuineIntel"
    AMD = "AuthenticAMD"

class SmiMode(StrEnum):
    """Whether a view may call nvidia-smi, which powers a sleeping GPU up.

    AUTO only queries a GPU that sysfs already reports as active, so a
    read-only status view never becomes the reason the GPU woke.
    """

    AUTO = "auto"
    YES = "yes"
    NO = "no"

@dataclass
class GpuCard:
    """One DRM card, read from sysfs only.

    Model comes from the pci.ids database rather than lspci: lspci reads
    PCI config space, which resumes a D3cold device.
    """

    name: str
    pci_id: str
    vendor_id: str
    device_id: str
    subsystem_vendor_id: str | None
    subsystem_device_id: str | None
    class_id: str
    driver: str | None
    power_control: str | None
    runtime_status: str | None
    label: str | None
    model: str | None
    nodes: list[Path]

    VENDOR_NAMES: ClassVar[dict[str, str]] = {
        "0x1002": "AMD",
        "0x10de": "NVIDIA",
        "0x8086": "Intel",
    }

    @property
    def vendor(self) -> str:
        return self.VENDOR_NAMES.get(self.vendor_id, self.vendor_id)

    @property
    def short_model(self) -> str:
        model = self.model or self.label or self.device_id
        # pci.ids wraps the marketing name in brackets after the die name,
        # e.g. "GA107M [GeForce RTX 3050 Mobile]" — keep the marketing half.
        bracketed = re.search(r"\[([^\]]+)\]", model)
        if bracketed:
            model = bracketed.group(1)
        model = re.sub(r"\s+", " ", model).strip()
        # Some pci.ids names repeat the vendor ("Intel Graphics"); the table
        # already carries a vendor column.
        model = re.sub(rf"^{re.escape(self.vendor)} (?=\S)", "", model)

        return model or self.device_id

    @property
    def is_nvidia(self) -> bool:
        return self.vendor_id == Tdp.NVIDIA_VENDOR_ID

    @property
    def is_active(self) -> bool:
        return self.runtime_status == "active"

@dataclass
class GpuHolder:
    pid: int
    ppid: int | None
    state: str
    command: str
    args: str
    nodes: list[Path]

    # Only /dev/nvidia<N> and /dev/nvidia-uvm* opens ref dynamic power via
    # nv_start_device(). /dev/nvidiactl short-circuits to nvidia_ctl_open()
    # and DRM nodes take no ref at all (nv_drm_open assigns an id and
    # returns) — holders of those cannot block RTD3.
    PINNING_PATTERN: ClassVar[re.Pattern[str]] = re.compile(
        r"^/dev/nvidia(\d+|-uvm)"
    )

    @property
    def pins(self) -> bool:
        return any(self.PINNING_PATTERN.match(str(node)) for node in self.nodes)

@dataclass
class PowerLimit:
    domain: str
    domain_name: str | None
    constraint: str
    constraint_name: str | None
    microwatts: int

    @property
    def watts(self) -> str:
        return f"{self.microwatts / 1_000_000:.3g}"

@dataclass
class BatteryStatus:
    backend: str
    limit: str
    capacity: int | None
    rows: list[tuple[str, str]]

class BatteryBackend(Protocol):
    """Charge-limit interface for one detected battery mechanism."""

    name: str

    def status(self) -> BatteryStatus: ...
    def apply_on(self) -> str: ...
    def apply_off(self) -> str: ...
    def apply_limit(self, end: int, start: int | None) -> str: ...

class ThresholdBattery:
    """Generic kernel charge_control_*_threshold ABI (ThinkPad, ASUS, …)."""

    name = "generic charge threshold"
    DEFAULT_END = 80
    POWER_SUPPLY_PATH = Path("/sys/class/power_supply")

    def __init__(self, tdp: Tdp, battery: Path) -> None:
        self.tdp = tdp
        self.battery = battery

    @classmethod
    def create(cls, tdp: Tdp) -> ThresholdBattery | None:
        matches = sorted(
            path.parent
            for path in cls.POWER_SUPPLY_PATH.glob(
                "*/charge_control_end_threshold"
            )
        )
        if not matches:
            return None

        return cls(tdp, matches[0])

    @property
    def end_path(self) -> Path:
        return self.battery / "charge_control_end_threshold"

    @property
    def start_path(self) -> Path:
        return self.battery / "charge_control_start_threshold"

    def read_int(self, path: Path) -> int | None:
        raw = self.tdp.read_optional(path)
        return int(raw) if raw and raw.isdigit() else None

    def status(self) -> BatteryStatus:
        end = self.read_int(self.end_path)
        start = self.read_int(self.start_path)
        rows = [
            ("Battery", self.battery.name),
            ("End", f"{end}%" if end is not None else "?"),
        ]
        if start is not None:
            rows.append(("Start", f"{start}%"))

        return BatteryStatus(
            self.name,
            f"{end}%" if end is not None else "?",
            self.read_int(self.battery / "capacity"),
            rows,
        )

    def set_end(self, end: int, start: int | None) -> None:
        if start is not None and self.start_path.exists():
            self.tdp.write_sysfs(self.start_path, f"{start}\n")
        self.tdp.write_sysfs(self.end_path, f"{end}\n")

    def apply_limit(self, end: int, start: int | None) -> str:
        if not 1 <= end <= 100:
            raise click.ClickException("Charge limit must be between 1 and 100.")
        if start is not None and not 0 <= start < end:
            raise click.ClickException(
                "Start threshold must be below the end threshold."
            )
        self.set_end(end, start)

        return f"end {end}%" + (f", start {start}%" if start is not None else "")

    def apply_on(self) -> str:
        current = self.read_int(self.end_path)
        end = current if current is not None and current < 100 else self.DEFAULT_END
        self.set_end(end, None)

        return f"on (end {end}%)"

    def apply_off(self) -> str:
        self.set_end(100, None)

        return "off (end 100%)"

class IdeapadConservationBattery:
    """Lenovo IdeaPad/Yoga conservation_mode — binary, firmware-fixed ~60% cap."""

    name = "Lenovo conservation mode"
    CONSERVATION_GLOB = (
        "sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode"
    )
    POWER_SUPPLY_PATH = Path("/sys/class/power_supply")

    def __init__(self, tdp: Tdp, conservation: Path) -> None:
        self.tdp = tdp
        self.conservation = conservation

    @classmethod
    def create(cls, tdp: Tdp) -> IdeapadConservationBattery | None:
        matches = sorted(Path("/").glob(cls.CONSERVATION_GLOB))
        if not matches:
            return None

        return cls(tdp, matches[0])

    def enabled(self) -> bool:
        return self.tdp.read_optional(self.conservation) == "1"

    def capacity(self) -> int | None:
        for path in sorted(self.POWER_SUPPLY_PATH.glob("BAT*/capacity")):
            raw = self.tdp.read_optional(path)
            if raw and raw.isdigit():
                return int(raw)

        return None

    def status(self) -> BatteryStatus:
        on = self.enabled()

        return BatteryStatus(
            self.name,
            "on" if on else "off",
            self.capacity(),
            [
                ("Conservation", "on" if on else "off"),
                ("Cap", "EC-enforced (level not exposed)"),
            ],
        )

    def apply_on(self) -> str:
        self.tdp.write_sysfs(self.conservation, "1\n")

        return "on"

    def apply_off(self) -> str:
        self.tdp.write_sysfs(self.conservation, "0\n")

        return "off"

    def apply_limit(self, end: int, start: int | None) -> str:
        raise click.ClickException(
            "This machine's Lenovo conservation mode is on/off only "
            "(cap is EC-enforced, not settable); use `tdp battery on` / `off`."
        )

@dataclass
class NvidiaSnapshot:
    """Passive sysfs view of one NVIDIA PCI function, plus its node holders.

    Captured before any nvidia-smi call, which would power the GPU up and
    make every reading report an awake device.
    """

    pci_id: str
    control: str | None
    runtime_status: str | None
    power_state: str | None
    active_ms: int | None
    suspended_ms: int | None
    holders: list[GpuHolder]

    @property
    def pinning_holders(self) -> list[GpuHolder]:
        return [holder for holder in self.holders if holder.pins]

    @property
    def sleep_ratio(self) -> float | None:
        if self.active_ms is None or self.suspended_ms is None:
            return None
        total = self.active_ms + self.suspended_ms
        if total == 0:
            return None

        return self.suspended_ms / total

    @staticmethod
    def format_duration(milliseconds: int | None) -> str:
        if milliseconds is None:
            return "?"
        seconds, ms = divmod(milliseconds, 1000)
        minutes, s = divmod(seconds, 60)
        hours, m = divmod(minutes, 60)
        if hours:
            return f"{hours}h{m:02d}m"
        if minutes:
            return f"{m}m{s:02d}s"

        return f"{s}.{ms // 100}s"

class Tdp:
    @click.group(context_settings={"help_option_names": ["-h", "--help"]})
    @click.option("-v", "--verbose", is_flag=True, help="Show subprocess traces.")
    def cli(verbose: bool) -> None:
        create_logger(verbose, name="tdp")

    console: ClassVar[Console] = Console(force_terminal=None)
    log = logging.getLogger("tdp")

    PROFILE_PATH = Path("/sys/firmware/acpi/platform_profile")
    PROFILE_CHOICES_PATH = Path("/sys/firmware/acpi/platform_profile_choices")
    HOSTNAME_PATH = Path("/proc/sys/kernel/hostname")
    CPUINFO_PATH = Path("/proc/cpuinfo")
    PCI_DEVICES_PATH = Path("/sys/bus/pci/devices")
    POWER_SUPPLY_PATH = Path("/sys/class/power_supply")
    DMI_VENDOR_PATH = Path("/sys/class/dmi/id/sys_vendor")
    FAN_MODE_GLOB = "sys/bus/platform/devices/VPC2004:*/fan_mode"
    # ideapad fan_mode: kernel accepts 0/1/2/4 only (3 and >4 rejected).
    FAN_MODE_VALUES: ClassVar[tuple[str, ...]] = ("0", "1", "2", "4")
    # Friendly names only apply on Lenovo; other vendors get generic labels.
    LENOVO_FAN_MODES: ClassVar[dict[str, str]] = {
        "0": "Super Silent",
        "1": "Standard",
        "2": "Dust Cleaning",
        "4": "Efficient Thermal Dissipation",
    }
    # Some firmware reports Super Silent as 133 on read.
    FAN_READ_ALIASES: ClassVar[dict[str, str]] = {"133": "Super Silent"}
    NVIDIA_VENDOR_ID = "0x10de"
    NVIDIA_GPU_CLASSES: ClassVar[set[str]] = {"0x030000", "0x030200"}
    AMD_PRESETS_BY_HOST: ClassVar[dict[str, dict[str, list[str]]]] = {
        "emanet": {
            "30": [
                "--stapm-limit=28000",
                "--fast-limit=35000",
                "--slow-limit=32000",
                "--tctl-temp=95",
                "--max-performance",
            ],
            "28": [
                "--stapm-limit=28000",
                "--fast-limit=30000",
                "--slow-limit=30000",
                "--tctl-temp=95",
                "--max-performance",
            ],
            "25": [
                "--stapm-limit=25000",
                "--fast-limit=28000",
                "--slow-limit=28000",
                "--tctl-temp=90",
                "--max-performance",
            ],
            "20": [
                "--stapm-limit=20000",
                "--fast-limit=25000",
                "--slow-limit=22000",
                "--tctl-temp=90",
                "--max-performance",
            ],
            "18": [
                "--stapm-limit=18000",
                "--fast-limit=22000",
                "--slow-limit=20000",
                "--tctl-temp=85",
                "--max-performance",
            ],
            "15": [
                "--stapm-limit=15000",
                "--fast-limit=18000",
                "--slow-limit=17000",
                "--tctl-temp=85",
                "--max-performance",
            ],
            "12": [
                "--stapm-limit=12000",
                "--fast-limit=15000",
                "--slow-limit=15000",
                "--tctl-temp=85",
                "--power-saving",
            ],
            "9": [
                "--stapm-limit=9000",
                "--fast-limit=12000",
                "--slow-limit=12000",
                "--tctl-temp=80",
                "--power-saving",
            ],
            "5": [
                "--stapm-limit=5000",
                "--fast-limit=9000",
                "--slow-limit=9000",
                "--tctl-temp=75",
                "--power-saving",
            ],
        },
    }

    def vendor(self) -> CpuVendor:
        for line in self.CPUINFO_PATH.read_text().splitlines():
            if line.startswith("vendor_id"):
                raw_vendor = line.split(":", maxsplit=1)[1].strip()
                try:
                    return CpuVendor(raw_vendor)
                except ValueError as exc:
                    raise click.ClickException(
                        f"Unsupported CPU vendor: {raw_vendor}"
                    ) from exc

        raise click.ClickException("Could not detect CPU vendor.")

    def hostname(self) -> str:
        return self.HOSTNAME_PATH.read_text().strip()

    def amd_presets(self) -> dict[str, list[str]]:
        hostname = self.hostname()
        try:
            return self.AMD_PRESETS_BY_HOST[hostname]
        except KeyError as exc:
            raise click.ClickException(
                f"AMD TDP presets are not configured for {hostname}."
            ) from exc

    def run(
        self,
        cmd: list[str],
        *,
        input_text: str | None = None,
        check: bool = True,
        echo_output: bool = False,
    ) -> subprocess.CompletedProcess[str]:
        self.log.debug("spawn: %s", " ".join(cmd))
        proc = subprocess.run(
            cmd,
            input=input_text,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if proc.stderr:
            self.log.debug("%s stderr: %s", cmd[0], proc.stderr.strip())
        if echo_output:
            sys.stdout.write(proc.stdout)
            sys.stderr.write(proc.stderr)
        if check and proc.returncode != 0:
            output = "\n".join(
                part for part in (proc.stderr.strip(), proc.stdout.strip()) if part
            )
            raise click.ClickException(
                output
                or f"{cmd[0]} failed with exit code {proc.returncode}."
            )

        return proc

    def show(self) -> None:
        match self.vendor():
            case CpuVendor.INTEL:
                self.show_intel()
            case CpuVendor.AMD:
                self.show_amd()

    def list_values(self) -> None:
        table = Table(title="tdp set values", box=None)
        table.add_column("Value", style="bold")
        table.add_column("Meaning")

        match self.vendor():
            case CpuVendor.INTEL:
                for profile in self.intel_profile_choices():
                    table.add_row(profile, "Intel platform profile")
            case CpuVendor.AMD:
                for preset in sorted(self.amd_presets(), key=int, reverse=True):
                    table.add_row(preset, "AMD RyzenAdj TDP preset")
                table.add_row("gfx <clock>", "AMD RyzenAdj graphics clock")

        self.console.print(table)

    def normalize_intel_profile(self, profile: str) -> str:
        choices = self.intel_profile_choices()
        if profile in choices:
            return profile

        raise click.ClickException(f"Platform profile unavailable: {profile}")

    def write_sysfs(self, path: Path, text: str) -> None:
        try:
            path.write_text(text)
        except (PermissionError, OSError):
            self.run(["sudo", "tee", str(path)], input_text=text)

    def set_intel_profile(self, profile: str) -> None:
        profile = self.normalize_intel_profile(profile)
        self.write_sysfs(self.PROFILE_PATH, f"{profile}\n")
        self.show_intel()
        self.console.print(f"Applied: [bold]{profile}[/]")

    def set_amd_preset(self, preset: str) -> None:
        presets = self.amd_presets()
        if preset not in presets:
            raise click.ClickException(
                f"AMD TDP preset {preset} is not configured for {self.hostname()}."
            )

        self.run(["sudo", "ryzenadj", *presets[preset]], echo_output=True)
        self.show_amd()
        self.console.print(f"Applied: [bold]{preset}[/]")

    def set_amd_gfx(self, clock: str) -> None:
        self.amd_presets()
        self.run(["sudo", "ryzenadj", "--gfx-clk", clock], echo_output=True)
        self.show_amd()
        self.console.print(f"Applied gfx clock: [bold]{clock}[/]")

    def nvidia_gpu_pci_ids(self) -> list[str]:
        ids: list[str] = []
        for device in sorted(self.PCI_DEVICES_PATH.glob("*")):
            vendor = self.read_optional(device / "vendor")
            device_class = self.read_optional(device / "class")
            if (
                vendor == self.NVIDIA_VENDOR_ID
                and device_class in self.NVIDIA_GPU_CLASSES
            ):
                ids.append(device.name)

        return ids

    def nvidia_gpu_pci_id(self, pci_id: str | None = None) -> str:
        if pci_id:
            return pci_id

        pci_ids = self.nvidia_gpu_pci_ids()
        if not pci_ids:
            raise click.ClickException("No visible NVIDIA GPU PCI device found.")
        if len(pci_ids) > 1:
            raise click.ClickException("Multiple NVIDIA GPUs found; pass --pci.")

        return pci_ids[0]

    def nvidia_pci_functions(self, pci_id: str) -> list[Path]:
        base = pci_id.rsplit(".", maxsplit=1)[0]
        functions: list[Path] = []
        for device in sorted(self.PCI_DEVICES_PATH.glob(f"{base}.*")):
            if self.read_optional(device / "vendor") == self.NVIDIA_VENDOR_ID:
                functions.append(device)

        return functions

    def set_nvidia_power_auto(self, pci_id: str) -> None:
        for device in self.nvidia_pci_functions(pci_id):
            control = device / "power/control"
            if control.exists():
                self.run(["sudo", "tee", str(control)], input_text="auto\n")

    def set_nvidia_persistence(self, pci_id: str, enabled: bool) -> None:
        self.run(
            [
                "sudo",
                "nvidia-smi",
                "-i",
                pci_id,
                "--persistence-mode=1" if enabled else "--persistence-mode=0",
            ],
            echo_output=True,
        )

    def set_nvidia_drain(self, pci_id: str, enabled: bool) -> None:
        proc = self.run(
            [
                "sudo",
                "nvidia-smi",
                "drain",
                "-p",
                pci_id,
                "-m",
                "1" if enabled else "0",
            ],
            check=False,
        )
        if proc.returncode == 0:
            sys.stdout.write(proc.stdout)
            sys.stderr.write(proc.stderr)
            return

        state = self.nvidia_drain_state(pci_id)
        if enabled and state == "draining":
            return
        if not enabled and state == "not draining":
            return

        output = "\n".join(
            part for part in (proc.stderr.strip(), proc.stdout.strip()) if part
        )
        raise click.ClickException(
            output or f"nvidia-smi drain failed with exit code {proc.returncode}."
        )

    def nvidia_drain_state(self, pci_id: str) -> str:
        proc = self.run(["nvidia-smi", "drain", "-q", "-p", pci_id], check=False)
        output = f"{proc.stdout}\n{proc.stderr}".strip()
        if proc.returncode != 0:
            return output or "unknown"

        marker = " is: "
        if marker in output:
            return output.split(marker, maxsplit=1)[1].rstrip(".")

        return output or "unknown"

    @staticmethod
    @cache
    def pci_ids_lines() -> tuple[str, ...]:
        """Cached pci.ids database, so a multi-card scan reads the file once."""
        try:
            text = Path("/usr/share/hwdata/pci.ids").read_text(
                encoding="utf-8", errors="replace"
            )
        except OSError:
            return ()

        return tuple(text.splitlines())

    def pci_device_name(self, pci_id: str) -> str | None:
        # Resolved from sysfs IDs + the pci.ids database instead of lspci:
        # config-space reads power a D3cold device back up, sysfs does not.
        device = self.PCI_DEVICES_PATH / pci_id
        vendor = (self.read_optional(device / "vendor") or "").removeprefix("0x")
        model = (self.read_optional(device / "device") or "").removeprefix("0x")
        if not vendor or not model:
            return None

        in_vendor = False
        for line in self.pci_ids_lines():
            if not line or line.startswith("#"):
                continue
            if not line.startswith("\t"):
                in_vendor = line[:4].lower() == vendor
            elif in_vendor and not line.startswith("\t\t"):
                entry = line.strip()
                if entry[:4].lower() == model:
                    return entry[4:].strip()

        return None

    def nvidia_nodes(self, pci_id: str) -> list[Path]:
        nodes: list[Path] = []
        # card* and renderD* are siblings under drm/, not nested. Globbing
        # renderD* inside the card directory finds nothing, which silently
        # hides the render node — worth listing even though bare DRM opens
        # take no power ref (see GpuHolder.PINNING_PATTERN).
        drm_path = self.PCI_DEVICES_PATH / pci_id / "drm"
        for node in sorted(drm_path.glob("card*")) + sorted(drm_path.glob("renderD*")):
            nodes.append(Path("/dev/dri") / node.name)

        for pattern in ("/dev/nvidia*", "/dev/nvidia-caps/nvidia-cap*"):
            for node in sorted(Path("/").glob(pattern.removeprefix("/"))):
                if node.exists() and not node.is_dir():
                    nodes.append(node)

        seen: set[Path] = set()
        unique: list[Path] = []
        for node in nodes:
            if node in seen or not node.exists():
                continue
            seen.add(node)
            unique.append(node)

        return unique

    def node_holders(self, nodes: list[Path]) -> list[GpuHolder]:
        """Processes holding any of `nodes` open, with their /proc details.

        Only fuser's stdout carries bare PIDs; its stderr holds the filename
        and the access-mode letters, and scanning that too would read the
        trailing digit of `/dev/dri/card0` as a PID.
        """
        held: dict[int, list[Path]] = {}
        for node in nodes:
            proc = self.run(["fuser", str(node)], check=False)
            for raw_pid in proc.stdout.split():
                if raw_pid.isdigit():
                    held.setdefault(int(raw_pid), []).append(node)

        holders: list[GpuHolder] = []
        for pid in sorted(held):
            proc_path = Path("/proc") / str(pid)
            try:
                # comm can contain spaces and parens, so ppid/state are taken
                # relative to the final ')' rather than by field index.
                stat = (proc_path / "stat").read_text()
                fields = stat[stat.rindex(")") + 1 :].split()
                state, ppid = fields[0], int(fields[1])
            except (FileNotFoundError, PermissionError, OSError, ValueError, IndexError):
                state, ppid = "?", None

            command = self.read_optional(proc_path / "comm") or "?"
            args = (self.read_optional(proc_path / "cmdline") or "").replace(
                "\x00", " "
            ).strip()
            holders.append(
                GpuHolder(
                    pid=pid,
                    ppid=ppid,
                    state=state,
                    command=command,
                    args=args or command,
                    nodes=held[pid],
                )
            )

        return holders

    def nvidia_holders(self, pci_id: str) -> list[GpuHolder]:
        return self.node_holders(self.nvidia_nodes(pci_id))

    def print_holders(
        self,
        holders: list[GpuHolder],
        title: str,
        labels: dict[Path, str] | None = None,
        detailed: bool = False,
    ) -> None:
        if not holders:
            self.console.print(f"[green]No {title.lower()}.[/]")
            return

        table = Table(title=title, box=None)
        table.add_column("PID", justify="right", style="bold")
        if detailed:
            table.add_column("PPID", justify="right")
            table.add_column("State")
        table.add_column("Command")
        table.add_column("Pins")
        table.add_column("Nodes")
        if detailed:
            table.add_column("Args")

        for holder in holders:
            row = [str(holder.pid)]
            if detailed:
                row.extend(
                    [str(holder.ppid) if holder.ppid is not None else "?", holder.state]
                )
            row.append(holder.command)
            row.append("[red]yes[/]" if holder.pins else "[dim]no[/]")
            node_lines = []
            for node in holder.nodes:
                label = (labels or {}).get(node, str(node))
                style = (
                    "red" if GpuHolder.PINNING_PATTERN.match(str(node)) else "dim"
                )
                node_lines.append(f"[{style}]{label}[/]")
            row.append("\n".join(node_lines))
            if detailed:
                row.append(holder.args)
            table.add_row(*row)

        self.console.print(table)

    def nvidia_power_rows(self) -> list[list[str]]:
        query = ",".join(
            [
                "pci.bus_id",
                "power.draw",
                "enforced.power.limit",
                "power.default_limit",
                "power.min_limit",
                "power.max_limit",
                "memory.used",
                "pstate",
            ]
        )
        proc = self.run(
            [
                "nvidia-smi",
                f"--query-gpu={query}",
                "--format=csv,noheader,nounits",
            ],
            check=False,
        )

        rows: list[list[str]] = []
        for line in proc.stdout.splitlines():
            fields = [field.strip() for field in line.split(",")]
            if len(fields) == 8:
                rows.append(fields)

        return rows

    def set_nvidia_power_limit(self, watts: float, pci_id: str | None = None) -> None:
        gpu_pci_id = self.nvidia_gpu_pci_id(pci_id)
        self.run(
            ["sudo", "nvidia-smi", "-i", gpu_pci_id, "-pl", f"{watts:g}"],
            echo_output=True,
        )
        self.show_nvidia(gpu_pci_id, smi=SmiMode.YES)

    def resolve_smi(self, mode: SmiMode, active: bool) -> bool:
        """Whether nvidia-smi may run; AUTO never runs it.

        AUTO used to allow smi while the GPU was already active, reasoning it
        could not cause a wake — but every smi call resets the runtime PM idle
        timer, so polling `tdp nvidia show` on an active GPU kept it active
        forever. Passive unless explicitly asked.
        """
        if mode == SmiMode.YES:
            return bool(shutil.which("nvidia-smi"))
        if mode == SmiMode.AUTO:
            self.console.print(
                "[dim]Skipped nvidia-smi: querying wakes a sleeping GPU and "
                "resets an active GPU's idle timer. Use --smi to query.[/]"
            )

        return False

    def show_nvidia(self, pci_id: str | None = None, smi: SmiMode = SmiMode.NO) -> None:
        self.console.rule("[bold yellow]NVIDIA[/]")
        pci_ids = (
            [self.nvidia_gpu_pci_id(pci_id)] if pci_id else self.nvidia_gpu_pci_ids()
        )
        if not pci_ids:
            self.console.print("[yellow]No visible NVIDIA GPU PCI devices.[/]")
            excluded = self.run(["nvidia-smi", "--list-excluded-gpus"], check=False)
            if excluded.stdout.strip():
                self.console.print(Text(excluded.stdout.rstrip()))
            return

        # Snapshot sysfs and holders before any nvidia-smi call: querying smi
        # powers the GPU up, so reading runtime_status afterwards would always
        # report "active" even for a GPU that was suspended a moment ago.
        snapshots = [
            NvidiaSnapshot(
                pci_id=gpu_pci_id,
                control=self.read_optional(
                    self.PCI_DEVICES_PATH / gpu_pci_id / "power/control"
                ),
                runtime_status=self.read_optional(
                    self.PCI_DEVICES_PATH / gpu_pci_id / "power/runtime_status"
                ),
                power_state=self.read_optional(
                    self.PCI_DEVICES_PATH / gpu_pci_id / "power_state"
                ),
                active_ms=self.read_optional_int(
                    self.PCI_DEVICES_PATH / gpu_pci_id / "power/runtime_active_time"
                ),
                suspended_ms=self.read_optional_int(
                    self.PCI_DEVICES_PATH / gpu_pci_id / "power/runtime_suspended_time"
                ),
                holders=self.nvidia_holders(gpu_pci_id),
            )
            for gpu_pci_id in pci_ids
        ]
        use_smi = self.resolve_smi(
            smi, any(snapshot.runtime_status == "active" for snapshot in snapshots)
        )

        table = Table(box=None)
        table.add_column("PCI", style="bold")
        if use_smi:
            table.add_column("Drain")
        table.add_column("Power")
        table.add_column("Runtime")
        table.add_column("D-State")
        table.add_column("Awake", justify="right")
        table.add_column("Asleep", justify="right")
        table.add_column("Sleep %", justify="right")
        table.add_column("Holders", justify="right")
        for snapshot in snapshots:
            row = [snapshot.pci_id]
            if use_smi:
                row.append(self.nvidia_drain_state(snapshot.pci_id))
            state_style = "green" if snapshot.power_state == "D3cold" else "yellow"
            ratio = snapshot.sleep_ratio
            ratio_style = "green" if ratio and ratio >= 0.5 else "yellow"
            row.extend(
                [
                    snapshot.control or "?",
                    snapshot.runtime_status or "?",
                    f"[{state_style}]{snapshot.power_state}[/]"
                    if snapshot.power_state
                    else "?",
                    snapshot.format_duration(snapshot.active_ms),
                    snapshot.format_duration(snapshot.suspended_ms),
                    f"[{ratio_style}]{ratio:.1%}[/]" if ratio is not None else "?",
                    f"[{'red' if snapshot.pinning_holders else 'green'}]"
                    f"{len(snapshot.pinning_holders)}[/]/{len(snapshot.holders)}",
                ]
            )
            table.add_row(*row)
        self.console.print(table)

        for snapshot in snapshots:
            gpu_pci_id, power_state = snapshot.pci_id, snapshot.power_state
            holders, runtime_status = snapshot.holders, snapshot.runtime_status
            match runtime_status:
                case "suspended":
                    verdict = "[bold green]sleeping[/]"
                case "active":
                    verdict = "[bold yellow]awake[/]"
                case "suspending" | "resuming":
                    verdict = f"[bold cyan]{runtime_status}[/]"
                case _:
                    verdict = f"[bold]{runtime_status or 'unknown'}[/]"
            name = self.pci_device_name(gpu_pci_id)
            pinning = len(snapshot.pinning_holders)
            self.console.print(
                f"[bold]{gpu_pci_id}[/]{f' {name}' if name else ''} is {verdict}"
                f" ({power_state or '?'}, {pinning} of {len(holders)} holders pinning)"
            )

        if use_smi:
            power_table = Table(title="NVIDIA power limits", box=None)
            power_table.add_column("PCI", style="bold")
            power_table.add_column("Draw W", justify="right")
            power_table.add_column("Current W", justify="right")
            power_table.add_column("Default W", justify="right")
            power_table.add_column("Min W", justify="right")
            power_table.add_column("Max W", justify="right")
            power_table.add_column("Memory MiB", justify="right")
            power_table.add_column("P-State")
            for row in self.nvidia_power_rows():
                power_table.add_row(*row)

            if power_table.row_count:
                self.console.print(power_table)

        for snapshot in snapshots:
            self.print_holders(snapshot.holders, "NVIDIA holders")

    def drain_nvidia(self, pci_id: str | None = None) -> None:
        gpu_pci_id = self.nvidia_gpu_pci_id(pci_id)
        self.set_nvidia_persistence(gpu_pci_id, False)
        self.set_nvidia_power_auto(gpu_pci_id)
        self.set_nvidia_drain(gpu_pci_id, True)
        self.show_nvidia(gpu_pci_id, smi=SmiMode.YES)
        self.console.print(f"Draining: [bold]{gpu_pci_id}[/]")

    def undrain_nvidia(self, pci_id: str | None = None) -> None:
        gpu_pci_id = self.nvidia_gpu_pci_id(pci_id)
        self.set_nvidia_drain(gpu_pci_id, False)
        self.show_nvidia(gpu_pci_id, smi=SmiMode.YES)
        self.console.print(f"Not draining: [bold]{gpu_pci_id}[/]")

    def remove_nvidia(self, pci_id: str | None = None) -> None:
        gpu_pci_id = self.nvidia_gpu_pci_id(pci_id)
        self.set_nvidia_persistence(gpu_pci_id, False)
        self.set_nvidia_power_auto(gpu_pci_id)
        self.set_nvidia_drain(gpu_pci_id, True)

        holders = self.nvidia_holders(gpu_pci_id)
        if holders:
            self.set_nvidia_drain(gpu_pci_id, False)
            self.print_holders(holders, "NVIDIA holders")
            raise click.ClickException(
                "Cannot remove NVIDIA while processes still hold it. "
                "Close the listed processes, then retry."
            )

        try:
            self.run(
                ["sudo", "nvidia-smi", "drain", "-p", gpu_pci_id, "-r"],
                echo_output=True,
            )
        except click.ClickException as exc:
            self.run([
                "sudo",
                "nvidia-smi",
                "drain",
                "-p",
                gpu_pci_id,
                "-m",
                "0",
            ], check=False)
            raise click.ClickException(f"Failed to remove NVIDIA GPU: {exc}") from exc

        self.console.print(f"Removed NVIDIA GPU: [bold]{gpu_pci_id}[/]")
        self.show_nvidia()

    def discover_nvidia(self) -> None:
        self.run(["sudo", "nvidia-smi", "drain", "-d"], check=False, echo_output=True)
        if not self.nvidia_gpu_pci_ids():
            self.run(["sudo", "tee", "/sys/bus/pci/rescan"], input_text="1\n")

        for gpu_pci_id in self.nvidia_gpu_pci_ids():
            self.set_nvidia_power_auto(gpu_pci_id)
            self.set_nvidia_drain(gpu_pci_id, False)

        self.show_nvidia(smi=SmiMode.YES)

    def gpu_cards(self) -> list[GpuCard]:
        cards: list[GpuCard] = []
        for card_path in sorted(Path("/sys/class/drm").glob("card*")):
            if not re.fullmatch(r"card\d+", card_path.name):
                continue
            pci_path = self.resolve_optional(card_path / "device")
            if pci_path is None:
                continue

            nodes = [Path("/dev/dri") / card_path.name]
            nodes.extend(
                Path("/dev/dri") / render.name
                for render in sorted((pci_path / "drm").glob("renderD*"))
            )
            driver = self.resolve_optional(pci_path / "driver")

            cards.append(
                GpuCard(
                    name=card_path.name,
                    pci_id=pci_path.name,
                    vendor_id=self.read_optional(pci_path / "vendor") or "unknown",
                    device_id=self.read_optional(pci_path / "device") or "unknown",
                    subsystem_vendor_id=self.read_optional(
                        pci_path / "subsystem_vendor"
                    ),
                    subsystem_device_id=self.read_optional(
                        pci_path / "subsystem_device"
                    ),
                    class_id=self.read_optional(pci_path / "class") or "unknown",
                    driver=driver.name if driver else None,
                    power_control=self.read_optional(pci_path / "power/control"),
                    runtime_status=self.read_optional(
                        pci_path / "power/runtime_status"
                    ),
                    label=self.read_optional(pci_path / "label"),
                    model=self.pci_device_name(pci_path.name),
                    nodes=nodes,
                )
            )

        return cards

    def gpu_device_nodes(self, cards: list[GpuCard]) -> list[Path]:
        nodes = [node for card in cards for node in card.nodes]
        for pattern in ("dev/nvidia*", "dev/nvidia-caps/nvidia-cap*"):
            nodes.extend(sorted(Path("/").glob(pattern)))

        seen: set[Path] = set()
        unique: list[Path] = []
        for node in nodes:
            if node in seen or not node.exists() or node.is_dir():
                continue
            seen.add(node)
            unique.append(node)

        return unique

    def gpu_node_labels(
        self, cards: list[GpuCard], nodes: list[Path]
    ) -> dict[Path, str]:
        """Name each device node after the card it belongs to, for holder rows."""
        labels: dict[Path, str] = {}
        for card in cards:
            for node in card.nodes:
                role = "card" if node.name.startswith("card") else "render"
                labels[node] = f"{card.vendor} {card.short_model} {role} {node.name}"

        # /dev/nvidia* are driver nodes with no sysfs link back to a card, so
        # they can only be attributed when exactly one NVIDIA card exists.
        nvidia_cards = [card for card in cards if card.is_nvidia]
        if len(nvidia_cards) == 1:
            card = nvidia_cards[0]
            for node in nodes:
                if str(node).startswith("/dev/nvidia"):
                    labels[node] = (
                        f"{card.vendor} {card.short_model} driver {node.name}"
                    )

        return labels

    def print_gpu_cards(self, cards: list[GpuCard]) -> None:
        table = Table(title="DRM cards", box=None)
        table.add_column("Card", style="bold")
        table.add_column("Vendor")
        table.add_column("Model")
        table.add_column("PCI")
        table.add_column("IDs")
        table.add_column("Driver")
        table.add_column("Power")
        table.add_column("Nodes")

        for card in cards:
            power = Text(f"{card.power_control or '?'} / {card.runtime_status or '?'}")
            if card.runtime_status == "active":
                power.stylize("red")
            elif card.runtime_status == "suspended":
                power.stylize("green")

            ids = (
                f"vendor={card.vendor_id}\n"
                f"device={card.device_id}\n"
                f"class={card.class_id}"
            )
            if card.subsystem_vendor_id and card.subsystem_device_id:
                ids += (
                    f"\nsubsystem={card.subsystem_vendor_id}:"
                    f"{card.subsystem_device_id}"
                )

            table.add_row(
                card.name,
                card.vendor,
                card.short_model,
                card.pci_id,
                ids,
                card.driver or "?",
                power,
                "\n".join(str(node) for node in card.nodes),
            )

        self.console.print(table)

    def print_gpu_smi(self) -> None:
        power_table = Table(title="NVIDIA power limits", box=None)
        power_table.add_column("PCI", style="bold")
        power_table.add_column("Draw W", justify="right")
        power_table.add_column("Current W", justify="right")
        power_table.add_column("Default W", justify="right")
        power_table.add_column("Min W", justify="right")
        power_table.add_column("Max W", justify="right")
        power_table.add_column("Memory MiB", justify="right")
        power_table.add_column("P-State")
        for row in self.nvidia_power_rows():
            power_table.add_row(*row)

        if power_table.row_count:
            self.console.print(power_table)

        proc = self.run(
            [
                "nvidia-smi",
                "--query-compute-apps=pid,process_name,used_gpu_memory",
                "--format=csv,noheader,nounits",
            ],
            check=False,
        )
        apps = Table(title="NVIDIA compute apps", box=None)
        apps.add_column("PID", justify="right", style="bold")
        apps.add_column("Process")
        apps.add_column("Memory MiB", justify="right")
        for line in proc.stdout.splitlines():
            fields = [field.strip() for field in line.split(",")]
            if len(fields) == 3:
                apps.add_row(*fields)

        if apps.row_count:
            self.console.print(apps)

    def show_gpu(self, smi: SmiMode = SmiMode.AUTO) -> None:
        cards = self.gpu_cards()
        self.console.rule("[bold yellow]GPU[/]")
        if not cards:
            self.console.print("[yellow]No DRM cards found.[/]")
            return

        # Every reading above comes from sysfs, so the holder scan and the card
        # table are safe on a sleeping GPU; nvidia-smi is the only wake risk.
        nodes = self.gpu_device_nodes(cards)
        holders = self.node_holders(nodes)
        labels = self.gpu_node_labels(cards, nodes)
        self.print_gpu_cards(cards)
        self.print_holders(
            holders, "GPU holders", labels=labels, detailed=True
        )

        if self.resolve_smi(smi, any(card.is_nvidia and card.is_active for card in cards)):
            self.print_gpu_smi()

    def intel_profile_choices(self) -> list[str]:
        if not self.PROFILE_CHOICES_PATH.is_file():
            raise click.ClickException("Platform profile choices unavailable.")

        return self.PROFILE_CHOICES_PATH.read_text().split()

    def current_intel_profile(self) -> str | None:
        if not self.PROFILE_PATH.is_file():
            return None

        return self.PROFILE_PATH.read_text().strip()

    def intel_power_limits(self) -> list[PowerLimit]:
        limits: list[PowerLimit] = []
        powercap_path = Path("/sys/class/powercap")

        paths = sorted(
            powercap_path.glob("intel-rapl-mmio*/constraint_*_power_limit_uw")
        )
        if not paths:
            paths = sorted(
                powercap_path.glob("intel-rapl*/constraint_*_power_limit_uw")
            )

        for path in paths:
            domain = path.parent
            constraint = path.name.removesuffix("_power_limit_uw")
            try:
                microwatts = int(path.read_text().strip())
            except (FileNotFoundError, PermissionError, OSError, ValueError):
                continue

            limits.append(
                PowerLimit(
                    domain=domain.name,
                    domain_name=self.read_optional(domain / "name"),
                    constraint=constraint,
                    constraint_name=self.read_optional(domain / f"{constraint}_name"),
                    microwatts=microwatts,
                )
            )

        return limits

    def show_intel(self) -> None:
        choices = self.intel_profile_choices()
        current = self.current_intel_profile()

        self.console.rule("[bold yellow]Intel platform profiles[/]")
        self.console.print(f"Current profile: [bold]{current or '?'}[/]")

        profile_table = Table(box=None)
        profile_table.add_column("Profile", style="bold")
        profile_table.add_column("State")
        for profile in choices:
            state = "current" if profile == current else "available"
            profile_table.add_row(profile, state)
        self.console.print(profile_table)

        self.console.rule("[bold yellow]Intel power limits[/]")
        power_table = Table(box=None)
        power_table.add_column("Domain", style="bold")
        power_table.add_column("Constraint")
        power_table.add_column("µW", justify="right")
        power_table.add_column("W", justify="right")
        for limit in self.intel_power_limits():
            domain = limit.domain
            if limit.domain_name:
                domain = f"{domain} ({limit.domain_name})"
            power_table.add_row(
                domain,
                limit.constraint_name or limit.constraint,
                str(limit.microwatts),
                limit.watts,
            )

        if power_table.row_count:
            self.console.print(power_table)
        else:
            self.console.print("[yellow]Power limits unavailable.[/]")

    def show_amd(self) -> None:
        proc = self.run(["sudo", "ryzenadj", "-i"])
        if proc.stdout.strip():
            self.console.print(Text(proc.stdout.rstrip()))

    def battery_backend(self) -> BatteryBackend:
        backends: list[type[ThresholdBattery] | type[IdeapadConservationBattery]] = [
            ThresholdBattery,
            IdeapadConservationBattery,
        ]
        chosen: BatteryBackend | None = None
        for backend_cls in backends:
            candidate = backend_cls.create(self)
            if candidate is None:
                continue
            if chosen is None:
                chosen = candidate
            else:
                self.log.debug(
                    "battery: %s available but shadowed by %s",
                    backend_cls.__name__,
                    type(chosen).__name__,
                )
        if chosen is None:
            raise click.ClickException(
                "No supported battery charge-limit interface found."
            )

        return chosen

    def battery_device(self) -> Path | None:
        candidates = sorted(self.POWER_SUPPLY_PATH.glob("BAT*"))
        for path in candidates:
            if self.read_optional(path / "present") == "1":
                return path

        return candidates[0] if candidates else None

    def battery_details(self, device: Path) -> list[tuple[str, str]]:
        def num(name: str) -> int | None:
            raw = self.read_optional(device / name)
            return int(raw) if raw and raw.lstrip("-").isdigit() else None

        rows: list[tuple[str, str]] = []
        capacity = num("capacity")
        if capacity is not None:
            rows.append(("Charge", f"{capacity}%"))
        status = self.read_optional(device / "status")
        if status:
            rows.append(("Status", status))
        energy_full = num("energy_full")
        energy_design = num("energy_full_design")
        if energy_full and energy_design:
            health = energy_full / energy_design * 100
            rows.append(
                (
                    "Health",
                    f"{health:.0f}% "
                    f"({energy_full / 1e6:.1f}/{energy_design / 1e6:.1f} Wh)",
                )
            )
        energy_now = num("energy_now")
        if energy_now is not None:
            rows.append(("Energy", f"{energy_now / 1e6:.1f} Wh"))
        cycles = num("cycle_count")
        if cycles is not None:
            rows.append(("Cycles", str(cycles)))
        power_now = num("power_now")
        if power_now is not None:
            rows.append(("Power draw", f"{power_now / 1e6:.2f} W"))
        voltage = num("voltage_now")
        if voltage is not None:
            rows.append(("Voltage", f"{voltage / 1e6:.2f} V"))
        technology = self.read_optional(device / "technology")
        if technology:
            rows.append(("Technology", technology))
        maker = self.read_optional(device / "manufacturer")
        model = self.read_optional(device / "model_name")
        if maker or model:
            rows.append(("Model", " ".join(p for p in (maker, model) if p)))

        return rows

    def charge_types_device(self) -> Path | None:
        for path in sorted(self.POWER_SUPPLY_PATH.glob("BAT*/charge_types")):
            return path.parent

        return None

    def parse_charge_types(self, device: Path) -> tuple[str | None, list[str]]:
        """Return (current, choices) from a `charge_types` file's `A [B] C` form."""
        raw = self.read_optional(device / "charge_types")
        if not raw:
            return None, []

        current: str | None = None
        choices: list[str] = []
        for token in raw.split():
            name = token.strip("[]")
            choices.append(name)
            if token.startswith("["):
                current = name

        return current, choices

    def show_battery(self) -> None:
        status = self.battery_backend().status()
        self.console.rule("[bold yellow]Battery charge limit[/]")
        self.console.print(f"Backend: [bold]{status.backend}[/]")
        self.console.print(f"Limit: [bold]{status.limit}[/]")

        table = Table(box=None)
        table.add_column("Field", style="bold")
        table.add_column("Value")
        for field, value in status.rows:
            table.add_row(field, value)
        self.console.print(table)

        device = self.battery_device()
        if device is not None:
            details = Table(box=None)
            details.add_column("Field", style="bold")
            details.add_column("Value")
            for field, value in self.battery_details(device):
                details.add_row(field, value)
            if details.row_count:
                self.console.rule("[bold yellow]Battery details[/]")
                self.console.print(details)

        charge_device = self.charge_types_device()
        if charge_device is not None:
            self.console.rule("[bold yellow]Battery charge mode[/]")
            self.console.print(self.charge_types_table(charge_device))

    def charge_types_table(self, device: Path) -> Table:
        current, choices = self.parse_charge_types(device)
        table = Table(box=None)
        table.add_column("Mode", style="bold")
        table.add_column("State")
        for choice in choices:
            table.add_row(choice, "current" if choice == current else "available")

        return table

    def show_charge_types(self) -> None:
        device = self.charge_types_device()
        if device is None:
            raise click.ClickException(
                "This battery has no charge-type (charge_types) control."
            )

        self.console.print(self.charge_types_table(device))

    def set_charge_type(self, value: str) -> None:
        device = self.charge_types_device()
        if device is None:
            raise click.ClickException(
                "This battery has no charge-type (charge_types) control."
            )

        _current, choices = self.parse_charge_types(device)
        normalized = {c.lower().replace("-", "_"): c for c in choices}
        canonical = normalized.get(value.lower().replace("-", "_"))
        if canonical is None:
            raise click.ClickException(
                f"Unknown charge type {value!r}. Available: {', '.join(choices)}."
            )

        self.write_sysfs(device / "charge_types", f"{canonical}\n")
        self.show_battery()
        self.console.print(f"Applied charge type: [bold]{canonical}[/]")

    def battery_on(self) -> None:
        summary = self.battery_backend().apply_on()
        self.show_battery()
        self.console.print(f"Applied: [bold]{summary}[/]")

    def battery_off(self) -> None:
        summary = self.battery_backend().apply_off()
        self.show_battery()
        self.console.print(f"Applied: [bold]{summary}[/]")

    def battery_limit(self, end: int, start: int | None) -> None:
        summary = self.battery_backend().apply_limit(end, start)
        self.show_battery()
        self.console.print(f"Applied: [bold]{summary}[/]")

    def is_lenovo(self) -> bool:
        return "lenovo" in (self.read_optional(self.DMI_VENDOR_PATH) or "").lower()

    def fan_modes(self) -> dict[str, str]:
        """Value -> label; friendly Lenovo names on Lenovo, generic elsewhere."""
        if self.is_lenovo():
            return dict(self.LENOVO_FAN_MODES)

        return {value: f"Mode {value}" for value in self.FAN_MODE_VALUES}

    def fan_mode_path(self) -> Path | None:
        for path in sorted(Path("/").glob(self.FAN_MODE_GLOB)):
            return path

        return None

    def fan_mode_label(self, raw: str | None) -> str:
        if raw is None:
            return "?"

        return (
            self.fan_modes().get(raw)
            or self.FAN_READ_ALIASES.get(raw)
            or f"mode {raw}"
        )

    def fan_rpms(self) -> list[tuple[str, int]]:
        rpms: list[tuple[str, int]] = []
        for inp in sorted(Path("/sys/class/hwmon").glob("hwmon*/fan*_input")):
            raw = self.read_optional(inp)
            if raw is None or not raw.isdigit():
                continue
            label = self.read_optional(
                inp.with_name(inp.name.replace("_input", "_label"))
            )
            name = self.read_optional(inp.parent / "name")
            rpms.append((label or name or inp.parent.name, int(raw)))

        return rpms

    @staticmethod
    def resolve_fan_mode(value: str, modes: dict[str, str]) -> str | None:
        def norm(text: str) -> str:
            return text.lower().replace(" ", "").replace("-", "").replace("_", "")

        if value in modes:
            return value
        key = norm(value)
        by_name = {norm(label): num for num, label in modes.items()}
        if key in by_name:
            return by_name[key]
        matches = [num for name, num in by_name.items() if key and key in name]

        return matches[0] if len(matches) == 1 else None

    def show_fan(self) -> None:
        path = self.fan_mode_path()
        if path is None:
            raise click.ClickException("No fan-mode control found.")

        raw = self.read_optional(path)
        self.console.rule("[bold yellow]Fan[/]")
        self.console.print(
            f"Mode: [bold]{self.fan_mode_label(raw)}[/]"
            + (f" ({raw})" if raw else "")
        )

        table = Table(box=None)
        table.add_column("Value", style="bold")
        table.add_column("Mode")
        table.add_column("State")
        for value, label in self.fan_modes().items():
            table.add_row(value, label, "current" if value == raw else "available")
        self.console.print(table)

        rpms = self.fan_rpms()
        if rpms:
            rpm_table = Table(box=None)
            rpm_table.add_column("Sensor", style="bold")
            rpm_table.add_column("RPM", justify="right")
            for label, rpm in rpms:
                rpm_table.add_row(label, str(rpm))
            self.console.print(rpm_table)

    def set_fan_mode(self, value: str) -> None:
        path = self.fan_mode_path()
        if path is None:
            raise click.ClickException("No fan-mode control found.")

        modes = self.fan_modes()
        num = self.resolve_fan_mode(value, modes)
        if num is None:
            choices = ", ".join(f"{v} ({label})" for v, label in modes.items())
            raise click.ClickException(
                f"Unknown fan mode {value!r}. Choices: {choices}."
            )

        self.write_sysfs(path, f"{num}\n")
        self.show_fan()
        self.console.print(f"Applied fan mode: [bold]{modes[num]}[/]")

    def hyprland_monitors(self) -> list[dict]:
        proc = self.run(["hyprctl", "-j", "monitors"])
        try:
            return json.loads(proc.stdout)
        except json.JSONDecodeError as exc:
            raise click.ClickException(
                "Could not parse hyprctl monitors output."
            ) from exc

    def show_screen(self) -> None:
        monitors = self.hyprland_monitors()
        self.console.rule("[bold yellow]Screens[/]")
        if not monitors:
            self.console.print("[yellow]No monitors reported.[/]")
            return

        table = Table(box=None)
        table.add_column("Monitor", style="bold")
        table.add_column("Resolution")
        table.add_column("DPMS")
        for monitor in monitors:
            on = monitor.get("dpmsStatus", True)
            state = "[green]on[/]" if on else "[yellow]off[/]"
            resolution = f"{monitor.get('width', '?')}x{monitor.get('height', '?')}"
            table.add_row(monitor.get("name", "?"), resolution, state)
        self.console.print(table)

    def set_dpms(self, on: bool, monitor: str | None) -> None:
        # 0.55+ parses `dispatch` as a Lua expr — the legacy `dpms off`
        # verb form errors, so call the dispatcher directly. No monitor
        # arg targets every output; mouse_move/key_press_enables_dpms are
        # both on, so any input wakes them back.
        state = "on" if on else "off"
        args = f'"{state}"' + (f', "{monitor}"' if monitor else "")
        self.run(["hyprctl", "dispatch", f"hl.dsp.dpms({args})"])
        self.show_screen()
        self.console.print(
            f"Applied DPMS {state}: [bold]{monitor or 'all monitors'}[/]"
        )

    @staticmethod
    def read_optional(path: Path) -> str | None:
        try:
            text = path.read_text().strip()
        except (FileNotFoundError, PermissionError, OSError):
            return None

        return text or None

    @staticmethod
    def resolve_optional(path: Path) -> Path | None:
        try:
            return path.resolve(strict=True)
        except (FileNotFoundError, PermissionError, OSError):
            return None

    @classmethod
    def read_optional_int(cls, path: Path) -> int | None:
        text = cls.read_optional(path)
        if text is None or not text.lstrip("-").isdigit():
            return None

        return int(text)

    def set_value(self, value: str, extra: str | None = None) -> None:
        match self.vendor():
            case CpuVendor.INTEL:
                if extra is not None:
                    raise click.ClickException(
                        "Intel profile does not take a second value."
                    )
                self.set_intel_profile(value)
            case CpuVendor.AMD:
                if value == "gfx":
                    if extra is None:
                        raise click.ClickException("Missing gfx clock.")
                    self.set_amd_gfx(extra)
                else:
                    if extra is not None:
                        raise click.ClickException(
                            "AMD TDP preset does not take a second value."
                        )
                    self.set_amd_preset(value)

