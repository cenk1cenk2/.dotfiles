#!/usr/bin/env -S sh -c 'd="$(dirname "$0")"; uv sync -q --project "$d" && exec "$d/.venv/bin/python" "$0" "$@"'
# vim: ft=python
"""Sync agent session state against a peer machine or a mounted archive."""

from __future__ import annotations

import base64
import contextlib
import fcntl
import hashlib
import json
import logging
import os
import re
import secrets
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from dataclasses import dataclass, field
from datetime import datetime
from difflib import SequenceMatcher
from enum import StrEnum
from functools import cached_property
from itertools import takewhile
from pathlib import Path
from typing import ClassVar, Protocol, Self
from urllib.parse import urlencode

import click
from dotlib.cli import create_logger, run
from rich.console import Console
from rich.table import Table


class Vendor(StrEnum):
    CLAUDE = "claude"
    CODEX = "codex"
    OPENCODE = "opencode"


class Merge(StrEnum):
    """How two copies of one path become one.

    APPEND covers files only ever extended, and only by the machine that
    owns them. Both sides holding a different body means the session was
    resumed on both, which no merge can reconcile — that is a CONFLICT.

    NEWER is for the files an agent rewrites in place — plans, individual
    memories. The prefix rule misreads those: shortening one reads as the
    other side having extended it, and the deleted text comes back. The
    later mtime wins and the other body is kept in the backup tree; two
    edits the transport cannot order become a CONFLICT like any other.

    SESSION is an opencode export: one JSON document, so a resumed session
    never extends the old bytes. The side that changed since the receipt
    wins, shorter or not, as a revert drops messages. Without a receipt the
    longer message-id list wins; two lists neither of which extends the
    other are a CONFLICT.
    """

    APPEND = "append"
    LINES = "lines"
    INDEX = "index"
    NEWER = "newer"
    SESSION = "session"


class Policy(StrEnum):
    """What a deletion on one side means for the other.

    The archive is a mirror: a deliberate delete and an expired file both
    leave every side. EXPIRES differs from PROPAGATE only on a profile the
    agent sweeps by age, where an absence can be the sweep rather than a
    decision, so it is judged by age bands instead of counted as a delete.
    RETAIN keeps the far copy and never copies it back.
    """

    PROPAGATE = "propagate"
    EXPIRES = "expires"
    RETAIN = "retain"


class Band(StrEnum):
    """Where an EXPIRES path sits against the agent's own cleanup cutoff."""

    YOUNG = "young"
    # Past the cutoff less the slack: Claude may already have swept it, so it
    # is neither transferred nor counted as a delete when it goes missing.
    EXPIRING = "expiring"
    # Past the cutoff plus the slack: every machine has swept it by now, so
    # the archive, which nothing sweeps, drops it too.
    EXPIRED = "expired"


class Action(StrEnum):
    SAME = "same"
    PULL = "pull"
    PUSH = "push"
    MERGE = "merge"
    DROP_LOCAL = "drop-here"
    DROP_REMOTE = "drop-there"
    # A RETAIN path deleted on one side: the other keeps its copy, and the
    # tombstone stops it from being copied back.
    KEEP = "keep"
    # Local-only on a first sync, where a deletion made elsewhere and a file
    # new here look the same. Pushed only by `--adopt`.
    UNCLAIMED = "unclaimed"
    # An expiring path left alone: the agent's own sweep settles it.
    SKIP = "skip"
    # A side wrote to the path between planning and applying, or a delete
    # was capped. Nothing is lost: the next run decides again.
    HELD = "held"
    CONFLICT = "conflict"


@dataclass(frozen=True)
class Profile:
    name: str
    vendor: Vendor
    root: Path
    # Whether the agent deletes old files here on its own schedule.
    sweeps: bool = False
    # OPENCODE_CONFIG_DIR, for the vendor whose sessions live in sqlite.
    config: Path | None = None

    @property
    def relative_root(self) -> Path:
        return self.root.relative_to(Path.home())

    @property
    def slug(self) -> str:
        return self.name.replace("/", "-")


@dataclass(frozen=True)
class Entry:
    size: int
    # Whole seconds: sftp carries no finer, so a fraction only the local side
    # holds would make every pair look different.
    mtime: int


@dataclass
class Step:
    path: str
    action: Action
    merge: Merge
    note: str = ""
    payload: str | None = None
    # Drops the mass-delete gate and `--max-delete` ignore: an expiry is
    # capped by `--max-expire`, a codex compression or archive move not at all.
    expiry: bool = False
    renamed: bool = False


@dataclass
class Base:
    """Each side's entry when both were last seen to agree, per path.

    A side's entry is None when that side deliberately lacks the path — a
    retained deletion. Pairs are kept per side because a pair can be the
    same file with different mtimes (settled by hash or by content).
    """

    VERSION: ClassVar[int] = 1

    file: Path
    local_id: str | None = None
    remote_id: str | None = None
    cleanup_days: int | None = None
    paths: dict[str, tuple[Entry | None, Entry | None]] = field(default_factory=dict)
    unclaimed: set[str] = field(default_factory=set)

    @classmethod
    def load(cls, file: Path) -> Base:
        if not file.is_file():
            return cls(file)
        data = json.loads(file.read_text())
        if data.get("version") != cls.VERSION:
            raise click.ClickException(f"{file}: unknown base version")

        def entry(raw: list[int] | None) -> Entry | None:
            return Entry(*raw) if raw is not None else None

        return cls(
            file,
            data["local_id"],
            data["remote_id"],
            data.get("cleanup_days"),
            {
                p: (entry(local), entry(remote))
                for p, (local, remote) in data["paths"].items()
            },
            set(data.get("unclaimed", [])),
        )

    def save(self) -> None:
        def raw(entry: Entry | None) -> list[int] | None:
            return [entry.size, entry.mtime] if entry is not None else None

        self.file.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.file.with_name(f".{self.file.name}.tmp")
        temporary.write_text(
            json.dumps(
                {
                    "version": self.VERSION,
                    "local_id": self.local_id,
                    "remote_id": self.remote_id,
                    "cleanup_days": self.cleanup_days,
                    "paths": {
                        p: [raw(local), raw(remote)]
                        for p, (local, remote) in sorted(self.paths.items())
                    },
                    "unclaimed": sorted(self.unclaimed),
                }
            )
        )
        temporary.replace(self.file)


@dataclass
class Ledger:
    """Per opencode session, the database's `time.updated` and the export's
    size and mtime when the two last agreed.

    Whichever moved since is the side that changed, which is what tells a
    revert from a copy that merely runs shorter. Keyed to the database
    file's inode, so a recreated database starts over rather than reading
    as every session deleted.
    """

    VERSION: ClassVar[int] = 1
    # In place of `time.updated` while a replace is under way: the export is
    # the copy to keep, whether or not the database row is still there.
    REPLACING: ClassVar[int] = -1

    file: Path
    database: int | None = None
    sessions: dict[str, tuple[int, Entry]] = field(default_factory=dict)

    @classmethod
    def load(cls, file: Path, database: int) -> Ledger:
        if not file.is_file():
            return cls(file, database)
        try:
            data = json.loads(file.read_text())
            if data.get("version") != cls.VERSION:
                raise ValueError("unknown version")
            if data["database"] != database:
                return cls(file, database)
            sessions = {
                i: (int(updated), Entry(*raw))
                for i, (updated, raw) in data["sessions"].items()
            }
        except (ValueError, KeyError, TypeError) as error:
            # Not started over: with no ledger the longer message-id list
            # wins, which undoes a revert whose replace is still pending.
            raise click.ClickException(
                f"ledger {file} unreadable ({error}); inspect it, or move it"
                " aside to bootstrap again, accepting that a revert whose"
                " replace is still pending can be undone"
            ) from error

        return cls(file, database, sessions)

    def save(self) -> None:
        self.file.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.file.with_name(f".{self.file.name}.tmp")
        temporary.write_text(
            json.dumps(
                {
                    "version": self.VERSION,
                    "database": self.database,
                    "sessions": {
                        i: [updated, [entry.size, entry.mtime]]
                        for i, (updated, entry) in sorted(self.sessions.items())
                    },
                }
            )
        )
        temporary.replace(self.file)


class Opencode:
    """A profile's sqlite store, behind one private `opencode serve --stdio`.

    Started the way opencode's own `--standalone` starts it
    (`cli/src/services/standalone.ts`): a password in the environment, the
    URL on the first stdout line, and stdin held open as the lease, whose
    EOF ends the server. One server per profile, not one per call.
    """

    TIMEOUT: ClassVar[float] = 120.0
    PAGE: ClassVar[int] = 500

    def __init__(self, profile: Profile, log: logging.Logger) -> None:
        self.profile = profile
        self.log = log
        self.password = secrets.token_urlsafe(32)
        self.url = ""
        self.proc: subprocess.Popen[str] | None = None

    @property
    def database(self) -> Path:
        return self.profile.root / "opencode.db"

    def __enter__(self) -> Self:
        assert self.profile.config is not None
        cmd = ["opencode", "serve", "--stdio", "--port", "0"]
        self.log.info("spawn: %s", " ".join(cmd))
        self.proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            # As standalone.ts does: its logs only go to stderr with
            # OPENCODE_PRINT_LOGS, and nothing else is written there.
            stderr=subprocess.DEVNULL,
            env={
                **os.environ,
                "OPENCODE_PASSWORD": self.password,
                "OPENCODE_CONFIG_DIR": str(self.profile.config),
                "OPENCODE_DB": str(self.database),
            },
            cwd=self.profile.root,
            text=True,
            start_new_session=True,
        )
        assert self.proc.stdout is not None
        # A blocked readline cannot time out, so the deadline kills the
        # group and the read then sees EOF.
        timer = threading.Timer(self.TIMEOUT, self.kill)
        timer.start()
        try:
            line = self.proc.stdout.readline()
        finally:
            timer.cancel()
        try:
            self.url = json.loads(line)["url"]
        except (ValueError, KeyError, TypeError) as error:
            self.close()
            raise click.ClickException(f"opencode serve not ready: {line!r}") from error
        # Drained so a later write by the server never fills the pipe.
        threading.Thread(target=self.proc.stdout.read, daemon=True).start()

        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    def kill(self) -> None:
        assert self.proc is not None
        with contextlib.suppress(ProcessLookupError):
            os.killpg(self.proc.pid, signal.SIGKILL)

    def close(self) -> None:
        assert self.proc is not None and self.proc.stdin is not None
        with contextlib.suppress(BrokenPipeError):
            self.proc.stdin.close()
        try:
            self.proc.wait(timeout=10.0)
        except subprocess.TimeoutExpired:
            self.kill()
            self.proc.wait()

    def request(
        self, method: str, path: str, body: object = None
    ) -> tuple[int, object]:
        # Path only: bodies are whole transcripts.
        self.log.debug("opencode: %s %s", method, path)
        credentials = base64.b64encode(f"opencode:{self.password}".encode()).decode()
        request = urllib.request.Request(
            self.url + path,
            method=method,
            data=None if body is None else json.dumps(body).encode(),
            headers={
                "authorization": f"Basic {credentials}",
                "content-type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(request, timeout=self.TIMEOUT) as response:
                status, raw = response.status, response.read()
        except urllib.error.HTTPError as error:
            status, raw = error.code, error.read()

        return status, json.loads(raw) if raw else None

    def get(self, path: str) -> dict:
        status, data = self.request("GET", path)
        if status != 200 or not isinstance(data, dict):
            raise click.ClickException(f"GET {path}: HTTP {status}")

        return data

    def migrating(self) -> str | None:
        """The V1 history migration's state, or None once it is done.

        Every server start resumes it in the background, so until it
        completes a listing is partial and an import can take an id the
        migration has yet to write.
        """
        status = self.get("/api/experimental/migration/v1")
        if status["status"] == "completed":
            return None
        progress = status.get("progress") or {}
        if "denominator" in progress:
            return f"at {progress['numerator']}/{progress['denominator']}"

        return f"{status['status']}: {status.get('error', '')}".rstrip(": ")

    def sessions(self) -> dict[str, dict]:
        """Every session, children included, across every project.

        `opencode session list` is scoped to the cwd's project and lists
        roots only; the route with neither filter lists all.
        """
        found: dict[str, dict] = {}
        query = {"limit": str(self.PAGE), "order": "asc"}
        while True:
            page = self.get(f"/api/session?{urlencode(query)}")
            found |= {s["id"]: s for s in page["data"]}
            if len(page["data"]) < self.PAGE:
                return found
            query = {"limit": str(self.PAGE), "cursor": page["cursor"]["next"]}

    def info(self, session: str) -> dict | None:
        status, data = self.request("GET", f"/api/session/{session}")
        if status == 404:
            return None
        if status != 200 or not isinstance(data, dict):
            raise click.ClickException(f"session {session}: HTTP {status}")

        return data["data"]

    def export(self, session: str) -> dict:
        # Unsanitised: sanitize redacts every text, tool input and output
        # and the directory, leaving nothing worth carrying.
        return self.get(f"/api/experimental/session/{session}/export")["data"]

    def directory(self, directory: str) -> str | None:
        """The directory as opencode resolves it, or None when it is not here."""
        status, data = self.request(
            "GET", f"/api/location?{urlencode({'location[directory]': directory})}"
        )
        if status != 200 or not isinstance(data, dict):
            return None

        return data["directory"]

    def load(self, data: dict, directory: str) -> int:
        """Import an export, keeping its ids; returns the HTTP status.

        An id already present is a 409 rather than a merge, so a session
        that changed elsewhere has to be deleted here first.
        """
        status, _ = self.request(
            "POST",
            "/api/experimental/session/import",
            {**data, "location": {"directory": directory}},
        )

        return status

    def delete(self, session: str) -> None:
        """Delete a session; opencode takes its child sessions with it."""
        status, _ = self.request("DELETE", f"/api/session/{session}")
        if status not in (200, 204):
            raise click.ClickException(f"delete {session}: HTTP {status}")


@dataclass
class Report:
    profile: Profile
    steps: list[Step] = field(default_factory=list)
    skipped: str | None = None
    # Why the mass-delete gate refused the profile, or a delete cap fired.
    refused: str | None = None
    capped: bool = False
    # Both sides as the plan saw them, so a write can tell whether the copy
    # it is about to overwrite is still the one it decided about.
    local: dict[str, Entry] = field(default_factory=dict)
    remote: dict[str, Entry] = field(default_factory=dict)
    base: Base | None = None
    # Markers to create on apply, for a side that had none.
    new_ids: dict[str, str] = field(default_factory=dict)
    # Local paths, files or whole directories, that exist but could not be
    # listed as regular files: a symlink, a dir where a file was, an
    # unreadable subtree. Absent from the listing, yet not deleted.
    unknown: set[str] = field(default_factory=set)
    # opencode sessions changed both in the database and in the export,
    # whose export body was parked beside the original.
    parked: list[str] = field(default_factory=list)

    def obscured(self, path: str) -> bool:
        return any(path == u or path.startswith(f"{u}/") for u in self.unknown)

    def hold(self, path: str, note: str) -> None:
        for step in self.steps:
            if step.path == path:
                step.action = Action.HELD
                step.note = note

    def count(self, *actions: Action) -> int:
        return sum(1 for s in self.steps if s.action in actions)


class Transport(Protocol):
    """Where the other copy of the state lives."""

    @property
    def name(self) -> str: ...

    @property
    def key(self) -> str:
        """Stable name for this far side, keying its receipts."""

    @property
    def sweeps(self) -> bool:
        """Whether an agent runs on the far side and expires files there."""

    def check(self) -> None: ...

    def remote(self, profile: Profile) -> str: ...

    def flags(self) -> list[str]: ...

    def shell(self, script: str) -> list[str] | None:
        """Argv running `script` on the far side, or None where nothing runs."""


@dataclass(frozen=True)
class Peer:
    """A machine reached over ssh."""

    host: str
    user: str | None = None

    CONTROL: ClassVar[Path] = (
        Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "synco-ssh-%C"
    )

    @property
    def name(self) -> str:
        return self.host

    @cached_property
    def key(self) -> str:
        # Resolved through ssh's own config, so `host`, `user@host` and an
        # alias for the same machine share one set of receipts.
        argv = ["ssh", "-G", *(["-l", self.user] if self.user else []), self.host]
        resolved = dict(
            line.split(" ", 1)
            for line in subprocess.run(
                argv, capture_output=True, text=True, timeout=30.0, check=True
            ).stdout.splitlines()
            if " " in line
        )

        return f"peer-{resolved['user']}@{resolved['hostname']}:{resolved['port']}"

    @property
    def sweeps(self) -> bool:
        return True

    @property
    def command(self) -> str:
        # rclone runs one md5sum per remote file and --sftp-ssh cannot
        # multiplex, so without a shared control socket every hash pays a
        # fresh TCP connect and key exchange.
        target = f"{self.user}@{self.host}" if self.user else self.host

        return (
            "ssh -o BatchMode=yes"
            " -o ControlMaster=auto"
            f" -o ControlPath={self.CONTROL}"
            " -o ControlPersist=60s"
            f" {target}"
        )

    def check(self) -> None:
        return None

    def remote(self, profile: Profile) -> str:
        return f":sftp:{profile.relative_root}"

    def flags(self) -> list[str]:
        # rclone's own sftp client reads none of ~/.ssh/config, so a peer's
        # port, user, key or ProxyJump would have to be restated as flags.
        # Delegating to the ssh binary keeps that config the one source.
        return [
            "--sftp-skip-links",
            "--sftp-ssh",
            self.command,
            # ssh is the one connecting, so it is the one checking host keys
            # against known_hosts — a mismatch is refused there. This only
            # quiets rclone warning about the client it is not using.
            "--sftp-known-hosts-file",
            "none",
            # Answers rclone would otherwise probe the peer for and then
            # complain it cannot cache, having no config file to cache into.
            "--sftp-shell-type",
            "unix",
            "--sftp-md5sum-command",
            "md5sum",
            "--sftp-sha1sum-command",
            "sha1sum",
        ]

    def shell(self, script: str) -> list[str]:
        return [*self.command.split(), script]


@dataclass(frozen=True)
class Archive:
    """A directory on a mounted share, holding what every machine sent it."""

    base: Path

    @property
    def name(self) -> str:
        return "archive"

    @property
    def key(self) -> str:
        return "archive-" + str(self.base).strip("/").replace("/", "-")

    @property
    def sweeps(self) -> bool:
        return False

    def check(self) -> None:
        # Reading the path is also what fires the automount. An unmounted
        # mount point is an empty directory that plans as a far side holding
        # nothing, and the push that follows lands underneath it, where the
        # next mount hides it for good.
        mounted = any(
            parent.is_mount()
            for parent in (self.base, *self.base.parents)
            if parent != Path("/")
        )
        if not mounted:
            raise click.ClickException(f"{self.base} is not on a mounted share")

    def remote(self, profile: Profile) -> str:
        return str(self.base / profile.relative_root)

    def flags(self) -> list[str]:
        return []

    def shell(self, script: str) -> None:
        return None


class Synco:
    @click.group(context_settings={"help_option_names": ["-h", "--help"]})
    @click.option("-v", "--verbose", is_flag=True, help="Show subprocess traces.")
    def cli(verbose: bool) -> None:
        create_logger(verbose, name="synco")

    console: ClassVar[Console] = Console(force_terminal=None)
    log = logging.getLogger("synco")

    HOSTNAME_PATH = Path("/proc/sys/kernel/hostname")
    STATE_DIR = (
        Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "synco"
    )
    STAMP = "%Y%m%d-%H%M%S"
    # The pid keeps two runs started in the same second, a dry run beside a
    # real one included, out of each other's backup tree.
    STAMP_PATTERN = re.compile(r"\d{8}-\d{6}(-\d+)?")
    BACKUP_DAYS = 14
    DRY_RUN_BANNER = (
        "[bold magenta]DRY RUN — planned actions only, nothing is written[/]"
    )
    RCLONE_TIMEOUT = 900.0
    ARCHIVE = Path("/mnt/norsu/rock/backup/synco/agents")
    # All the sftp backend probes for on its own. Anything else has to name
    # its remote command too (--sftp-hashes sha256 --sftp-sha256sum-command
    # sha256sum); asking without that silently drops the hash from hashsum
    # and sends every doubtful file through a body fetch instead. A hash only
    # decides whether two copies are identical — the byte comparison is what
    # rules on which one to keep.
    HASH = "md5"
    MARKER = ".synco-id"
    # rclone's exit codes for a directory and for a file that is not there.
    # Anything else reading a marker is an error, never "missing": minting a
    # new id on a transient failure would reset every paired machine's base.
    NOT_FOUND = (3, 4)

    # Claude's sweep deletes a file as soon as its age passes the cutoff on
    # its own clock, at most once a day. One day of slack on each band edge
    # absorbs clock skew between machines, and each edge leans the safe way.
    EXPIRY_SLACK = 86400
    # Below this the setting is taken for a mistake rather than a policy: a
    # cutoff of a day or two would band nearly everything as expired.
    MIN_CLEANUP_DAYS = 7
    # Claude's own default when settings.json does not set one.
    DEFAULT_CLEANUP_DAYS = 30
    SESSION_ID = re.compile(
        r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    )
    OPENCODE_ID = re.compile(r"ses_[0-9A-Za-z]+")
    REINDEX_TIMEOUT = 300.0
    # Every `ThreadSourceKind` in app-server's schema, subagents included.
    CODEX_SOURCES = (
        "cli",
        "vscode",
        "exec",
        "appServer",
        "subAgent",
        "subAgentReview",
        "subAgentCompact",
        "subAgentThreadSpawn",
        "subAgentOther",
        "unknown",
    )

    # Mass-delete gate: unexplained absences on one side above both of these
    # refuse the profile, as does a whole directory of at least SUBTREE gone.
    GATE_COUNT = 10
    GATE_RATIO = 0.5
    GATE_SUBTREE = 5

    # Mirrors the env patches in ~/.config/hyprpilot/config.yaml, which is the
    # source of truth for which profile writes where. The two share no parser,
    # so a state directory moved there has to be moved here in the same commit.
    # `~/.claude` is no hyprpilot profile: it is where claude writes when run
    # without CLAUDE_CONFIG_DIR, and where skills that name a fixed path for
    # plans put them. Claude never runs there, so nothing there is swept.
    PROFILES: ClassVar[tuple[Profile, ...]] = (
        Profile("default/claude", Vendor.CLAUDE, Path.home() / ".claude"),
        Profile(
            "personal/claude", Vendor.CLAUDE, Path.home() / ".claude-kilic", sweeps=True
        ),
        Profile(
            "work/claude", Vendor.CLAUDE, Path.home() / ".claude-laravel", sweeps=True
        ),
        Profile("personal/codex", Vendor.CODEX, Path.home() / ".codex-kilic"),
        Profile("work/codex", Vendor.CODEX, Path.home() / ".codex-laravel"),
        Profile(
            "personal/kilic",
            Vendor.OPENCODE,
            Path.home() / ".local/share/opencode-kilic",
            config=Path.home() / ".config/opencode-kilic",
        ),
        Profile(
            "work/ollama",
            Vendor.OPENCODE,
            Path.home() / ".local/share/opencode-laravel",
            config=Path.home() / ".config/opencode-laravel",
        ),
    )

    # Only transcripts and memories. Everything absent from this map — caches,
    # shell snapshots, plugins, per-project state — stays machine-local.
    INCLUDES: ClassVar[dict[Vendor, tuple[str, ...]]] = {
        Vendor.CLAUDE: (
            "projects/**",
            "plans/**",
            "history.jsonl",
            # history.jsonl stores a large paste as a hash into this
            # directory, so the history alone recalls an empty prompt.
            "paste-cache/**",
        ),
        Vendor.CODEX: (
            "sessions/**",
            # Archiving a thread moves its rollout here, so without it an
            # archive reads as a deletion.
            "archived_sessions/**",
            "memories/**",
            "history.jsonl",
            "session_index.jsonl",
        ),
        # Not the database, which also holds the credentials: one export per
        # session, written and read back by `reconcile`.
        Vendor.OPENCODE: ("sessions/**",),
    }

    # Credentials are excluded by path rather than by flag, so no invocation
    # can opt into shipping them. The rest is either machine-local or stowed:
    # a stowed file is a symlink into the repo, and writing through one would
    # edit the checkout.
    EXCLUDES: ClassVar[dict[Vendor, tuple[str, ...]]] = {
        Vendor.CLAUDE: (
            ".credentials.json",
            ".claude.json",
            ".claude.json.backup",
            "settings.json",
            "**/.*.synco",
        ),
        Vendor.CODEX: (
            "auth.json",
            "config.toml",
            "rules/**",
            "**/*.sqlite",
            "**/*.sqlite-shm",
            "**/*.sqlite-wal",
            "**/.*.synco",
            # Derived from codex's sqlite and rewritten wholesale on every
            # consolidation, so each machine rebuilds its own; `.git` is the
            # baseline repo that consolidation diffs against.
            "memories/.git/**",
            "memories/raw_memories.md",
            "memories/rollout_summaries/**",
            "memories/phase2_workspace_diff.md",
            # `codex migrate-rollouts` stages its rewrite beside the rollout
            # and renames it into place; its journal sits in
            # `rollout-migrations/`, which no include reaches.
            "sessions/**/.*.tmp",
            "archived_sessions/**/.*.tmp",
        ),
        Vendor.OPENCODE: (
            "opencode.db",
            "opencode.db-*",
            "**/.*.synco",
        ),
    }

    MERGES: ClassVar[dict[Vendor, tuple[tuple[str, Merge], ...]]] = {
        Vendor.CLAUDE: (
            ("history.jsonl", Merge.LINES),
            # Order matters: the index is matched before the catch-all that
            # covers the individual memories beside it.
            ("projects/*/memory/MEMORY.md", Merge.INDEX),
            ("projects/*/memory/**", Merge.NEWER),
            # Session metadata such as `custom-title.json`, rewritten in place.
            ("projects/**/*.json", Merge.NEWER),
            ("plans/**", Merge.NEWER),
        ),
        Vendor.CODEX: (
            ("history.jsonl", Merge.LINES),
            ("session_index.jsonl", Merge.LINES),
            ("memories/MEMORY.md", Merge.INDEX),
            ("memories/**", Merge.NEWER),
            # Two machines compressing one rollout need not produce the same
            # bytes; either decompresses to the same session.
            ("sessions/**/*.zst", Merge.NEWER),
            ("archived_sessions/**/*.zst", Merge.NEWER),
        ),
        Vendor.OPENCODE: (("sessions/*.json", Merge.SESSION),),
    }

    # First match wins; anything unlisted is RETAIN, so a kind nobody thought
    # about is never deleted on the far side. Session directories are matched
    # before these by `anchor`.
    POLICIES: ClassVar[dict[Vendor, tuple[tuple[str, Policy], ...]]] = {
        Vendor.CLAUDE: (
            ("**/*.conflict-*", Policy.PROPAGATE),
            ("projects/*/memory/proposals/**", Policy.EXPIRES),
            # Never swept: a memory gone is a memory deleted.
            ("projects/*/memory/**", Policy.PROPAGATE),
            ("projects/**", Policy.EXPIRES),
            ("plans/**", Policy.EXPIRES),
            ("paste-cache/**", Policy.EXPIRES),
        ),
        Vendor.CODEX: (
            ("**/*.conflict-*", Policy.PROPAGATE),
            # codex deletes and archives rollouts only when asked, and its
            # `.jsonl` to `.jsonl.zst` compression is a delete plus a create.
            ("sessions/**", Policy.PROPAGATE),
            ("archived_sessions/**", Policy.PROPAGATE),
            ("memories/**", Policy.PROPAGATE),
        ),
        Vendor.OPENCODE: (
            ("**/*.conflict-*", Policy.PROPAGATE),
            # opencode sweeps nothing, but an absence still never reaches a
            # database: a session deleted here stays wherever else it is.
            ("sessions/**", Policy.RETAIN),
        ),
    }

    ACTION_STYLES: ClassVar[dict[Action, str]] = {
        Action.SAME: "dim",
        Action.PULL: "cyan",
        Action.PUSH: "green",
        Action.MERGE: "yellow",
        Action.DROP_LOCAL: "red",
        Action.DROP_REMOTE: "red",
        Action.KEEP: "blue",
        Action.UNCLAIMED: "magenta",
        Action.SKIP: "dim",
        Action.HELD: "magenta",
        Action.CONFLICT: "red",
    }

    @classmethod
    def select(cls, names: tuple[str, ...], vendors: tuple[str, ...]) -> list[Profile]:
        selected = [
            p
            for p in cls.PROFILES
            if (not names or p.name in names) and (not vendors or p.vendor in vendors)
        ]
        if not selected:
            raise click.ClickException("no profile matched")

        return selected

    def __init__(
        self,
        transport: Transport,
        dry_run: bool,
        checksum: bool,
        adopt: bool = False,
        no_deletes: bool = False,
        force_deletes: bool = False,
        max_delete: int = 25,
        max_expire: int = 200,
    ) -> None:
        self.transport = transport
        self.dry_run = dry_run
        self.checksum = checksum
        self.adopt = adopt
        self.no_deletes = no_deletes
        self.force_deletes = force_deletes
        self.max_delete = max_delete
        self.max_expire = max_expire
        self.stamp = f"{time.strftime(self.STAMP)}-{os.getpid()}"
        self.backup_root = self.STATE_DIR / self.stamp
        self.manifest: list[dict[str, object]] = []
        self.now = time.time()
        # Set by `check_clock`; False drops every profile to the non-sweeping
        # view, where nothing is banded and every absence counts.
        self.bands = True

    @property
    def hostname(self) -> str:
        return self.HOSTNAME_PATH.read_text().strip()

    def filters(self, profile: Profile) -> list[str]:
        """rclone-side filters matching `wanted`.

        Without these the listing walks and hashes the whole state directory
        — caches, plugins, file history — to have most of it dropped here
        afterwards. rclone anchors a pattern at the root with a leading
        slash, which is what `full_match` does. `--filter` rules apply in the
        order given, which separate `--include` and `--exclude` flags do not
        promise; the closing `- **` is what `--include` would add implicitly.
        """
        args: list[str] = []
        for pattern in self.EXCLUDES[profile.vendor]:
            args += ["--filter", f"- /{pattern}"]
        for pattern in self.INCLUDES[profile.vendor]:
            args += ["--filter", f"+ /{pattern}"]

        return [*args, "--filter", "- **"]

    def merge_kind(self, profile: Profile, path: str) -> Merge:
        for pattern, kind in self.MERGES[profile.vendor]:
            if Path(path).full_match(pattern):
                return kind

        return Merge.APPEND

    def anchor(self, profile: Profile, path: str) -> str | None:
        """The transcript a session-directory path lives and dies with.

        Claude's sweep removes `<sid>/` whole together with `<sid>.jsonl`,
        whatever the ages inside, so its files take the transcript's age and
        count as one session in the gate and the caps.
        """
        parts = path.split("/")
        if (
            profile.vendor is Vendor.CLAUDE
            and len(parts) >= 4
            and parts[0] == "projects"
            and self.SESSION_ID.fullmatch(parts[2])
        ):
            return f"projects/{parts[1]}/{parts[2]}.jsonl"

        return None

    def policy(self, profile: Profile, path: str) -> Policy:
        if self.anchor(profile, path) is not None:
            return Policy.EXPIRES
        for pattern, policy in self.POLICIES[profile.vendor]:
            if Path(path).full_match(pattern):
                return policy

        return Policy.RETAIN

    def wanted(self, profile: Profile, path: str) -> bool:
        target = Path(path)
        if any(target.full_match(p) for p in self.EXCLUDES[profile.vendor]):
            return False

        return any(target.full_match(p) for p in self.INCLUDES[profile.vendor])

    def cleanup_days(self, profile: Profile) -> int | None:
        """The profile's sweep cutoff in days, or None when it does not sweep."""
        if not profile.sweeps:
            return None
        try:
            settings = json.loads((profile.root / "settings.json").read_text())
        except FileNotFoundError:
            settings = {}
        except json.JSONDecodeError as error:
            self.log.warning("%s: settings.json unreadable (%s)", profile.name, error)
            settings = {}
        days = (
            settings.get("cleanupPeriodDays", self.DEFAULT_CLEANUP_DAYS)
            if isinstance(settings, dict)
            else self.DEFAULT_CLEANUP_DAYS
        )
        if not isinstance(days, int) or days < self.MIN_CLEANUP_DAYS:
            self.log.warning(
                "%s: cleanupPeriodDays %r is below %d, not banding",
                profile.name,
                days,
                self.MIN_CLEANUP_DAYS,
            )
            return None

        return days

    def rclone_command(self, *args: str) -> list[str]:
        return ["rclone", "--skip-links", *self.transport.flags(), *args]

    def transfer(self, *args: str) -> None:
        """Run a copy with rclone's own progress display.

        Its output is left uncaptured so the meter can redraw, and aimed at
        stderr because stdout here carries the plan tables. rclone falls back
        to plain log lines by itself when that is not a terminal.
        """
        cmd = self.rclone_command("--progress", "--stats", "1s", *args)
        self.log.info("spawn: %s", " ".join(cmd))
        # Its own process group, as `dotlib.cli.run` does, so a timeout or an
        # interrupt also takes down the ssh sessions rclone forked.
        proc = subprocess.Popen(
            cmd,
            stdout=sys.stderr,
            stderr=sys.stderr,
            start_new_session=True,
        )
        try:
            returncode = proc.wait(timeout=self.RCLONE_TIMEOUT)
        except BaseException:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
            raise
        if returncode != 0:
            raise subprocess.CalledProcessError(returncode, cmd)

    def rclone(self, *args: str, input: str | None = None) -> str:
        cmd = self.rclone_command(*args)
        result = run(
            cmd, log=self.log, timeout=self.RCLONE_TIMEOUT, check=True, input=input
        )

        return result.stdout

    def write_list(self, name: str, paths: list[str]) -> Path:
        # rclone resolves each line against the remote root and would follow
        # `..` out of it; every path here comes from a listing, so one that
        # is not plainly relative is a bug, not input to tolerate.
        for path in paths:
            if path.startswith("/") or ".." in path.split("/"):
                raise ValueError(f"refusing list entry {path!r}")
        # Under the state dir, never beside a transfer's target: apply fetches
        # straight into the profile root, which would drop the list in $HOME.
        listing = self.backup_root / "lists" / name
        listing.parent.mkdir(parents=True, exist_ok=True)
        listing.write_text("".join(f"{p}\n" for p in paths))

        return listing

    def scan_local(
        self, profile: Profile, unknown: set[str] | None = None
    ) -> dict[str, Entry]:
        """Wanted files, walking only the literal head of each include.

        The caches, plugins and file history beside the includes are never
        listed, so their size costs nothing here. Whatever exists but is not
        a regular file — a symlink, a directory os.walk will not enter, one
        it cannot read — lands in `unknown`, so it is held rather than read
        as deleted.
        """
        entries: dict[str, Entry] = {}

        def note(path: Path) -> None:
            relative = str(path.relative_to(profile.root))
            if unknown is not None and self.wanted(profile, f"{relative}/x"):
                unknown.add(relative)

        for pattern in self.INCLUDES[profile.vendor]:
            top = profile.root.joinpath(
                *takewhile(
                    lambda part: not any(c in part for c in "*?["),
                    Path(pattern).parts,
                )
            )
            found: list[Path] = []
            if top.is_dir():
                for d, dirs, names in os.walk(
                    top, onerror=lambda error: note(Path(error.filename))
                ):
                    found += (Path(d, n) for n in names)
                    found += (Path(d, n) for n in dirs if Path(d, n).is_symlink())
            else:
                found.append(top)
            for path in found:
                try:
                    info = path.lstat()
                except FileNotFoundError:
                    continue
                relative = str(path.relative_to(profile.root))
                if not stat.S_ISREG(info.st_mode):
                    if unknown is not None and (
                        self.wanted(profile, relative)
                        or self.wanted(profile, f"{relative}/x")
                    ):
                        unknown.add(relative)
                    continue
                if self.wanted(profile, relative):
                    entries[relative] = Entry(info.st_size, int(info.st_mtime))

        return entries

    def scan_remote(
        self, profile: Profile, paths: list[str] | None = None
    ) -> dict[str, Entry]:
        """Size and mtime of the far side, all of it or just `paths`.

        No hashes: asking lsjson for one runs md5sum over every file, which
        reads the whole tree on each run. `remote_digests` hashes the few
        paths the listing cannot settle.
        """
        selection = (
            self.filters(profile)
            if paths is None
            else [
                "--files-from",
                str(self.write_list(f"recheck-{profile.slug}.txt", paths)),
            ]
        )
        try:
            listing = self.rclone(
                "lsjson",
                "-R",
                *selection,
                self.transport.remote(profile),
            )
        except subprocess.CalledProcessError as error:
            # rclone exits 3 for a directory that is not there, which is a
            # profile the archive has never been sent. The sftp backend
            # answers that case with an empty listing instead, and a copy
            # creates the directory either way.
            if error.returncode != 3:
                raise
            listing = ""
        entries: dict[str, Entry] = {}
        for item in json.loads(listing or "[]"):
            if item["IsDir"]:
                continue
            path = item["Path"]
            if not self.wanted(profile, path):
                continue
            entries[path] = Entry(
                item["Size"],
                int(datetime.fromisoformat(item["ModTime"]).timestamp()),
            )

        return entries

    def remote_digests(self, profile: Profile, paths: list[str]) -> dict[str, str]:
        if not paths:
            return {}
        listing = self.write_list(f"hash-{profile.slug}.txt", paths)
        output = self.rclone(
            "hashsum",
            self.HASH,
            "--files-from",
            str(listing),
            self.transport.remote(profile),
        )

        return {
            path: digest
            for digest, _, path in (
                line.partition("  ") for line in output.splitlines()
            )
        }

    @classmethod
    def digest(cls, path: Path) -> str:
        with path.open("rb") as handle:
            return hashlib.file_digest(handle, cls.HASH).hexdigest()

    def fetch(self, profile: Profile, paths: list[str], into: Path) -> None:
        """Copy `paths` off the peer into a staging tree."""
        if not paths:
            return
        listing = self.write_list(f"fetch-{profile.slug}.txt", paths)
        self.transfer(
            "copy",
            "--files-from",
            str(listing),
            self.transport.remote(profile),
            str(into),
        )

    def send(self, profile: Profile, paths: list[str], source: Path) -> None:
        if not paths:
            return
        listing = self.write_list(f"send-{profile.slug}.txt", paths)
        self.transfer(
            "copy",
            "--files-from",
            str(listing),
            str(source),
            self.transport.remote(profile),
        )

    def read_id(self, profile: Profile) -> str | None:
        """The far side's marker, or None only when it is genuinely absent."""
        try:
            return (
                self.rclone(
                    "cat", f"{self.transport.remote(profile)}/{self.MARKER}"
                ).strip()
                or None
            )
        except subprocess.CalledProcessError as error:
            if error.returncode in self.NOT_FOUND:
                return None
            raise

    def write_id(self, profile: Profile, value: str) -> str:
        """Write the far side's marker, returning whatever it holds afterwards.

        Two machines bootstrapping one archive at once both write; the one
        read back is the one that stuck, and the loser re-bootstraps once.
        """
        self.rclone(
            "rcat", f"{self.transport.remote(profile)}/{self.MARKER}", input=value
        )
        written = self.read_id(profile)
        if written is None:
            raise click.ClickException(f"{profile.name}: far marker did not stick")

        return written

    def check_clock(self) -> None:
        """Refuse a clock running ahead of the far side; distrust an unknown one.

        Every band is measured on this clock, and a fast one makes every file
        look expired — the one failure the delete caps cannot tell from a
        week without syncing. A slow clock only bands fewer files.
        """
        command = self.transport.shell("date +%s")
        if command is not None:
            result = run(command, log=self.log, timeout=30.0)
            if result.returncode == 0:
                ahead = self.now - float(result.stdout.strip())
                if ahead > self.EXPIRY_SLACK:
                    raise click.ClickException(
                        f"local clock is {ahead / 3600:.1f}h ahead of {self.transport.name}"
                    )
                return
        # The archive is a CIFS mount whose server-side timestamps are not
        # confirmed, so the only evidence left is this machine's own sync.
        result = run(
            ["timedatectl", "show", "-p", "NTPSynchronized", "--value"],
            log=self.log,
            timeout=30.0,
        )
        if result.stdout.strip() != "yes":
            self.log.warning("clock not NTP-synchronised; sweeping profiles refused")
            self.bands = False

    @staticmethod
    def is_prefix(shorter: bytes, longer: bytes) -> bool:
        return longer.startswith(shorter)

    @staticmethod
    def transcript(body: str) -> tuple[str, ...] | None:
        """An opencode export's message ids in order, or None if unreadable."""
        try:
            return tuple(m["id"] for m in json.loads(body)["messages"])
        except ValueError, KeyError, TypeError:
            return None

    @staticmethod
    def extends(longer: tuple[str, ...], shorter: tuple[str, ...]) -> bool:
        return len(longer) > len(shorter) and longer[: len(shorter)] == shorter

    @staticmethod
    def merge_lines(local: str, remote: str) -> str:
        """Both sides' lines, in an order consistent with both.

        A two-way diff rather than a set union: a log is an ordered record,
        and deduping it would reorder the lines that repeat and drop the
        entries that genuinely happened twice. Every line of both sides
        survives, so merging a file with itself returns it byte-identical.

        Split on newlines alone. `splitlines` also breaks on U+2028, U+2029
        and U+0085, which JSON does not escape, so a pasted line separator
        inside a record would split that record into two invalid ones.
        """
        ours = local.split("\n")
        theirs = remote.split("\n")
        merged: list[str] = []
        matcher = SequenceMatcher(None, ours, theirs, autojunk=False)
        for tag, i1, i2, j1, j2 in matcher.get_opcodes():
            merged.extend(ours[i1:i2])
            if tag != "equal":
                merged.extend(theirs[j1:j2])

        return "\n".join(merged)

    @staticmethod
    def merge_index(local: str, remote: str, prefer_remote: bool) -> str:
        """Union of memory-index bullets, keyed on the file each one links to.

        Two lines pointing at the same memory would read as two memories, so
        the target is the identity and the newer side wins the wording. The
        memory itself travels as its own file, so nothing is lost either way.

        Built on the line merge, so a line that links to nothing — a blank,
        a heading — is carried through rather than keyed on its own text,
        which would collapse every blank line in the file into one.
        """

        def target(line: str) -> str:
            return line.partition("](")[2].partition(")")[0]

        winner = {
            key: line
            for line in (remote if prefer_remote else local).split("\n")
            if (key := target(line))
        }
        merged: list[str] = []
        seen: set[str] = set()
        for line in Synco.merge_lines(local, remote).split("\n"):
            key = target(line)
            if not key:
                merged.append(line)
            elif key not in seen:
                seen.add(key)
                merged.append(winner.get(key, line))

        return "\n".join(merged)

    def identify(self, profile: Profile, report: Report) -> Base:
        """Load the receipts for this pairing, or start over when a side changed.

        Each side carries a marker. A side whose marker is missing or no
        longer the recorded one was wiped, reinstalled or recreated, and its
        empty tree would read as every file deleted; starting from no base
        turns that into copying back instead.
        """
        base = Base.load(
            self.STATE_DIR / "base" / self.transport.key / f"{profile.slug}.json"
        )
        marker = profile.root / self.MARKER
        local_id = (marker.read_text().strip() or None) if marker.is_file() else None
        remote_id = self.read_id(profile)
        if base.paths and (
            local_id is None
            or remote_id is None
            or (local_id, remote_id) != (base.local_id, base.remote_id)
        ):
            self.log.warning("%s: a side's marker changed, starting over", profile.name)
            base = Base(base.file)
        if local_id is None:
            report.new_ids["local"] = local_id = str(uuid.uuid4())
        if remote_id is None:
            report.new_ids["remote"] = remote_id = str(uuid.uuid4())
        base.local_id, base.remote_id = local_id, remote_id

        return base

    def band(
        self,
        profile: Profile,
        path: str,
        days: int | None,
        local: dict[str, Entry],
        remote: dict[str, Entry],
        base: Base,
    ) -> Band:
        """Age band of an EXPIRES path, from the newest mtime any side knows.

        The newest, so a session resumed anywhere reads young again. A
        session-directory file takes its transcript's, unless the transcript
        is unknown everywhere, when it falls back to its own — the age
        Claude's sweep itself uses for orphaned sidecars.
        """
        if days is None or self.policy(profile, path) is not Policy.EXPIRES:
            return Band.YOUNG

        def mtimes(target: str) -> list[int]:
            pair = base.paths.get(target, (None, None))
            return [
                e.mtime
                for e in (local.get(target), remote.get(target), *pair)
                if e is not None
            ]

        anchor = self.anchor(profile, path)
        known = (mtimes(anchor) if anchor is not None else []) or mtimes(path)
        if not known:
            return Band.YOUNG
        age = self.now - max(known)
        cutoff = days * 86400
        if age > cutoff + self.EXPIRY_SLACK:
            return Band.EXPIRED
        if age > cutoff - self.EXPIRY_SLACK:
            return Band.EXPIRING

        return Band.YOUNG

    def renamed(self, profile: Profile, path: str, side: dict[str, Entry]) -> bool:
        """Whether a codex rollout missing from `side` reappears there renamed.

        Compression swaps `x.jsonl` for `x.jsonl.zst` in place; archiving
        moves `sessions/Y/M/D/x` to a flat `archived_sessions/x`, and
        unarchiving moves it back — either possibly compressed on the way.
        """
        if profile.vendor is not Vendor.CODEX:
            return False
        name = path.rsplit("/", 1)[-1]
        names = {name.removesuffix(".zst"), name.removesuffix(".zst") + ".zst"}
        if f"{path}.zst" in side or (
            path.endswith(".zst") and path.removesuffix(".zst") in side
        ):
            return True
        if path.startswith("sessions/"):
            return any(f"archived_sessions/{n}" in side for n in names)
        if path.startswith("archived_sessions/"):
            return any(
                p.startswith("sessions/") and p.rsplit("/", 1)[-1] in names
                for p in side
            )

        return False

    def classify(
        self,
        profile: Profile,
        path: str,
        report: Report,
        days: int | None,
        first: bool,
    ) -> Step | None:
        """Decide a path against its receipt; None hands it to the plain logic.

        The receipt is what tells a deletion from a file the other side has
        never had. An edit on one side always beats a delete on the other.
        """
        base = report.base
        assert base is not None
        local = report.local.get(path)
        remote = report.remote.get(path)
        kind = self.merge_kind(profile, path)
        pair = base.paths.get(path)
        if report.obscured(path):
            return Step(path, Action.HELD, kind, "not a regular file here")
        policy = self.policy(profile, path)
        if policy is Policy.EXPIRES and days is None:
            policy = Policy.PROPAGATE

        band = self.band(profile, path, days, report.local, report.remote, base)
        if band is not Band.YOUNG:
            # An absence on the far side of an expiring path is that side's
            # own sweep, or will be ours shortly: left alone and never
            # counted, so routine expiry elsewhere costs nothing here.
            if local is None and pair is not None:
                return Step(path, Action.DROP_REMOTE, kind, "expired here", expiry=True)
            if local is None and band is Band.EXPIRED and not self.transport.sweeps:
                return Step(path, Action.DROP_REMOTE, kind, "expired", expiry=True)

            return Step(path, Action.SKIP, kind, f"{band}")

        if pair is None:
            if (
                remote is None
                and policy is Policy.PROPAGATE
                and (first or path in base.unclaimed)
            ):
                if self.adopt:
                    return Step(path, Action.PUSH, kind, "adopted")
                return Step(path, Action.UNCLAIMED, kind, "first sync: --adopt")
            return None

        base_local, base_remote = pair
        if local is not None and remote is not None:
            if not self.checksum and (local, remote) == pair:
                return Step(path, Action.SAME, kind)
            return None
        if local is None:
            if base_local is None:
                if remote == base_remote:
                    return Step(path, Action.SAME, kind, "retained here")
                return Step(path, Action.PULL, kind, "changed there")
            if remote != base_remote:
                return Step(path, Action.PULL, kind, "edited there, deleted here")
            if policy is Policy.RETAIN:
                return Step(path, Action.KEEP, kind, "deleted here, kept there")
            return Step(
                path,
                Action.DROP_REMOTE,
                kind,
                "deleted here",
                renamed=self.renamed(profile, path, report.local),
            )
        if base_remote is None:
            if local == base_local:
                return Step(path, Action.SAME, kind, "retained there")
            return Step(path, Action.PUSH, kind, "changed here")
        if local != base_local:
            return Step(path, Action.PUSH, kind, "edited here, deleted there")
        if policy is Policy.RETAIN:
            return Step(path, Action.KEEP, kind, "deleted there, kept here")

        return Step(
            path,
            Action.DROP_LOCAL,
            kind,
            "deleted there",
            renamed=self.renamed(profile, path, report.remote),
        )

    def gate(self, profile: Profile, report: Report) -> None:
        """Refuse a profile whose absences look like damage, then cap drops.

        An absence is unexplained when no age band, codex rename or session
        grouping accounts for it. A wiped root, an empty listing or a broken
        mount all produce many at once, and so does a single wiped directory.
        """
        base = report.base
        assert base is not None
        steps = {s.path: s for s in report.steps}

        def unit(path: str) -> str:
            return self.anchor(profile, path) or path

        for side, entries, index in (
            ("local", report.local, 0),
            ("remote", report.remote, 1),
        ):
            # Gone on both sides is settled, whoever removed it first, so it
            # is in neither the population nor the absences.
            held = {
                unit(p)
                for p, pair in base.paths.items()
                if pair[index] is not None and (p in report.local or p in report.remote)
            }
            missing: set[str] = set()
            for path, pair in base.paths.items():
                step = steps.get(path)
                if pair[index] is None or path in entries:
                    continue
                if path not in report.local and path not in report.remote:
                    continue
                if step is not None and (
                    step.expiry
                    or step.renamed
                    or step.action in (Action.SKIP, Action.HELD)
                ):
                    continue
                missing.add(unit(path))
            reason = None
            if len(missing) > self.GATE_COUNT and len(missing) > self.GATE_RATIO * len(
                held
            ):
                reason = f"{len(missing)} of {len(held)} {side} paths gone"
            elif missing and not entries:
                reason = f"{side} side lists nothing"
            else:
                dirs: dict[str, list[str]] = {}
                for path in held:
                    dirs.setdefault(str(Path(path).parent), []).append(path)
                for directory, members in dirs.items():
                    if len(members) >= self.GATE_SUBTREE and all(
                        m in missing for m in members
                    ):
                        reason = f"{side} {directory}/ gone entirely"
                        break
            if reason is not None and not self.force_deletes:
                report.refused = reason
                return

        drops = [
            s
            for s in report.steps
            if s.action in (Action.DROP_LOCAL, Action.DROP_REMOTE)
        ]
        if self.no_deletes:
            for step in drops:
                report.hold(step.path, "deletes disabled")
            return
        drops = [s for s in drops if not s.renamed]
        for expiry, limit, flag in (
            (False, self.max_delete, "--max-delete"),
            (True, self.max_expire, "--max-expire"),
        ):
            chosen = [s for s in drops if s.expiry is expiry]
            if len({unit(s.path) for s in chosen}) > limit:
                report.capped = True
                for step in chosen:
                    report.hold(step.path, f"over {flag} {limit}")

    def plan(self, report: Report, staging: Path) -> Report:
        profile = report.profile
        if not profile.root.is_dir():
            report.skipped = f"{profile.root} absent"
            return report

        if profile.sweeps and not self.bands:
            # Without a trusted clock no absence can be told from Claude's own
            # sweep, and counting those as deletes caps or refuses anyway.
            report.refused = "clock not NTP-synchronised"
            return report
        try:
            report.base = base = self.identify(profile, report)
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
            report.refused = f"far side unreadable: {error}"
            return report
        days = self.cleanup_days(profile)
        if days is not None and base.cleanup_days not in (None, days):
            self.log.warning(
                "%s: cleanupPeriodDays is %d here but %d when last synced",
                profile.name,
                days,
                base.cleanup_days,
            )
        base.cleanup_days = days
        first = not base.paths

        report.local = local = self.scan_local(profile, report.unknown)
        report.remote = remote = self.scan_remote(profile)

        undecided: list[str] = []
        mergeable: list[str] = []
        doubtful: list[str] = []
        for path in sorted(set(local) | set(remote)):
            if (step := self.classify(profile, path, report, days, first)) is not None:
                report.steps.append(step)
                continue
            kind = self.merge_kind(profile, path)
            if path not in remote:
                report.steps.append(Step(path, Action.PUSH, kind))
            elif path not in local:
                report.steps.append(Step(path, Action.PULL, kind))
            # Every copy rclone makes carries its mtime across, so a synced
            # pair keeps matching on both until one side writes again.
            elif local[path] == remote[path] and not self.checksum:
                report.steps.append(Step(path, Action.SAME, kind))
            elif kind is not Merge.APPEND:
                mergeable.append(path)
            elif local[path].size == remote[path].size:
                doubtful.append(path)
            else:
                undecided.append(path)

        # Before anything is fetched, so a refused profile downloads nothing.
        self.gate(profile, report)
        if report.refused:
            return report

        # A hash settles an equal size without moving the body. A false
        # answer only costs a fetch: every path it rejects is decided on its
        # bytes, so a backend that reports no hash stays correct.
        digests = self.remote_digests(profile, doubtful)
        for path in doubtful:
            if digests.get(path) == self.digest(profile.root / path):
                report.steps.append(Step(path, Action.SAME, Merge.APPEND))
            else:
                undecided.append(path)

        # Bodies are only pulled where the listing could not settle it, so
        # an unchanged tree costs one listing and no transfer. A body about
        # to be dropped there is fetched too: it is the backup.
        dropping = [s.path for s in report.steps if s.action is Action.DROP_REMOTE]
        self.fetch(profile, undecided + mergeable + dropping, staging)
        for path in sorted(undecided):
            report.steps.append(self.decide(profile, path, staging))
        for path in mergeable:
            report.steps.append(self.combine(profile, path, staging, report))

        return report

    def combine(
        self, profile: Profile, path: str, staging: Path, report: Report
    ) -> Step:
        kind = self.merge_kind(profile, path)
        target = profile.root / path
        landed = staging / path
        # Whole seconds on both sides. The peer's mtime arrives truncated,
        # so comparing it against a local one that still carries fractions
        # makes a gap look almost a second smaller than it was.
        drift = int(landed.stat().st_mtime) - int(target.stat().st_mtime)
        peer_is_newer = drift > 0
        if kind is Merge.SESSION:
            ours = self.transcript(target.read_text())
            theirs = self.transcript(landed.read_text())
            if ours is None or theirs is None:
                return Step(path, Action.CONFLICT, kind, "unreadable export")
            # Equal ids with different bytes is one session imported on the
            # other side, which stamps its own time.updated on it.
            if ours == theirs:
                return Step(path, Action.SAME, kind)
            pair = report.base.paths.get(path) if report.base else None
            if pair is not None:
                # The side that changed since both agreed wins even when it
                # is shorter: a revert travels like any other edit.
                here = report.local.get(path) != pair[0]
                there = report.remote.get(path) != pair[1]
                if here and not there:
                    return Step(path, Action.PUSH, kind, "changed here")
                if there and not here:
                    return Step(path, Action.PULL, kind, "changed there")
                return Step(path, Action.CONFLICT, kind, "changed on both")
            if self.extends(theirs, ours):
                return Step(path, Action.PULL, kind, "peer's runs further")
            if self.extends(ours, theirs):
                return Step(path, Action.PUSH, kind, "ours runs further")

            return Step(path, Action.CONFLICT, kind, "resumed on both")
        if kind is Merge.NEWER:
            if target.read_bytes() == landed.read_bytes():
                return Step(path, Action.SAME, kind)
            if drift > 0:
                return Step(path, Action.PULL, kind, "peer's is newer")
            if drift < 0:
                return Step(path, Action.PUSH, kind, "ours is newer")

            # Too close to call, so call neither: picking a side here would
            # overwrite the other body on nothing but rounding.
            return Step(path, Action.CONFLICT, kind, "edited within a second")

        ours = target.read_text()
        theirs = landed.read_text()
        if kind is Merge.INDEX:
            merged = self.merge_index(ours, theirs, peer_is_newer)
        else:
            merged = self.merge_lines(ours, theirs)
        if merged == ours == theirs:
            return Step(path, Action.SAME, kind)

        return Step(path, Action.MERGE, kind, payload=merged)

    def decide(self, profile: Profile, path: str, staging: Path) -> Step:
        ours = (profile.root / path).read_bytes()
        theirs = (staging / path).read_bytes()
        if ours == theirs:
            return Step(path, Action.SAME, Merge.APPEND)
        if self.is_prefix(ours, theirs):
            return Step(path, Action.PULL, Merge.APPEND, "peer extended it")
        if self.is_prefix(theirs, ours):
            return Step(path, Action.PUSH, Merge.APPEND, "we extended it")

        return Step(path, Action.CONFLICT, Merge.APPEND, "resumed on both")

    def record(self, entry: dict[str, object]) -> None:
        self.manifest.append(entry)
        # Rewritten on every backup, not once at the end: a run that dies
        # partway would otherwise leave a directory of copies with nothing
        # saying what any of them was.
        (self.backup_root / "manifest.json").write_text(
            json.dumps(self.manifest, indent=2)
        )

    def backup(self, profile: Profile, path: str, required: bool = False) -> None:
        source = profile.root / path
        if not source.is_file():
            if required:
                raise FileNotFoundError(f"no body to back up for {path}")
            return
        target = self.backup_root / profile.slug / path
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
        self.record(
            {
                "profile": profile.name,
                "path": path,
                "size": source.stat().st_size,
                "backup": str(target),
            }
        )

    def backup_peer(
        self, profile: Profile, path: str, staging: Path, required: bool = False
    ) -> None:
        """Keep the peer's body before a push or a drop removes it.

        Planning already fetched every path whose copies disagreed and every
        path about to be dropped, so the bytes are here; a path the peer
        never had has nothing to keep.
        """
        source = staging / path
        if not source.is_file():
            if required:
                raise FileNotFoundError(f"no peer body to back up for {path}")
            return
        target = self.backup_root / f"{profile.slug}-peer" / path
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
        self.record(
            {
                "profile": profile.name,
                "side": self.transport.name,
                "path": path,
                "size": source.stat().st_size,
                "backup": str(target),
            }
        )

    def apply(self, profile: Profile, report: Report, staging: Path) -> list[str]:
        """Carry out the plan; returns every path sent, conflict sidecars included."""
        for path in self.moved_here(profile, report):
            report.hold(path, "changed here mid-run")
        for side, value in report.new_ids.items():
            if side == "local":
                (profile.root / self.MARKER).write_text(value)
            else:
                assert report.base is not None
                report.base.remote_id = self.write_id(profile, value)

        pull = [s.path for s in report.steps if s.action is Action.PULL]
        push = [s.path for s in report.steps if s.action is Action.PUSH]

        unstaged: list[str] = []
        for path in pull:
            self.backup(profile, path)
            # Planning already fetched every pair that disagreed, so only a
            # path this side never had still has to cross the wire.
            staged = staging / path
            if not staged.is_file():
                unstaged.append(path)
                continue
            target = profile.root / path
            # Renamed into place, so an agent reading it never sees half.
            temporary = target.with_name(f".{target.name}.synco")
            shutil.copy2(staged, temporary)
            temporary.replace(target)
        self.fetch(profile, unstaged, profile.root)

        for step in report.steps:
            if step.action is Action.DROP_LOCAL:
                self.backup(profile, step.path, required=True)
                (profile.root / step.path).unlink()
            elif (
                step.action is Action.DROP_REMOTE
                and not (staging / step.path).is_file()
            ):
                report.hold(step.path, "no backup body")

        for step in report.steps:
            if step.action is Action.MERGE:
                push.append(self.write_merge(profile, step))
            elif step.action is Action.CONFLICT:
                push.extend(self.write_conflict(profile, step, staging))

        drop = [s.path for s in report.steps if s.action is Action.DROP_REMOTE]
        for path in push:
            self.backup_peer(profile, path, staging)
        for path in drop:
            self.backup_peer(profile, path, staging, required=True)
        safe = set(self.unmoved(profile, report, push + drop))
        drop = [p for p in drop if p in safe]
        if drop:
            listing = self.write_list(f"delete-{profile.slug}.txt", drop)
            self.rclone(
                "delete", "--files-from", str(listing), self.transport.remote(profile)
            )
        sent = [p for p in push if p in safe]
        self.send(profile, sent, profile.root)

        return sent

    def settle(self, profile: Profile, report: Report, sent: list[str]) -> None:
        """Record what both sides were observed to agree on, never what was meant.

        rclone skips a vanished source and a missing delete target without a
        word, so every written path is listed again rather than trusted.
        """
        base = report.base
        assert base is not None
        dropped = [s.path for s in report.steps if s.action is Action.DROP_REMOTE]
        after = self.scan_remote(profile, sent + dropped) if sent or dropped else {}

        def now(path: str) -> Entry | None:
            try:
                info = (profile.root / path).lstat()
            except FileNotFoundError:
                return None
            return Entry(info.st_size, int(info.st_mtime))

        for path in list(base.paths):
            if path not in report.local and path not in report.remote:
                del base.paths[path]
        for step in report.steps:
            path = step.path
            local = report.local.get(path)
            remote = report.remote.get(path)
            match step.action:
                case Action.SAME:
                    if now(path) == local:
                        base.paths[path] = (local, remote)
                case Action.PULL:
                    if (current := now(path)) is not None and current == remote:
                        base.paths[path] = (current, remote)
                case Action.DROP_LOCAL | Action.DROP_REMOTE:
                    if now(path) is None and path not in after:
                        base.paths.pop(path, None)
                case Action.KEEP:
                    if local is None:
                        base.paths[path] = (None, remote)
                    else:
                        base.paths[path] = (local, None)
                case Action.UNCLAIMED:
                    base.unclaimed.add(path)
                case _:
                    pass
        for path in sent:
            current = now(path)
            if current is not None and current == after.get(path):
                base.paths[path] = (current, current)
                base.unclaimed.discard(path)
        base.unclaimed &= set(report.local)
        base.unclaimed -= set(base.paths)
        base.save()

    def unmoved(self, profile: Profile, report: Report, push: list[str]) -> list[str]:
        """Drop pushes and drops whose far copy changed since the plan.

        Between reading the other side and writing to it, an agent on the
        peer — or another machine syncing to the same archive — can append
        to the very file about to be overwritten, and those bytes exist
        nowhere else. Anything that moved is left alone and settles on the
        next run, when both bodies are in view again.
        """
        if not push:
            return []
        current = self.scan_remote(profile, push)
        safe: list[str] = []
        for path in push:
            before = report.remote.get(path)
            now = current.get(path)
            # Appearing or vanishing counts as moving: a path the peer
            # created mid-run holds bytes that exist nowhere else either.
            if now == before:
                safe.append(path)
                continue
            self.log.warning(
                "%s changed on %s since planning", path, self.transport.name
            )
            report.hold(path, f"changed on {self.transport.name} mid-run")

        return safe

    def moved_here(self, profile: Profile, report: Report) -> list[str]:
        """Pulls, merges and drops whose local copy changed since the plan.

        Each replaces or removes our body on a decision taken against the old
        one, so the lines an agent here appended in between would survive
        only in the backup tree.
        """
        moved: list[str] = []
        for step in report.steps:
            if step.action not in (Action.PULL, Action.MERGE, Action.DROP_LOCAL):
                continue
            try:
                info = (profile.root / step.path).lstat()
                now: Entry | None = Entry(info.st_size, int(info.st_mtime))
            except FileNotFoundError:
                now = None
            if now != report.local.get(step.path):
                self.log.warning("%s changed here since planning", step.path)
                moved.append(step.path)

        return moved

    def write_merge(self, profile: Profile, step: Step) -> str:
        assert step.payload is not None
        self.backup(profile, step.path)
        (profile.root / step.path).write_text(step.payload)

        return step.path

    def write_conflict(self, profile: Profile, step: Step, staging: Path) -> list[str]:
        """Park both bodies side by side. Neither original is touched.

        Both sidecars go to both machines: the one holding our body is the
        half the peer does not already have.
        """
        target = profile.root / step.path
        already = {
            self.digest(p) for p in target.parent.glob(f"{target.name}.conflict-*")
        }
        parked: list[str] = []
        sides = ((self.hostname, target), (self.transport.name, staging / step.path))
        for side, body in sides:
            # A conflict stays one until someone resolves it by hand, so
            # without this every later run parks the same two bodies again.
            if self.digest(body) in already:
                continue
            name = f"{step.path}.conflict-{side}-{self.stamp}"
            shutil.copy2(body, profile.root / name)
            parked.append(name)

        return parked

    def reconcile(self, profile: Profile, report: Report) -> None:
        """Level an opencode profile's database with its session exports.

        Runs before planning and again after a pull. The ledger tells which
        side moved since the two last agreed, and that side wins, so a revert
        travels like any edit; with no ledger entry the longer message-id
        list wins. Both moved parks the export beside the database's body.
        """
        store = Opencode(profile, self.log)
        if not store.database.is_file():
            # Pointed at a missing file, opencode would create an empty one.
            self.log.info("%s: no database, nothing to export", profile.name)
            return
        if self.dry_run:
            self.console.print(
                f"{profile.name}: dry run starts no opencode server, so sessions"
                " are neither exported nor imported; the plan covers the"
                " exports as they stand"
            )
            return
        live = (
            run(
                ["pgrep", "-x", "-u", str(os.getuid()), "opencode"],
                log=self.log,
                timeout=30.0,
            ).returncode
            == 0
        )
        ledger = Ledger.load(
            self.STATE_DIR / "opencode" / f"{profile.slug}.json",
            store.database.stat().st_ino,
        )
        folder = profile.root / "sessions"

        def entry(session: str) -> Entry | None:
            try:
                info = (folder / f"{session}.json").lstat()
            except FileNotFoundError:
                return None
            return Entry(info.st_size, int(info.st_mtime))

        def parent(session: str) -> str | None:
            if session in known:
                return known[session].get("parentID")
            try:
                return json.loads((folder / f"{session}.json").read_text())["info"].get(
                    "parentID"
                )
            except OSError, ValueError, KeyError, TypeError, AttributeError:
                return None

        def depth(session: str) -> int:
            found = 0
            above = parent(session)
            while above is not None and found < 64:
                found += 1
                above = parent(above)
            return found

        exports = (
            [p for p in folder.glob("ses_*.json") if self.OPENCODE_ID.fullmatch(p.stem)]
            if folder.is_dir()
            else []
        )
        files = {p.stem for p in exports if p.is_file() and not p.is_symlink()}
        # A symlink or a directory where an export belongs: never read as a
        # session, never written through.
        irregular = {p.stem for p in exports} - files

        with store:
            if (state := store.migrating()) is not None:
                raise click.ClickException(
                    f"V1 migration {state}; let opencode finish it first"
                )
            known = store.sessions()
            replacing = {
                s
                for s, (updated, _) in ledger.sessions.items()
                if updated == Ledger.REPLACING
            }
            # A replace cut short is not a delete: its export is imported.
            gone = [s for s in ledger.sessions if s not in known and s not in replacing]
            if (
                len(gone) > self.GATE_COUNT
                and len(gone) > self.GATE_RATIO * len(ledger.sessions)
                and not self.force_deletes
            ):
                raise click.ClickException(
                    f"{len(gone)} of {len(ledger.sessions)} sessions gone from the database"
                )
            # An export that changed since is an edit elsewhere, which beats
            # this delete: it is imported again below.
            unlink = [
                s for s in gone if s in files and entry(s) == ledger.sessions[s][1]
            ]
            holding = self.no_deletes or len(unlink) > self.max_delete
            if holding and unlink:
                report.capped = not self.no_deletes
                self.log.warning(
                    "%s: %d deleted session(s) held", profile.name, len(unlink)
                )
            pending = [
                s
                for s, info in known.items()
                if ledger.sessions.get(s) != (info["time"]["updated"], entry(s))
            ]
            # A deletion held keeps its export, and one carried out removes
            # it; neither is a session to import.
            pending += [
                s
                for s in files
                if s not in known and not (s in gone and (holding or s in unlink))
            ]

            exported = imported = replaced = held = 0
            touched: set[str] = set()
            try:
                for session in replacing - set(known) - files:
                    del ledger.sessions[session]
                if not holding:
                    for session in gone:
                        if session in unlink:
                            self.backup(profile, f"sessions/{session}.json")
                            (folder / f"{session}.json").unlink()
                        del ledger.sessions[session]

                for session in sorted(pending, key=depth):
                    path = folder / f"{session}.json"
                    if session in irregular:
                        held += 1
                        continue
                    if session not in known:
                        if self.restore(store, path, known):
                            imported += 1
                            touched.add(session)
                        else:
                            held += 1
                        continue
                    seen = ledger.sessions.get(session)
                    updated = known[session]["time"]["updated"]
                    data = store.export(session)
                    ours = tuple(m["id"] for m in data["messages"])
                    theirs = (
                        self.transcript(path.read_text()) if path.is_file() else None
                    )
                    if theirs is None or theirs != ours:
                        if seen is None:
                            db_moved, file_moved = (
                                theirs is not None and self.extends(ours, theirs),
                                theirs is not None and self.extends(theirs, ours),
                            )
                        else:
                            db_moved = seen[0] not in (updated, Ledger.REPLACING)
                            file_moved = seen[0] == Ledger.REPLACING or seen[
                                1
                            ] != entry(session)
                        if not path.is_file():
                            self.write_export(path, data)
                            exported += 1
                        elif file_moved and not db_moved:
                            restored = self.replace(
                                store, profile, session, data, known, ledger, live
                            )
                            touched.update(restored or ())
                            if restored is None or session not in restored:
                                held += 1
                            else:
                                replaced += 1
                            continue
                        elif db_moved and not file_moved:
                            # Without a ledger entry the longer list only
                            # looks newer: the shorter one may be a revert.
                            if (
                                seen is None
                                or theirs is None
                                or not self.extends(ours, theirs)
                            ):
                                self.backup(profile, f"sessions/{session}.json")
                            self.write_export(path, data)
                            exported += 1
                        else:
                            parked = path.with_name(
                                f"{path.name}.conflict-incoming-{self.stamp}"
                            )
                            self.log.warning(
                                "%s: %s changed on both", profile.name, session
                            )
                            shutil.copy2(path, parked)
                            self.write_export(path, data)
                            report.parked.append(f"sessions/{parked.name}")
                    ledger.sessions[session] = (updated, entry(session))

                if touched:
                    # An import stamps its own time.updated, so the ledger
                    # takes the database's word rather than the export's.
                    known = store.sessions()
                    for session in touched & set(known):
                        ledger.sessions[session] = (
                            known[session]["time"]["updated"],
                            entry(session),
                        )
            finally:
                ledger.save()
        if exported or imported or replaced or held or report.parked:
            self.console.print(
                f"{profile.name}: exported {exported}, imported {imported},"
                f" replaced {replaced}, held {held}, parked {len(report.parked)}"
            )

    def restore(self, store: Opencode, path: Path, known: dict[str, dict]) -> bool:
        """Import one export; False, with the reason logged, when it cannot be.

        A child needs its parent imported first, and opencode resolves the
        session's project from its directory, which must exist here.
        """
        try:
            data = json.loads(path.read_text())
            info = data["info"]
            directory = store.directory(info["location"]["directory"])
        except OSError, ValueError, KeyError, TypeError:
            self.log.warning("%s: unreadable export", path)
            return False
        # Debug, not warning: both recur on every run for as long as the
        # directory is missing — a deleted worktree, an old /tmp scratchpad —
        # and the held count already says how many there are.
        if info.get("parentID") and info["parentID"] not in known:
            self.log.debug("%s: parent %s not here", path.stem, info["parentID"])
            return False
        if directory is None:
            self.log.debug("%s: %s absent here", path.stem, info["location"])
            return False
        if (status := store.load(data, directory)) != 200:
            self.log.warning("%s: import refused, HTTP %d", path.stem, status)
            return False
        known.setdefault(path.stem, info)

        return True

    def replace(
        self,
        store: Opencode,
        profile: Profile,
        session: str,
        planned: dict,
        known: dict[str, dict],
        ledger: Ledger,
        live: bool,
    ) -> list[str] | None:
        """Swap a session in the database for the copy in its export.

        Import refuses an existing id, and a delete takes the children along,
        so each child's export is brought level first and every member's
        database body is backed up as `<id>.json.db`. Returns the members
        imported again, or None when nothing was deleted.
        """
        if self.no_deletes or live:
            self.log.info(
                "%s: replace held, %s",
                session,
                "deletes disabled" if self.no_deletes else "opencode running here",
            )
            return None
        folder = profile.root / "sessions"
        children: dict[str, list[str]] = {}
        for child, info in known.items():
            if info.get("parentID"):
                children.setdefault(info["parentID"], []).append(child)
        tree: list[str] = []
        queue = list(children.get(session, []))
        while queue:
            tree.append(child := queue.pop(0))
            queue += children.get(child, [])

        for member in (session, *tree):
            if store.directory(known[member]["location"]["directory"]) is None:
                self.log.warning("%s: directory absent here, replace held", member)
                return None
        bodies = {session: planned}
        for child in tree:
            path = folder / f"{child}.json"
            bodies[child] = data = store.export(child)
            ours = tuple(m["id"] for m in data["messages"])
            theirs = self.transcript(path.read_text()) if path.is_file() else None
            if theirs is None or not (theirs == ours or self.extends(theirs, ours)):
                if path.is_file():
                    self.backup(profile, f"sessions/{child}.json")
                self.write_export(path, data)
        for member, data in bodies.items():
            target = self.backup_root / profile.slug / "sessions" / f"{member}.json.db"
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(json.dumps(data, indent=2, ensure_ascii=False))
            self.record(
                {
                    "profile": profile.name,
                    "session": member,
                    "size": target.stat().st_size,
                    "backup": str(target),
                }
            )

        # Whatever ran in the database since it was read is not in the
        # backup, so a session that moved is left for the next run.
        current = store.info(session)
        if (
            current is None
            or current["time"]["updated"] != known[session]["time"]["updated"]
            or store.export(session)["messages"] != planned["messages"]
        ):
            self.log.warning("%s: changed since planning, replace held", session)
            return None

        for member in (session, *tree):
            info = (folder / f"{member}.json").lstat()
            entry = Entry(info.st_size, int(info.st_mtime))
            ledger.sessions[member] = (Ledger.REPLACING, entry)
            known.pop(member)
        # Saved before the delete: a kill anywhere after this leaves entries
        # saying the export is the copy to keep, never ones that read as a
        # deletion and unlink a child's export or as the database moving.
        ledger.save()
        store.delete(session)

        return [
            member
            for member in (session, *tree)
            if self.restore(store, folder / f"{member}.json", known)
        ]

    @staticmethod
    def write_export(path: Path, data: dict) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        # Renamed into place, so a transfer never reads half of it.
        temporary = path.with_name(f".{path.name}.synco")
        temporary.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        temporary.replace(path)

    def reindex(self, profile: Profile) -> None:
        """Have codex index the rollouts pulled this run.

        Its resume picker reads `state_5.sqlite` alone, so a rollout with no
        row there resumes by id but never shows up. `thread/list` without
        `useStateDbOnly` scans the rollouts and writes the missing rows.
        app-server drops a request still pending when stdin closes, which
        rules out `dotlib.cli.run`: stdin stays open until every page is read.
        """
        cmd = ["codex", "app-server"]
        self.log.info("spawn: %s", " ".join(cmd))
        stderr = self.backup_root / "lists" / f"app-server-{profile.slug}.log"
        stderr.parent.mkdir(parents=True, exist_ok=True)
        with stderr.open("w") as sink:
            proc = subprocess.Popen(
                cmd,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=sink,
                env={**os.environ, "CODEX_HOME": str(profile.root)},
                text=True,
                start_new_session=True,
            )
        assert proc.stdin is not None and proc.stdout is not None
        # A blocked readline cannot time out, so the deadline kills the group
        # instead and the read then sees EOF.
        timer = threading.Timer(
            self.REINDEX_TIMEOUT, os.killpg, (proc.pid, signal.SIGKILL)
        )
        timer.start()
        indexed = 0
        try:

            def call(method: str, params: dict) -> dict:
                ask = {"id": method, "method": method, "params": params}
                proc.stdin.write(json.dumps(ask) + "\n")
                proc.stdin.flush()
                for line in proc.stdout:
                    message = json.loads(line)
                    if message.get("id") != method:
                        continue
                    if "error" in message:
                        raise ValueError(f"{method}: {message['error']}")
                    return message["result"]
                if not timer.is_alive():
                    raise subprocess.TimeoutExpired(cmd, self.REINDEX_TIMEOUT)
                raise ValueError(f"{method}: app-server exited")

            call("initialize", {"clientInfo": {"name": "synco", "version": "1"}})
            proc.stdin.write(json.dumps({"method": "initialized"}) + "\n")
            for archived in (False, True):
                cursor = None
                while True:
                    page = call(
                        "thread/list",
                        {
                            "limit": 500,
                            "cursor": cursor,
                            "archived": archived,
                            "useStateDbOnly": False,
                            # Empty means every provider; omitted, only the
                            # configured one.
                            "modelProviders": [],
                            # Omitted, interactive sources only.
                            "sourceKinds": list(self.CODEX_SOURCES),
                        },
                    )
                    indexed += len(page["data"])
                    if not (cursor := page.get("nextCursor")):
                        break
        finally:
            timer.cancel()
            with contextlib.suppress(BrokenPipeError):
                proc.stdin.close()
            try:
                proc.wait(timeout=30.0)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
                proc.wait()
            self.log.debug("app-server stderr: %s", stderr.read_text())
        self.log.info("%s: %d thread(s) indexed", profile.name, indexed)

    def live_vendors(self) -> set[Vendor]:
        """Which vendors have a process running on either side.

        One round trip rather than one per vendor: the probe prints the
        names it finds, because `pgrep` prints pids and those say nothing
        about which vendor they belong to.
        """
        probe = "; ".join(f"pgrep -x {v} >/dev/null && echo {v}" for v in Vendor)
        live = {
            vendor
            for vendor in Vendor
            if run(
                ["pgrep", "-x", "-u", str(os.getuid()), str(vendor)],
                log=self.log,
                timeout=30.0,
            ).returncode
            == 0
        }
        command = self.transport.shell(probe)
        if command is None:
            return live
        remote = run(
            command,
            log=self.log,
            timeout=30.0,
        )

        return live | {v for v in Vendor if str(v) in remote.stdout.split()}

    def summary(self, reports: list[Report]) -> Table:
        table = Table(box=None)
        table.add_column("Profile", style="bold")
        table.add_column("Same", justify="right")
        table.add_column("Pull", justify="right", style="cyan")
        table.add_column("Push", justify="right", style="green")
        table.add_column("Merge", justify="right", style="yellow")
        table.add_column("Drop", justify="right", style="red")
        table.add_column("Keep", justify="right", style="blue")
        table.add_column("Unclaimed", justify="right", style="magenta")
        table.add_column("Held", justify="right", style="magenta")
        table.add_column("Conflict", justify="right", style="red")
        table.add_column("Note")
        for report in reports:
            table.add_row(
                report.profile.name,
                str(report.count(Action.SAME, Action.SKIP)),
                str(report.count(Action.PULL)),
                str(report.count(Action.PUSH)),
                str(report.count(Action.MERGE)),
                str(report.count(Action.DROP_LOCAL, Action.DROP_REMOTE)),
                str(report.count(Action.KEEP)),
                str(report.count(Action.UNCLAIMED)),
                str(report.count(Action.HELD)),
                str(report.count(Action.CONFLICT) + len(report.parked)),
                report.skipped
                or (f"refused: {report.refused}" if report.refused else "")
                or ("capped" if report.capped else ""),
            )

        return table

    def detail(self, report: Report) -> None:
        moving = [s for s in report.steps if s.action not in (Action.SAME, Action.SKIP)]
        if not moving:
            return
        self.console.rule(f"[bold yellow]{report.profile.name}[/]")
        table = Table(box=None)
        table.add_column("Action", style="bold")
        table.add_column("Path")
        table.add_column("Why")
        for step in moving:
            table.add_row(
                f"[{self.ACTION_STYLES[step.action]}]{step.action}[/]",
                step.path,
                step.note or str(step.merge),
            )
        self.console.print(table)

    def warn_live(self, live: set[Vendor]) -> None:
        if not live:
            return
        names = ", ".join(sorted(live))
        # A push whose target the peer has since changed is caught by the
        # re-check in `unmoved`, and a transfer cut short leaves a strict
        # prefix the next run repairs. Worth saying, not worth refusing over.
        self.console.print(
            f"[yellow]running:[/] {names} — some paths may be held back this run"
        )

    def tidy(self) -> None:
        """Drop scratch state; keep backup bodies for BACKUP_DAYS.

        Staging and file lists are scratch. A run that backed nothing up
        leaves nothing worth keeping. Only stamp-named directories are ever
        removed, so the receipts beside them are out of reach.
        """
        if self.dry_run:
            shutil.rmtree(self.backup_root, ignore_errors=True)
            return
        cutoff = self.now - self.BACKUP_DAYS * 86400
        for entry in self.STATE_DIR.iterdir():
            if not (entry.is_dir() and self.STAMP_PATTERN.fullmatch(entry.name)):
                continue
            # Runs from before this layout kept their lists at the top.
            for scratch in (entry / "peer", entry / "lists"):
                shutil.rmtree(scratch, ignore_errors=True)
            for listing in entry.glob("*.txt"):
                listing.unlink()
            if (
                not (entry / "manifest.json").exists()
                or time.mktime(time.strptime(entry.name[:15], self.STAMP)) < cutoff
            ):
                shutil.rmtree(entry)

    def sync(self, profiles: list[Profile]) -> int:
        self.transport.check()
        self.STATE_DIR.mkdir(parents=True, exist_ok=True)
        with (self.STATE_DIR / "lock").open("w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise click.ClickException("another synco run holds the lock")
            try:
                return self.run_locked(profiles)
            finally:
                self.tidy()

    def run_locked(self, profiles: list[Profile]) -> int:
        # The plan tables and rclone's planning fetch read exactly as a real
        # run does, so the mode is stated before and after them.
        if self.dry_run:
            self.console.rule(self.DRY_RUN_BANNER)
        if any(p.sweeps for p in profiles):
            self.check_clock()
        live = self.live_vendors()
        staging = self.backup_root / "peer"
        staging.mkdir(parents=True, exist_ok=True)

        self.warn_live(live)
        reports: list[Report] = []
        # One profile's failure refuses that profile; the rest still sync.
        failed = (
            subprocess.CalledProcessError,
            subprocess.TimeoutExpired,
            click.ClickException,
            OSError,
            ValueError,
            KeyError,
        )
        for profile in profiles:
            report = Report(profile)
            reports.append(report)
            if profile.vendor is Vendor.OPENCODE:
                try:
                    self.reconcile(profile, report)
                except failed as error:
                    self.log.error("%s: %s", profile.name, error)
                    report.refused = f"export failed: {error}"
                    continue
            self.plan(report, staging / profile.slug)
            self.detail(report)
            # Applied here rather than once every profile is planned: the
            # gap between reading the peer and writing to it is the window
            # in which the peer can change what is about to be overwritten,
            # so it is kept to a single profile.
            if not self.dry_run and not report.skipped and not report.refused:
                # A failed write leaves the old receipts, from which the next
                # run re-plans safely; the remaining profiles still sync.
                try:
                    sent = self.apply(profile, report, staging / profile.slug)
                except failed as error:
                    self.log.error("%s: %s", profile.name, error)
                    report.refused = f"apply failed: {error}"
                    continue
                self.settle(profile, report, sent)
                if profile.vendor is Vendor.OPENCODE and report.count(Action.PULL):
                    try:
                        self.reconcile(profile, report)
                    except failed as error:
                        self.log.error("%s: %s", profile.name, error)
                        report.refused = f"import failed: {error}"
                if profile.vendor is Vendor.CODEX and any(
                    s.action is Action.PULL
                    and s.path.startswith(("sessions/", "archived_sessions/"))
                    for s in report.steps
                ):
                    try:
                        self.reindex(profile)
                    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
                        # Nothing is lost: the rollouts are in place and
                        # `codex resume <id>` finds them, only the picker
                        # misses them until codex scans on its own.
                        self.log.warning("%s: reindex failed: %s", profile.name, error)

        # Printed at the end as well because rclone's progress meter pushes
        # anything above it off screen on a transfer of any size.
        self.console.rule("[bold yellow]Done[/]")
        self.console.print(self.summary(reports))
        unclaimed = sum(r.count(Action.UNCLAIMED) for r in reports)
        if unclaimed:
            self.console.print(
                f"[magenta]{unclaimed} unclaimed[/] local-only path(s) held on a first"
                " sync; review them and rerun with --adopt to push"
            )
        failures = sum(
            r.count(Action.CONFLICT) + len(r.parked) + bool(r.refused) + r.capped
            for r in reports
        )
        if self.dry_run:
            self.console.rule(self.DRY_RUN_BANNER)
            return failures
        if (self.backup_root / "manifest.json").exists():
            self.console.print(f"backups: [bold]{self.backup_root}[/]")

        return failures

    @cli.group("agents", invoke_without_command=True)
    @click.option("--peer", default=None, help="Host to sync against, over ssh.")
    @click.option("--user", default=None, help="Remote user. Default: ssh config.")
    @click.option(
        "--archive",
        is_flag=False,
        flag_value=str(ARCHIVE),
        default=None,
        help="Directory to sync against instead of a peer.",
    )
    @click.option("--profile", "profiles", multiple=True, help="Profile to sync.")
    @click.option(
        "--vendor",
        type=click.Choice([v.value for v in Vendor]),
        multiple=True,
        help="Vendor to sync.",
    )
    @click.option("-n", "--dry-run", is_flag=True, help="Plan only, write nothing.")
    @click.option(
        "--checksum", is_flag=True, help="Hash files whose size and mtime match."
    )
    @click.option("--adopt", is_flag=True, help="Push unclaimed local-only paths.")
    @click.option("--no-deletes", is_flag=True, help="Hold every drop.")
    @click.option(
        "--force-deletes", is_flag=True, help="Override the mass-delete gate."
    )
    @click.option("--max-delete", default=25, show_default=True, help="Drop cap.")
    @click.option(
        "--max-expire", default=200, show_default=True, help="Expiry drop cap."
    )
    @click.pass_context
    def cmd_agents(
        ctx: click.Context,
        peer: str | None,
        user: str | None,
        archive: str | None,
        profiles: tuple[str, ...],
        vendor: tuple[str, ...],
        dry_run: bool,
        checksum: bool,
        adopt: bool,
        no_deletes: bool,
        force_deletes: bool,
        max_delete: int,
        max_expire: int,
    ) -> None:
        """Sync agent sessions and memories with a peer machine or an archive."""
        ctx.obj = Synco.select(profiles, vendor)
        # Checked here rather than declared required, so the subcommands that
        # never reach the far side are not made to name one.
        if ctx.invoked_subcommand is not None:
            return
        if peer and archive:
            raise click.UsageError("--peer and --archive are exclusive", ctx)
        if archive and user:
            raise click.UsageError("--user belongs to --peer", ctx)

        transport: Transport
        if peer:
            transport = Peer(peer, user)
        elif archive:
            transport = Archive(Path(archive))
        else:
            raise click.UsageError("--peer or --archive is required to sync", ctx)

        synco = Synco(
            transport,
            dry_run,
            checksum,
            adopt=adopt,
            no_deletes=no_deletes,
            force_deletes=force_deletes,
            max_delete=max_delete,
            max_expire=max_expire,
        )
        failures = synco.sync(ctx.obj)
        if failures:
            synco.console.print(
                f"[red]{failures} problem(s)[/]: conflicts parked beside their"
                " originals, refused or capped profiles held back"
            )
            sys.exit(1)

    @cmd_agents.command("profiles")
    @click.pass_obj
    def cmd_agents_profiles(selected: list[Profile]) -> None:
        """List the profiles synco knows and where their state lives."""
        table = Table(box=None)
        table.add_column("Profile", style="bold")
        table.add_column("Vendor")
        table.add_column("Root")
        table.add_column("State")
        table.add_column("Sweeps")
        table.add_column("Present")
        for profile in selected:
            table.add_row(
                profile.name,
                profile.vendor,
                str(profile.root),
                "sqlite export" if profile.vendor is Vendor.OPENCODE else "files",
                "yes" if profile.sweeps else "no",
                "yes" if profile.root.is_dir() else "no",
            )
        Synco.console.print(table)


if __name__ == "__main__":
    Synco.cli()
