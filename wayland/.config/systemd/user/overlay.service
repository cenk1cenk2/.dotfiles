[Unit]
Description=On-screen cards and submap hints
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Same as swayosd: a GTK surface must not wake or pin a hybrid laptop's dGPU.
Environment=DRI_PRIME=0
Environment=MANGOHUD=0
Environment=DISABLE_MANGOHUD=1
ExecStart=%h/.config/wayland/scripts/overlay.py serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
