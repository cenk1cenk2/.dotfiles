{
  "apps": [
    {
      "auto-detach": false,
      "exclude-global-prep-cmd": false,
      "exit-timeout": 5,
      "image-path": "desktop.png",
      "name": "Desktop",
      "prep-cmd": [
        {
          "do": "$(HOME)/.config/hypr/scripts/virtual-display.py start --name SUNSHINE --client-scale emanet=2 --client-scale bat=1.66667 --reveal",
          "undo": "$(HOME)/.config/hypr/scripts/virtual-display.py stop --name SUNSHINE"
        },
        {
          "do": "$(HOME)/.config/hypr/scripts/virtual-audio.py start --name SUNSHINE",
          "undo": "$(HOME)/.config/hypr/scripts/virtual-audio.py stop --name SUNSHINE"
        }
      ],
      "wait-all": false
    }
  ],
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  }
}
