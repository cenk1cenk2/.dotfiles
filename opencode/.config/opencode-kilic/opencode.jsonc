{
  "$schema": "https://opencode.ai/config.json",
  "theme": "one-dark",
  "model": "kilic/ollama/cloud/glm-5.2:cloud",
  "small_model": "kilic/ollama/cloud/gemma4:31b-cloud",
  "enabled_providers": ["kilic"],
  "autoupdate": false,
  "instructions": ["CLAUDE.md", "AGENTS.md"],
  "compaction": { "auto": true, "tail_turns": 10 },
  "experimental": {
    "continue_loop_on_deny": true,
    "batch_tool": true,
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
    "edit": {
      "~/.claude-kilic/plans/**": "allow",
      "*": "ask",
    },
    "bash": {
      "git status": "allow",
      "git log": "allow",
      "git diff": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git rev-parse": "allow",
      "git remote -v": "allow",
      "git tag": "allow",
      "ls": "allow",
      "wc": "allow",
      "stat": "allow",
      "which": "allow",
      "file": "allow",
      "pwd": "allow",
      "type": "allow",
      "*": "ask",
    },
  },
  "provider": {
    "kilic": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "kilic",
      "options": {
        "baseURL": "https://ai.kilic.dev/v1",
        "apiKey": "{env:AI_KILIC_DEV_API_KEY}",
      },
      "models": {
        "ollama/cloud/deepseek-v4-pro:cloud": {
          "name": "DeepSeek V4 Pro",
        },
        "ollama/cloud/glm-5.2:cloud": {
          "name": "GLM 5.2 Cloud",
          "options": {
            "reasoningEffort": "max",
          },
        },
        "ollama/cloud/kimi-k3:cloud": {
          "name": "Kimi K3 Code Cloud",
        },
        "ollama/cloud/gemma4:31b-cloud": {
          "name": "Gemma4 Cloud",
        },
      },
    },
  },
}
