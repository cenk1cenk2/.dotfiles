{
  "$schema": "https://opencode.ai/config.json",
  "model": "kilic/kilic.dev/smart",
  "update": "disable",
  "compaction": { "auto": true },
  // Relative to the repo, not this directory: stow links server.js on its own,
  // and opencode drops a plugin whose entrypoint resolves outside its directory.
  "plugins": ["../../.dotfiles/opencode/.config/opencode-kilic/plugins/gateway"],
  // Deny every provider, then allow the one this profile pays for. The last
  // matching statement wins, and a denied provider drops out of the catalog
  // even when it has credentials.
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "kilic", "effect": "allow" },
  ],
  "agents": {
    "title": { "model": "kilic/kilic.dev/cheap" },
  },
  // Rules are matched in order and the LAST match wins, so the catch-all sits
  // first and every rule below it carves an exception out of it. Without it,
  // opencode seeds every agent with an allow-all rule, so anything unnamed
  // would run unprompted.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    // A leading ~ is expanded for read, edit and external_directory, never
    // for shell, whose resource stays raw command text.
    {
      "action": "edit",
      "resource": "~/.claude-kilic/plans/*",
      "effect": "allow",
    },

    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "git remote get-url *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "git tag *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },

    { "action": "shell", "resource": "sed -i*", "effect": "deny" },
    { "action": "shell", "resource": "sed --in-place*", "effect": "deny" },
    { "action": "shell", "resource": "perl -i*", "effect": "deny" },
    { "action": "shell", "resource": "perl -pi*", "effect": "deny" },
    { "action": "shell", "resource": "perl -p -i*", "effect": "deny" },
    { "action": "shell", "resource": "awk -i inplace*", "effect": "deny" },
    { "action": "shell", "resource": "gawk -i inplace*", "effect": "deny" },

    // Each verb gets a second form because a flag may sit between the
    // executable and the verb (`kubectl -n ns delete ...`).
    { "action": "shell", "resource": "aws *", "effect": "deny" },
    { "action": "shell", "resource": "eksctl *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl annotate *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "kubectl -* annotate *",
      "effect": "deny",
    },
    { "action": "shell", "resource": "kubectl apply *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* apply *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl attach *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* attach *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl autoscale *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "kubectl -* autoscale *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "kubectl certificate *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "kubectl -* certificate *",
      "effect": "deny",
    },
    { "action": "shell", "resource": "kubectl cordon *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* cordon *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl cp *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* cp *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl create *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* create *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl debug *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* debug *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* delete *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl drain *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* drain *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl edit *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* edit *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl exec *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* exec *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl expose *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* expose *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl label *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* label *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl patch *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* patch *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "kubectl port-forward *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "kubectl -* port-forward *",
      "effect": "deny",
    },
    { "action": "shell", "resource": "kubectl proxy *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* proxy *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl replace *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* replace *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl run *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* run *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl scale *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* scale *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl set *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* set *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl taint *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl -* taint *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl uncordon *", "effect": "deny" },
    {
      "action": "shell",
