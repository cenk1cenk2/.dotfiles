{
  "$schema": "https://opencode.ai/config.json",
  "model": "kilic/ollama/cloud/glm-5.3:cloud",
  "small_model": "kilic/ollama/cloud/gemma4:31b-cloud",
  "enabled_providers": ["kilic"],
  "autoupdate": false,
  "instructions": ["CLAUDE.md", "AGENTS.md"],
  "compaction": { "auto": true, "tail_turns": 10 },
  "experimental": {
    "continue_loop_on_deny": true,
    "batch_tool": true,
  },
  // Rules are matched in order and the LAST match wins, so each catch-all sits
  // above the rules that carve exceptions out of it.
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
    "edit": {
      "*": "ask",
      "~/.claude-kilic/plans/**": "allow",
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git rev-parse *": "allow",
      "git remote -v *": "allow",
      "git remote get-url *": "allow",
      "git tag *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "which *": "allow",
      "file *": "allow",
      "pwd *": "allow",
      "type *": "allow",

      "sed -i*": "deny",
      "sed --in-place*": "deny",
      "perl -i*": "deny",
      "perl -pi*": "deny",
      "perl -p -i*": "deny",
      "awk -i inplace*": "deny",
      "gawk -i inplace*": "deny",

      // Each verb gets a second form because a flag may sit between the
      // executable and the verb (`kubectl -n ns delete ...`).
      "aws *": "deny",
      "eksctl *": "deny",
      "kubectl annotate *": "deny",
      "kubectl -* annotate *": "deny",
      "kubectl apply *": "deny",
      "kubectl -* apply *": "deny",
      "kubectl attach *": "deny",
      "kubectl -* attach *": "deny",
      "kubectl autoscale *": "deny",
      "kubectl -* autoscale *": "deny",
      "kubectl certificate *": "deny",
      "kubectl -* certificate *": "deny",
      "kubectl cordon *": "deny",
      "kubectl -* cordon *": "deny",
      "kubectl cp *": "deny",
      "kubectl -* cp *": "deny",
      "kubectl create *": "deny",
      "kubectl -* create *": "deny",
      "kubectl debug *": "deny",
      "kubectl -* debug *": "deny",
      "kubectl delete *": "deny",
      "kubectl -* delete *": "deny",
      "kubectl drain *": "deny",
      "kubectl -* drain *": "deny",
      "kubectl edit *": "deny",
      "kubectl -* edit *": "deny",
      "kubectl exec *": "deny",
      "kubectl -* exec *": "deny",
      "kubectl expose *": "deny",
      "kubectl -* expose *": "deny",
      "kubectl label *": "deny",
      "kubectl -* label *": "deny",
      "kubectl patch *": "deny",
      "kubectl -* patch *": "deny",
      "kubectl port-forward *": "deny",
      "kubectl -* port-forward *": "deny",
      "kubectl proxy *": "deny",
      "kubectl -* proxy *": "deny",
      "kubectl replace *": "deny",
      "kubectl -* replace *": "deny",
      "kubectl run *": "deny",
      "kubectl -* run *": "deny",
      "kubectl scale *": "deny",
      "kubectl -* scale *": "deny",
      "kubectl set *": "deny",
      "kubectl -* set *": "deny",
      "kubectl taint *": "deny",
      "kubectl -* taint *": "deny",
      "kubectl uncordon *": "deny",
      "kubectl -* uncordon *": "deny",
      "kubectl auth reconcile *": "deny",
      "kubectl -* auth reconcile *": "deny",
      "kubectl rollout restart *": "deny",
      "kubectl -* rollout restart *": "deny",
      "kubectl rollout undo *": "deny",
      "kubectl -* rollout undo *": "deny",
      "kubectl rollout pause *": "deny",
      "kubectl -* rollout pause *": "deny",
      "kubectl rollout resume *": "deny",
      "kubectl -* rollout resume *": "deny",
      "kubecolor annotate *": "deny",
      "kubecolor -* annotate *": "deny",
      "kubecolor apply *": "deny",
      "kubecolor -* apply *": "deny",
      "kubecolor attach *": "deny",
      "kubecolor -* attach *": "deny",
      "kubecolor autoscale *": "deny",
      "kubecolor -* autoscale *": "deny",
      "kubecolor certificate *": "deny",
      "kubecolor -* certificate *": "deny",
      "kubecolor cordon *": "deny",
      "kubecolor -* cordon *": "deny",
      "kubecolor cp *": "deny",
      "kubecolor -* cp *": "deny",
      "kubecolor create *": "deny",
      "kubecolor -* create *": "deny",
      "kubecolor debug *": "deny",
      "kubecolor -* debug *": "deny",
      "kubecolor delete *": "deny",
      "kubecolor -* delete *": "deny",
      "kubecolor drain *": "deny",
      "kubecolor -* drain *": "deny",
      "kubecolor edit *": "deny",
      "kubecolor -* edit *": "deny",
      "kubecolor exec *": "deny",
      "kubecolor -* exec *": "deny",
      "kubecolor expose *": "deny",
      "kubecolor -* expose *": "deny",
      "kubecolor label *": "deny",
      "kubecolor -* label *": "deny",
      "kubecolor patch *": "deny",
      "kubecolor -* patch *": "deny",
      "kubecolor port-forward *": "deny",
      "kubecolor -* port-forward *": "deny",
      "kubecolor proxy *": "deny",
      "kubecolor -* proxy *": "deny",
      "kubecolor replace *": "deny",
      "kubecolor -* replace *": "deny",
      "kubecolor run *": "deny",
      "kubecolor -* run *": "deny",
      "kubecolor scale *": "deny",
      "kubecolor -* scale *": "deny",
      "kubecolor set *": "deny",
      "kubecolor -* set *": "deny",
      "kubecolor taint *": "deny",
      "kubecolor -* taint *": "deny",
      "kubecolor uncordon *": "deny",
      "kubecolor -* uncordon *": "deny",
      "kubecolor auth reconcile *": "deny",
      "kubecolor -* auth reconcile *": "deny",
      "kubecolor rollout restart *": "deny",
      "kubecolor -* rollout restart *": "deny",
      "kubecolor rollout undo *": "deny",
      "kubecolor -* rollout undo *": "deny",
      "kubecolor rollout pause *": "deny",
      "kubecolor -* rollout pause *": "deny",
      "kubecolor rollout resume *": "deny",
      "kubecolor -* rollout resume *": "deny",
      "rancher kubectl annotate *": "deny",
      "rancher -* kubectl annotate *": "deny",
      "rancher kubectl apply *": "deny",
      "rancher -* kubectl apply *": "deny",
      "rancher kubectl attach *": "deny",
      "rancher -* kubectl attach *": "deny",
      "rancher kubectl autoscale *": "deny",
      "rancher -* kubectl autoscale *": "deny",
      "rancher kubectl certificate *": "deny",
      "rancher -* kubectl certificate *": "deny",
      "rancher kubectl cordon *": "deny",
      "rancher -* kubectl cordon *": "deny",
      "rancher kubectl cp *": "deny",
      "rancher -* kubectl cp *": "deny",
      "rancher kubectl create *": "deny",
      "rancher -* kubectl create *": "deny",
      "rancher kubectl debug *": "deny",
      "rancher -* kubectl debug *": "deny",
      "rancher kubectl delete *": "deny",
      "rancher -* kubectl delete *": "deny",
      "rancher kubectl drain *": "deny",
      "rancher -* kubectl drain *": "deny",
      "rancher kubectl edit *": "deny",
      "rancher -* kubectl edit *": "deny",
      "rancher kubectl exec *": "deny",
      "rancher -* kubectl exec *": "deny",
      "rancher kubectl expose *": "deny",
      "rancher -* kubectl expose *": "deny",
      "rancher kubectl label *": "deny",
      "rancher -* kubectl label *": "deny",
      "rancher kubectl patch *": "deny",
      "rancher -* kubectl patch *": "deny",
      "rancher kubectl port-forward *": "deny",
      "rancher -* kubectl port-forward *": "deny",
      "rancher kubectl proxy *": "deny",
      "rancher -* kubectl proxy *": "deny",
      "rancher kubectl replace *": "deny",
      "rancher -* kubectl replace *": "deny",
      "rancher kubectl run *": "deny",
      "rancher -* kubectl run *": "deny",
      "rancher kubectl scale *": "deny",
      "rancher -* kubectl scale *": "deny",
      "rancher kubectl set *": "deny",
      "rancher -* kubectl set *": "deny",
      "rancher kubectl taint *": "deny",
      "rancher -* kubectl taint *": "deny",
      "rancher kubectl uncordon *": "deny",
      "rancher -* kubectl uncordon *": "deny",
      "rancher kubectl auth reconcile *": "deny",
      "rancher -* kubectl auth reconcile *": "deny",
      "rancher kubectl rollout restart *": "deny",
      "rancher -* kubectl rollout restart *": "deny",
      "rancher kubectl rollout undo *": "deny",
      "rancher -* kubectl rollout undo *": "deny",
      "rancher kubectl rollout pause *": "deny",
      "rancher -* kubectl rollout pause *": "deny",
      "rancher kubectl rollout resume *": "deny",
      "rancher -* kubectl rollout resume *": "deny",
      "helm del *": "deny",
      "helm -* del *": "deny",
      "helm delete *": "deny",
      "helm -* delete *": "deny",
      "helm install *": "deny",
      "helm -* install *": "deny",
      "helm push *": "deny",
      "helm -* push *": "deny",
      "helm registry *": "deny",
      "helm -* registry *": "deny",
      "helm rollback *": "deny",
      "helm -* rollback *": "deny",
      "helm test *": "deny",
      "helm -* test *": "deny",
      "helm un *": "deny",
      "helm -* un *": "deny",
      "helm uninstall *": "deny",
      "helm -* uninstall *": "deny",
      "helm upgrade *": "deny",
      "helm -* upgrade *": "deny",
      "helm plugin install *": "deny",
      "helm -* plugin install *": "deny",
      "helm plugin uninstall *": "deny",
      "helm -* plugin uninstall *": "deny",
      "helm plugin update *": "deny",
      "helm -* plugin update *": "deny",
      "argocd admin *": "deny",
      "argocd -* admin *": "deny",
      "velero install *": "deny",
      "velero -* install *": "deny",
      "velero uninstall *": "deny",
      "velero -* uninstall *": "deny",
      "velero create *": "deny",
      "velero -* create *": "deny",
      "velero delete *": "deny",
      "velero -* delete *": "deny",
      "velero backup create *": "deny",
      "velero -* backup create *": "deny",
      "velero backup delete *": "deny",
      "velero -* backup delete *": "deny",
      "velero restore create *": "deny",
      "velero -* restore create *": "deny",
      "velero restore delete *": "deny",
      "velero -* restore delete *": "deny",
      "velero schedule create *": "deny",
      "velero -* schedule create *": "deny",
      "velero schedule delete *": "deny",
      "velero -* schedule delete *": "deny",
      "velero backup-location create *": "deny",
      "velero -* backup-location create *": "deny",
      "velero backup-location delete *": "deny",
      "velero -* backup-location delete *": "deny",
      "velero snapshot-location create *": "deny",
      "velero -* snapshot-location create *": "deny",
      "velero snapshot-location delete *": "deny",
      "velero -* snapshot-location delete *": "deny",
      "terraform apply *": "deny",
      "terraform -* apply *": "deny",
      "terraform destroy *": "deny",
      "terraform -* destroy *": "deny",
      "terraform import *": "deny",
      "terraform -* import *": "deny",
      "terraform taint *": "deny",
      "terraform -* taint *": "deny",
      "terraform untaint *": "deny",
      "terraform -* untaint *": "deny",
      "terraform state mv *": "deny",
      "terraform -* state mv *": "deny",
      "terraform state rm *": "deny",
      "terraform -* state rm *": "deny",
      "terraform state push *": "deny",
      "terraform -* state push *": "deny",
      "terraform state replace-provider *": "deny",
      "terraform -* state replace-provider *": "deny",
      "terraform workspace new *": "deny",
      "terraform -* workspace new *": "deny",
      "terraform workspace delete *": "deny",
      "terraform -* workspace delete *": "deny",
      "tofu apply *": "deny",
      "tofu -* apply *": "deny",
      "tofu destroy *": "deny",
      "tofu -* destroy *": "deny",
      "tofu import *": "deny",
      "tofu -* import *": "deny",
      "tofu taint *": "deny",
      "tofu -* taint *": "deny",
      "tofu untaint *": "deny",
      "tofu -* untaint *": "deny",
      "tofu state mv *": "deny",
      "tofu -* state mv *": "deny",
      "tofu state rm *": "deny",
      "tofu -* state rm *": "deny",
      "tofu state push *": "deny",
      "tofu -* state push *": "deny",
      "tofu state replace-provider *": "deny",
      "tofu -* state replace-provider *": "deny",
      "tofu workspace new *": "deny",
      "tofu -* workspace new *": "deny",
      "tofu workspace delete *": "deny",
      "tofu -* workspace delete *": "deny",
      "pulumi up *": "deny",
      "pulumi -* up *": "deny",
      "pulumi destroy *": "deny",
      "pulumi -* destroy *": "deny",
      "pulumi import *": "deny",
      "pulumi -* import *": "deny",
      "pulumi refresh *": "deny",
      "pulumi -* refresh *": "deny",
      "pulumi cancel *": "deny",
      "pulumi -* cancel *": "deny",
      "pulumi state delete *": "deny",
      "pulumi -* state delete *": "deny",
      "pulumi state unprotect *": "deny",
      "pulumi -* state unprotect *": "deny",
      "pulumi stack rm *": "deny",
      "pulumi -* stack rm *": "deny",
      "pulumi config set *": "deny",
      "pulumi -* config set *": "deny",
      "pulumi config rm *": "deny",
      "pulumi -* config rm *": "deny",

      // argocd reads stay available: only the mutating verbs are named, so the
      // profiles without an argocd MCP server keep `app get|diff|list|history`.
      "argocd * actions *": "deny",
      "argocd * add *": "deny",
      "argocd * add-source *": "deny",
      "argocd * add-ssh *": "deny",
      "argocd * add-tls *": "deny",
      "argocd * confirm-deletion *": "deny",
      "argocd * create *": "deny",
      "argocd * delete *": "deny",
      "argocd * delete-resource *": "deny",
      "argocd * edit *": "deny",
      "argocd * generate *": "deny",
      "argocd * patch *": "deny",
      "argocd * patch-resource *": "deny",
      "argocd * remove-source *": "deny",
      "argocd * rm *": "deny",
      "argocd * rollback *": "deny",
      "argocd * rotate-auth *": "deny",
      "argocd * set *": "deny",
      "argocd * sync *": "deny",
      "argocd * terminate-op *": "deny",
      "argocd * unset *": "deny",
      "argocd * update-password *": "deny",

      // The "-*" denies match a write verb anywhere after a flag, so a read
      // carrying one as an argument (`auth can-i create pods`) is caught by them.
      // Last match wins, so naming the read forms here restores them.
      "kubectl auth can-i *": "ask",
      "kubectl -* auth can-i *": "ask",
      "kubectl auth whoami *": "ask",
      "kubectl -* auth whoami *": "ask",
      "kubectl rollout status *": "ask",
      "kubectl -* rollout status *": "ask",
      "kubectl rollout history *": "ask",
      "kubectl -* rollout history *": "ask",
      "kubecolor auth can-i *": "ask",
      "kubecolor -* auth can-i *": "ask",
      "kubecolor auth whoami *": "ask",
      "kubecolor -* auth whoami *": "ask",
      "kubecolor rollout status *": "ask",
      "kubecolor -* rollout status *": "ask",
      "kubecolor rollout history *": "ask",
      "kubecolor -* rollout history *": "ask",
      "helm plugin list *": "ask",
      "helm -* plugin list *": "ask",
    },
  },
  "provider": {
    "kilic": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "kilic",
      "options": {
        "baseURL": "https://ai.kilic.dev/v1",
        "apiKey": "{env:AI_KILIC_DEV_API_KEY}",
      },
      "models": {
        // Agentgateway virtual models: each fails over across zai, ollama-cloud,
        // codex and ollama-neutrino, so a tier keeps answering when one backing
        // model hits its quota. Defined in cluster/workloads/ollama under
        // .deploy/neutrino/agentgateway/models/virtual/kilic.dev/.
        "kilic.dev/cheap": {
          "name": "kilic.dev Cheap",
        },
        "kilic.dev/default": {
          "name": "kilic.dev Default",
        },
        "kilic.dev/smart": {
          "name": "kilic.dev Smart",
        },
        "kilic.dev/max": {
          "name": "kilic.dev Max",
        },
        "kilic.dev/vision": {
          "name": "kilic.dev Vision",
        },
        "ollama/cloud/deepseek-v4-pro:cloud": {
          "name": "DeepSeek V4 Pro",
        },
        "ollama/cloud/glm-5.3:cloud": {
          "name": "GLM 5.3 Cloud",
          "options": {
            "reasoningEffort": "max",
          },
        },
        "ollama/cloud/glm-5.3-flash:cloud": {
          "name": "GLM 5.3 Flash Cloud",
        },
        "ollama/cloud/kimi-k3:cloud": {
          "name": "Kimi K3 Code Cloud",
        },
        "ollama/cloud/gemma4:31b-cloud": {
          "name": "Gemma4 Cloud",
        },
      },
    },
  },
}
