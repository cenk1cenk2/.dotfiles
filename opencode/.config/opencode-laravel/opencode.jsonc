{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.2",
  "small_model": "ollama/gemma4:31b",
  "enabled_providers": ["ollama"],
  "autoupdate": false,
  "instructions": ["CLAUDE.md", "AGENTS.md"],
  "compaction": { "auto": true, "tail_turns": 10 },
  "experimental": {
    "continue_loop_on_deny": true,
    "batch_tool": true,
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow",
    "external_directory": "allow",
    "doom_loop": "ask",
    "edit": {
      "~/.claude-laravel/plans/**": "allow",
      "*": "ask",
    },
    "bash": {
      "git status": "allow",
      "git log": "allow",
      "git diff": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git rev-parse": "allow",
      "git remote -v": "allow",
      "git tag": "allow",
      "ls": "allow",
      "wc": "allow",
      "stat": "allow",
      "which": "allow",
      "file": "allow",
      "pwd": "allow",
      "type": "allow",
      "*": "ask",
    },
  },
  "provider": {
    // Ollama Cloud direct. It accepts the tagged and untagged spelling of the
    // same id, so these stay untagged while the kilic ones keep their tag.
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ollama",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:LARAVEL_OLLAMA_API_KEY}",
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
        },
        "glm-5.2": {
          "name": "GLM 5.2 Cloud",
          "options": {
            "reasoningEffort": "max",
          },
        },
        // "kimi-k3": {
        //   "name": "Kimi K3 Code Cloud",
        // },
        "gemma4:31b": {
          "name": "Gemma4 Cloud",
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
        },
      },
    },
  },
}
