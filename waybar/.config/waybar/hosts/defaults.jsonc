{
  // Bottom layer of the per-host overlay: what a machine gets when it has
  // no hosts/<name>.jsonc yet. Included after the host file, so every key
  // here is overridable by one.
  //
  // A key belongs here rather than in the bar config whenever a host must
  // be able to override it — the bar config wins over both layers.

  // Probe every known CPU sensor and take the first that exists, so an
  // unknown host still shows a temperature.
  "temperature#cpu": {
    "hwmon-path-abs": [
      "/sys/devices/platform/coretemp.0/hwmon",
      "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    ],
    "input-filename": "temp1_input",
  },
}
