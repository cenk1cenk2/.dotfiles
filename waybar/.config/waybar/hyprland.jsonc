{
  // -------------------------------------------------------------------------
  // Per-host overlay
  // -------------------------------------------------------------------------
  // WAYBAR_HOST is set by waybar@.service from systemd's %l (short
  // hostname). Objects merge key by key and the FIRST definition wins, so
  // this file beats hosts/<name>.jsonc: a host file supplies only keys
  // this one leaves unset. Verified rather than assumed — height 24 here
  // against 40 in an include logs "Bar configured (height: 24)".
  //
  // So a host file carries only what this one leaves unset, which today is
  // a single module definition. group/hardware below therefore holds the
  // GPU slot for every machine, and the host that can actually read a GPU
  // sensor is the one that defines the module: waybar hides a listed
  // module nobody configured ("There is no configuration for
  // 'custom/gpu', element will be hidden").
  "include": ["~/.config/waybar/hosts/$WAYBAR_HOST.jsonc"],

  // -------------------------------------------------------------------------
  // Global configuration
  // -------------------------------------------------------------------------
  "layer": "bottom",
  "reload_style_on_change": true,

  // If height property would be not present, it'd be calculated dynamically
  "height": 24,

  "position": "bottom",
  "spacing": 4,

  // -------------------------------------------------------------------------
  // Modules
  // -------------------------------------------------------------------------

  "battery": {
    // Pin to a specific name so auto-discovery doesn't scan transient
    // batteries like Bluetooth controllers. Waybar has a known crash
    // (terminate with std::runtime_error from inotify_add_watch) when
    // a hot-plugged battery sysfs entry disappears mid-session — e.g.
    // a DualSense controller battery at
    // /sys/class/power_supply/ps-controller-battery-XX:XX:XX:XX:XX:XX
    // vanishing when the controller disconnects. "BAT0" doesn't exist
    // on this desktop so the module gracefully shows nothing.
    // "bat": "BAT0",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format-charging": "󰂄 {capacity}% ({time})",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰚥 {capacity}%",
    "format": "{icon} {capacity}% ({time})",
    "format-time": "{H}h{M}m",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰒲",
      "deactivated": "󰒳",
    },
    "tooltip": true,
    "tooltip-format-activated": "active",
    "tooltip-format-deactivated": "idle",
    "signal": 15,
  },

  "tray": {
    "icon-size": 18,
    "spacing": 4,
  },

  "custom/pacman": {
    "format": "󰏔 {}",
    "interval": 1800,
    "exec-if": "[ $(pamac checkupdates -q | wc -l) -gt 0 ]",
    "exec": "pamac checkupdates -q | wc -l",
    "on-click": "pamac-manager --updates; waybar-signal.sh pacman",
    "signal": 14,
  },

  "custom/recorder": {
    "return-type": "json",
    "format": "{}",
    "exec": "f=$XDG_RUNTIME_DIR/waybar/recorder.json; [ -e $f ] || echo '{\"text\": \"\"}' > $f; exec tail -F -n1 $f 2>/dev/null",
    "restart-interval": 2,
    "on-click": "~/.config/wayland/scripts/recorder.py toggle",
  },

  "custom/stt": {
    "return-type": "json",
    "format": "{}",
    "exec": "f=$XDG_RUNTIME_DIR/waybar/stt.json; [ -e $f ] || echo '{\"text\": \"\"}' > $f; exec tail -F -n1 $f 2>/dev/null",
    "restart-interval": 2,
    "on-click": "~/.config/wayland/scripts/speech.py stt toggle --output clipboard",
  },

  "custom/tts": {
    "return-type": "json",
    "format": "{}",
    "exec": "f=$XDG_RUNTIME_DIR/waybar/tts.json; [ -e $f ] || echo '{\"text\": \"\"}' > $f; exec tail -F -n1 $f 2>/dev/null",
    "restart-interval": 2,
    "on-click": "~/.config/wayland/scripts/speech.py tts toggle",
  },

  "custom/copywriter": {
    "return-type": "json",
    "format": "{}",
    "exec": "f=$XDG_RUNTIME_DIR/waybar/copywriter.json; [ -e $f ] || echo '{\"text\": \"\"}' > $f; exec tail -F -n1 $f 2>/dev/null",
    "restart-interval": 2,
  },

  // Hidden while unzoomed: the watcher prints an empty text at 1x.
  "custom/zoom": {
    "return-type": "json",
    "format": "{}",
    "exec": "f=$XDG_RUNTIME_DIR/waybar/zoom.json; [ -e $f ] || echo '{\"text\": \"\"}' > $f; exec tail -F -n1 $f 2>/dev/null",
    "restart-interval": 2,
    "on-click": "~/.config/hypr/scripts/zoom.py toggle",
  },

  "privacy": {
    "icon-size": 14,
    "icon-spacing": 4,
    "modules": [{ "type": "screenshare" }, { "type": "audio-in" }],
  },

  "group/extras": {
    "orientation": "horizontal",
    "modules": ["custom/pacman", "mpris", "hyprland/language"],
  },

  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["custom/gpu", "cpu", "memory", "temperature#cpu"],
  },

  "group/connection": {
    "orientation": "horizontal",
    "modules": ["bluetooth", "network"],
  },

  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "privacy",
      "pulseaudio#sink",
      "backlight",
      "battery",
      "custom/notification",
      "clock",
    ],
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
  },

  "mpris": {
    "player": "spotify",
    "format": "{status_icon}",
    "status-icons": {
      "playing": "",
      "paused": "",
    },
    "tooltip-format": "{player}:  {title} - {artist}",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous",
  },

  "custom/notification": {
    // swaync sends the unread count as text; zero is blanked so an idle bell
    // shows no number; the negative spacing pulls the count over the bell.
    "format": "<span rise='4pt'>{icon}</span><span size='6pt' rise='12pt' weight='bold' foreground='#F28B82'>{text}</span>",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb | sed -u 's/\"text\": \"0\"/\"text\": \"\"/'",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },

  // -------------------------------------------------------------------------
  // Hyprland-specific configuration
  // -------------------------------------------------------------------------

  "modules-left": ["hyprland/workspaces"],
  "modules-center": [
    "custom/recorder",
    "custom/stt",
    "custom/tts",
    "custom/copywriter",
    "custom/zoom",
    "hyprland/submap",
    "hyprland/window",
  ],
  "modules-right": [
    "group/extras",
    "group/hardware",
    "group/connection",
    "tray",
    "group/status",
  ],

  // -------------------------------------------------------------------------
  // Hyprland-specific modules
  // -------------------------------------------------------------------------

  "hyprland/workspaces": {
    "format": "{icon}: {windows}",
    "format-window-separator": "",
    "on-click": "activate",
    "all-outputs": false,
    "show-special": true,
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "format": "{icon}",
      "icon-size": 18,
    },
  },

  "hyprland/window": {
    "max-length": 80,
    "separate-outputs": true,
  },

  "hyprland/submap": {
    "format": "{}",
    "tooltip": false,
  },

  "hyprland/language": {
    "format": "<span rise='4pt'>󰌓</span><span size='9pt' rise='9pt'>{short}</span>",
    "tooltip-format": "{long}",
    "on-click": "hyprctl switchxkblayout $(hyprctl devices -j | jq -r '.keyboards[] | select(.main == true) | .name') next",
  },

  // -------------------------------------------------------------------------
  // Module overrides with hyprctl commands
  // -------------------------------------------------------------------------

  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "states": {
      "warning": 75,
      "critical": 90,
    },
    "on-click": "~/.config/hypr/scripts/launch-app.py process_manager",
  },

  "memory": {
    "interval": 5,
    "format": " {}%",
    "states": {
      "warning": 75,
      "critical": 90,
    },
    "on-click": "~/.config/hypr/scripts/launch-app.py process_manager",
  },

  "network": {
    "interval": 5,
    "format-wifi": "<span rise='4pt'>󱚻</span><span size='9pt' rise='9pt'>{signaldBm}</span>",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤠",
    "tooltip-format": "{ifname} ({essid}): {ipaddr} ({signaldBm})",
    "on-click": "~/.config/hypr/scripts/launch-app.py network_manager",
  },

  "pulseaudio#sink": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["", "󰕾", ""],
    },
    "tooltip-format": "{icon} {volume}%",
    "on-click": "~/.config/hypr/scripts/launch-app.py audio_mixer",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
  },

  // {volume} is the sink's everywhere except inside format-source, where it
  // is the source's. The source level reaches "format" only as
  // {format_source}, or as {source_volume}.
  //
  // Not in group/status: add "pulseaudio#source" there to show it. It is
  // event-driven and starts no process, but always shown, since the built-in
  // module cannot hide itself while the mic is idle; privacy's audio-in icon
  // covers "something is recording". style.css already colours it muted.
  "pulseaudio#source": {
    "format": "{format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭",
    "tooltip-format": "󰍬 {source_volume}%",
    "on-click": "~/.config/hypr/scripts/launch-app.py audio_mixer",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
  },

  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "tooltip": true,
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
    "on-click": "~/.config/hypr/scripts/launch-app.py calendar",
  },

  // Probe every known CPU sensor and take the first that exists: coretemp
  // temp1_input is Intel's "Package id 0", the 00:18.3 function is where
  // k10temp binds on AMD family 17h+ and its temp1_input is Tctl.
  //
  // hwmon-path-abs takes the device directory *without* the hwmon<N>
  // component, because that number is assigned in driver probe order and
  // moves between boots — coretemp has been both hwmon7 and hwmon8 on one
  // machine, where hwmon7 is now a USB-C power supply with no temp input.
  "temperature#cpu": {
    "hwmon-path-abs": [
      "/sys/devices/platform/coretemp.0/hwmon",
      "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    ],
    "input-filename": "temp1_input",
    "warning-threshold": 72,
    "critical-threshold": 78,
    "interval": 3,
    "format": "{icon} {temperatureC}°",
    "format-icons": ["", "", "", "", "", "", "", ""],
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/launch-app.py sensors",
  },

  "bluetooth": {
    "format": "<span rise='4pt'>󰂯</span><span size='9pt' rise='9pt'>{num_connections}</span>",
    "format-disabled": "󰂲",
    "on-click": "~/.config/hypr/scripts/launch-app.py bluetooth",
    "on-click-right": "rfkill toggle bluetooth",
    "tooltip-format": "{}",
  },
}
