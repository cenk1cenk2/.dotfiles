# vim:ft=swayconfig

### Recording Mode

set $mode_recording "󰕧 Recording: (r/R) toggle/pause | (o) OBS | (s/S) speech→type | (c/C) speech→clipboard | (t/T) speak/stop | (w/W) copywriter/kill | (q/Q) stop speech/recording | <ESC>"

mode $mode_recording {
        # Toggle recording (start/stop)
        bindsym r exec $recorder toggle, mode "default"

        # Pause/resume recording
        bindsym Shift+r exec $recorder pause, mode "default"

        # Open OBS window
        bindsym o exec $recorder open, mode "default"

        # Stop recording
        bindsym Shift+q exec $recorder stop, mode "default"

        # Speech-to-text direct typing with AI enrichment
        bindsym s exec $speech stt toggle --output type --enrich, mode "default"

        # Speech-to-text direct typing (raw, no enrichment)
        bindsym Shift+s exec $speech stt toggle --output type, mode "default"

        # Speech-to-text to clipboard with AI enrichment
        bindsym c exec $speech stt toggle --output clipboard --enrich, mode "default"

        # Speech-to-text to clipboard (raw, no enrichment)
        bindsym Shift+c exec $speech stt toggle --output clipboard, mode "default"

        # Read clipboard aloud
        bindsym t exec $speech tts toggle, mode "default"

        # Stop speaking
        bindsym Shift+t exec $speech tts kill, mode "default"

        # Copywriter: refine clipboard through AI
        bindsym w exec $copywriter run clipboard, mode "default"

        # Kill copywriter
        bindsym Shift+w exec $copywriter kill, mode "default"

        # Stop speech-to-text
        bindsym q exec $speech stt kill, mode "default"

        # Exit recording mode
        bindsym Escape mode "default"
}

## Launch // Recording Mode ##
bindsym $mod+r mode $mode_recording
