{
  "target": "/",
  "owner": "root:root",
  "sudo": true,
  "modes": {
    "etc/sudoers.d/clamav": "0440"
  },
  "rules": [
    {
      "paths": ["etc/pam.d/"],
      "write": "atomic"
    },
    {
      "paths": ["etc/sudoers.d/"],
      "validate": "sudoers"
    }
  ],
  "post": [
    ["systemctl", "daemon-reload"],
    ["udevadm", "control", "--reload"],
    ["sysctl", "--system"],
    [
      "sh",
      "-c",
      "systemctl disable --quiet nvidia-persistenced.service nvidia-powerd.service 2>/dev/null || true"
    ],
    [
      "sh",
      "-c",
      "systemctl cat docker.socket >/dev/null 2>&1 || exit 0; systemctl disable --quiet docker.service && systemctl enable --quiet docker.socket"
    ]
  ]
}
