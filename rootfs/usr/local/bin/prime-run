#!/bin/sh
# Shadows /usr/bin/prime-run — /usr/local/bin precedes /usr/bin in PATH.
#
# The packaged script only flips the GLX vendor selector, which is enough on
# the NVIDIA-primary sessions. The hybrid profile additionally disables MangoHud
# session-wide (its implicit Vulkan layer loads NVML, which holds /dev/nvidia0
# out of RTD3), so it gets handed back here per game. Inert in the other
# profiles: MangoHud is enabled there anyway.
#
# Steam titles do not reach this: the steam-runtime launcher resets PATH and
# pressure-vessel drops the Optimus layer, so Proton picks the dGPU through
# env-hybrid's DXVK/VKD3D device filters instead. OpenGL overlays still need
# the mangohud wrapper for its LD_PRELOAD, chained as `prime-run mangohud <game>`.
exec env \
  __NV_PRIME_RENDER_OFFLOAD=1 \
  __VK_LAYER_NV_optimus=NVIDIA_only \
  __GLX_VENDOR_LIBRARY_NAME=nvidia \
  MANGOHUD=1 \
  "$@"
