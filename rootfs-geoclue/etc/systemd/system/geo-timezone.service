[Unit]
Description=Set system timezone from geoclue location
After=network-online.target suspend.target geoclue.service geoclue-agent.service
Wants=network-online.target
Requires=geoclue-agent.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/geo-timezone update
SuccessExitStatus=75
TimeoutStartSec=8min

[Install]
WantedBy=suspend.target
