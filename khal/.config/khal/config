[calendars]

# Pimsync mirrors these one-way from Google's iCal feeds, so anything written
# here is deleted on the next sync. Edits belong in Google Calendar.

[[personal]]
path = ~/.calendars/personal
color = light blue
readonly = True

[[laravel]]
path = ~/.calendars/laravel
color = light red
readonly = True

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M

[view]
theme = dark

[palette]
# key = foreground, background, mono, foreground_high, background_high
edit = '', '', 'bold', '', '#17191e'
