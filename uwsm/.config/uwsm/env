# vim: ft=bash

export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/bin:${PATH}"

# hyprpilot profiles live in per-account config overlays; launches outside a
# login shell (desktop launchers, editors) need one selected too.
export HYPRPILOT_CONFIG_PROFILE="${HYPRPILOT_CONFIG_PROFILE:-personal}"

export LIBSEAT_BACKEND=logind

export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORMTHEME=xdgdesktopportal
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

export GTK_USE_PORTAL=1
export GDK_BACKEND=wayland
export GDK_DEBUG=portals
export ELECTRON_OZONE_PLATFORM_HINT=wayland

export XCURSOR_THEME=Breeze_Light
export XCURSOR_SIZE=24

# needs proton plus to install proton-ge for these
export PROTON_ENABLE_HDR=1
export PROTON_ENABLE_WAYLAND=1

export MANGOHUD=1
export STEAM_FRAME_FORCE_CLOSE=1

export DOCKER_BUILDKIT=1
export MOZ_ENABLE_WAYLAND=1
export MOZ_DBUS_REMOTE=1
