# vim: ft=bash

_card_for_vendor() {
  for vendor in /sys/class/drm/card*/device/vendor; do
    [ -r "$vendor" ] || continue
    [ "$(cat "$vendor")" = "$1" ] || continue

    card_dir="${vendor%/device/vendor}"
    card="${card_dir##*/}"
    [ -e "/dev/dri/$card" ] || continue

    printf '/dev/dri/%s\n' "$card"
    return 0
  done

  return 1
}

_gpu_intel_card="$(_card_for_vendor 0x8086 || true)"
_gpu_nvidia_card="$(_card_for_vendor 0x10de || true)"

if [ -n "$_gpu_intel_card" ]; then
  # First entry is the primary renderer. The dGPU must be listed or Proton
  # cannot present from it, and dGPU-wired outputs (HDMI, muxed eDP) go dark.
  # Listing it holds its KMS node, blocking RTD3.
  if [ -n "$_gpu_nvidia_card" ]; then
    export AQ_DRM_DEVICES="$_gpu_intel_card:$_gpu_nvidia_card"
  else
    export AQ_DRM_DEVICES="$_gpu_intel_card"
  fi
  export LIBVA_DRIVER_NAME=iHD

  # GTK4's Vulkan renderer probes every device, opening and holding
  # /dev/nvidia0. The GL renderer skips that probe.
  export GSK_RENDERER=ngl

  # Both keep processes off /dev/nvidia0 for RTD3, at the cost of gaming:
  # MANGOHUD=0 stops the implicit Vulkan layer dlopening NVML, and the Mesa EGL
  # pin stops libEGL_nvidia opening the node during vendor enumeration — but
  # winewayland.drv presents through EGL, so pinning it hides the dGPU from
  # Proton entirely. Enable only if runtime suspend becomes reachable.
  # export MANGOHUD=0
  # export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
fi

if [ -n "$_gpu_nvidia_card" ]; then
  # DXVK/vkd3d take the first adapter Wine offers, which is the iGPU. These are
  # read inside the pressure-vessel container, unlike prime-run's Optimus layer
  # (absent there) or PATH-based wrappers (Steam resets PATH). Needs NVIDIA EGL
  # available, or Wine never offers the dGPU to match against.
  export DXVK_FILTER_DEVICE_NAME=NVIDIA
  export VKD3D_FILTER_DEVICE_NAME=NVIDIA

  # __NV_PRIME_RENDER_OFFLOAD / __GLX_VENDOR_LIBRARY_NAME / GBM_BACKEND stay out
  # — session-wide they force the Intel-primary compositor onto NVIDIA and
  # black-screen it. Per-game launch options instead. The rest is Proton-only.
  export PROTON_HIDE_NVIDIA_GPU=0
  export DXVK_ENABLE_NVAPI=1
  export VKD3D_CONFIG=dxr,dxr11
  export VKD3D_FEATURE_LEVEL=12_2
fi

unset _gpu_intel_card _gpu_nvidia_card
unset -f _card_for_vendor
