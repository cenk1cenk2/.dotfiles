{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "45000",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "true",
    "MAX_MCP_OUTPUT_TOKENS": "50000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "mcp__mcphub",
      "mcp__plugin_claude-mem_mcp-search",
      "Grep(*)",
      "Glob(*)",
      "Read(*)",
      "ToolSearch(*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v:*)",
      "Bash(git remote get-url:*)",
      "Bash(git tag:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(file:*)",
      "Bash(pwd:*)",
      "Bash(type:*)"
    ],
    "deny": [
      "Bash(sed -i*)",
      "Bash(sed --in-place*)",
      "Bash(perl -i*)",
      "Bash(perl -pi*)",
      "Bash(perl -p -i*)",
      "Bash(awk -i inplace*)",
      "Bash(gawk -i inplace*)"
    ],
    "ask": []
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[((.cwd // \"/\") | split(\"/\") | last), (.message // \"Waiting for input\")] | @tsv' | { IFS=$'\\t' read -r d m; notify-send -a \"Claude Code\" -i utilities-terminal -u normal \"Claude Code (laravel) — $d\" \"$m\"; } 2>/dev/null || true",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "viewMode": "default",
  "spinnerTipsEnabled": false,
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "showClearContextOnPlanAccept": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "theme": "custom:onedarker",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "terminal_bell",
  "showTurnDuration": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "awaySummaryEnabled": false
}
